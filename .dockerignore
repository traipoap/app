# Rust build artifacts
**/target/
**/*.rs.bk
**/Cargo.lock.backup

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
LICENSE
docs/

# Environment files
.env
.env.*
.env.local
.env.production

# Database files
*.db
*.sqlite
*.sqlite3
data/

# Export files
export/
exports/

# Test artifacts
**/tests/**/*.db
**/tests/**/*.sqlite

# Temporary files
tmp/
temp/
*.tmp
*.log

# Node (host node_modules MUST NOT leak into the build context —
# it overwrites `npm ci` output and ships host-platform binaries)
node_modules/
**/node_modules/

# Astro build artifacts (regenerated inside the image)
frontend/dist/
frontend/.astro/
