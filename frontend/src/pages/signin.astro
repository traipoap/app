            transition: opacity 0.15s ease;
        }

        .copy-btn .check-icon {
            opacity: 0;
            color: var(--success);
        }

        .copy-btn:hover {
            color: var(--text);
            border-color: var(--border-strong);
            background: rgba(148, 163, 184, 0.08);
        }

        .copy-btn.copied {
            color: var(--success);
            border-color: rgba(52, 211, 153, 0.4);
            background: rgba(52, 211, 153, 0.08);
        }

        .copy-btn.copied .copy-icon {
