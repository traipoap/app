            background: var(--bg);
        }

        .copy-btn {
            position: relative;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: transparent;
            color: var(--faint);
            cursor: pointer;
            transition:
