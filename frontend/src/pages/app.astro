        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image:
            linear-gradient(rgba(148, 163, 184, 0.055) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(148, 163, 184, 0.055) 1px,
                transparent 1px
            );
        background-size: 44px 44px;
        -webkit-mask-image: radial-gradient(
            ellipse 85% 65% at 50% 0%,
            #000 25%,
            transparent 72%
        );
        mask-image: radial-gradient(
            ellipse 85% 65% at 50% 0%,
            #000 25%,
            transparent 72%
        );
    }

    .hero::after {
        content: "";
        position: absolute;
        top: -220px;
        left: 50%;
        transform: translateX(-50%);
        width: min(900px, 90vw);
        height: 520px;
        pointer-events: none;
        background:
            radial-gradient(
                closest-side,
                rgba(99, 102, 241, 0.2),
                transparent 70%
            ),
            radial-gradient(
                closest-side,
                rgba(34, 211, 238, 0.08),
                transparent 70%
            );
    }

    .hero-grid {
        position: relative;
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        gap: clamp(2.5rem, 5vw, 4.5rem);
        align-items: center;
    }

    @media (max-width: 940px) {
        .hero-grid {
            grid-template-columns: 1fr;
            max-width: 640px;
            margin-inline: auto;
        }
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.875rem 0.375rem 0.75rem;
        border: 1px solid var(--border-strong);
        border-radius: 100px;
        background: rgba(99, 102, 241, 0.08);
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        margin-bottom: 1.75rem;
    }

    .badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.18);
        animation: pulse 2.4s ease-in-out infinite;
    }

    .hero-title {
        font-size: clamp(2.375rem, 5.2vw, 3.5rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -0.03em;
        margin: 0 0 1.375rem;
        color: var(--text);
        text-wrap: balance;
    }

    .gradient {
        background: linear-gradient(
            100deg,
            var(--accent) 10%,
            var(--accent-2) 90%
        );
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
    }

    .hero-sub {
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--muted);
        margin: 0 0 2.25rem;
        max-width: 52ch;
    }

    .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        margin-bottom: 2.5rem;
    }

    .hero-points {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .hero-points li {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--faint);
    }

    .hero-points svg {
        width: 14px;
        height: 14px;
        color: var(--accent);
        flex-shrink: 0;
    }

    /* ── Hero visual: dashboard window ─────────────────────── */
    .stage {
        position: relative;
    }

    .stage::before {
        content: "";
        position: absolute;
        inset: 8% -6% -10% -6%;
        background: radial-gradient(
            closest-side,
            rgba(99, 102, 241, 0.22),
            transparent 75%
        );
        filter: blur(10px);
        pointer-events: none;
    }

    .window {
        position: relative;
        background: var(--bg-elev);
        border: 1px solid var(--border-strong);
        border-radius: 14px;
        box-shadow:
            0 30px 80px -30px rgba(0, 0, 0, 0.8),
            0 12px 50px -18px rgba(99, 102, 241, 0.3);
        overflow: hidden;
    }

    .window-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid var(--border);
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        opacity: 0.9;
    }
    .dot.red {
        background: #f2555a;
    }
    .dot.yellow {
        background: #f5b93d;
    }
    .dot.green {
        background: #48c78a;
    }

    .window-title {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 0.6875rem;
        color: var(--faint);
        letter-spacing: 0.02em;
    }

    .window-body {
        display: grid;
        grid-template-columns: 168px 1fr;
        min-height: 380px;
    }

    .side {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.75rem 0.625rem;
        border-right: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.015);
    }

    .side-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.125rem 0.375rem 0.75rem;
        margin-bottom: 0.375rem;
        border-bottom: 1px solid var(--border);
    }

    .side-mark {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 7px;
        color: var(--accent);
        background: rgba(99, 102, 241, 0.14);
        border: 1px solid rgba(99, 102, 241, 0.35);
        flex-shrink: 0;
    }

    .side-mark svg {
        width: 14px;
        height: 14px;
    }

    .side-word {
        font-size: 0.8125rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        color: var(--text);
    }

    .side-link {
        display: flex;
        align-items: center;
        gap: 0.5625rem;
        padding: 0.4375rem 0.5625rem;
        border-radius: 7px;
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--muted);
        border: 1px solid transparent;
        white-space: nowrap;
        overflow: hidden;
    }

    .side-link svg {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        color: var(--faint);
    }

    .side-link.active {
        color: var(--text);
        background: rgba(99, 102, 241, 0.12);
        border-color: rgba(99, 102, 241, 0.3);
    }

    .side-link.active svg {
        color: var(--accent);
    }

    .side-signout {
        display: flex;
        align-items: center;
        gap: 0.5625rem;
        margin-top: auto;
        padding: 0.5rem 0.5625rem 0.125rem;
        border-top: 1px solid var(--border);
        font-size: 0.75rem;
        color: var(--faint);
        white-space: nowrap;
        overflow: hidden;
    }

    .side-signout svg {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
    }

    .main {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        padding: 0.875rem;
        min-width: 0;
    }

    .dash-top {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .dash-title {
        font-size: 0.9375rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--text);
    }

    .dash-sub {
        margin-top: 2px;
        font-size: 0.6875rem;
        color: var(--faint);
    }

    .range-chips {
        display: flex;
        gap: 0.25rem;
        flex-shrink: 0;
    }

    .range-chip {
        font-size: 0.625rem;
        font-weight: 600;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        border: 1px solid var(--border);
        color: var(--muted);
        background: rgba(255, 255, 255, 0.02);
        font-variant-numeric: tabular-nums;
    }

    .range-chip.active {
        color: var(--accent);
        border-color: rgba(99, 102, 241, 0.4);
        background: rgba(99, 102, 241, 0.14);
    }

    .dash-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
    }

    .dstat {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 0.5rem 0.625rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--panel);
    }

    .dstat-label {
        font-size: 0.5625rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--faint);
    }

    .dstat-value {
        font-size: 0.9375rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--text);
        font-variant-numeric: tabular-nums;
    }

    .dstat-value.danger {
        color: var(--danger);
    }

    .dstat-value.warn {
        color: var(--warning);
    }

    .chart-card {
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--panel);
        padding: 0.625rem 0.75rem;
    }

    .chart-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .chart-head h4 {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text);
    }

    .chart-sub {
        font-size: 0.625rem;
        color: var(--faint);
    }

    .bars {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        height: 64px;
    }

    .bars span {
        flex: 1;
        border-radius: 2px 2px 0 0;
        background: linear-gradient(
            180deg,
            rgba(99, 102, 241, 0.85),
            rgba(99, 102, 241, 0.3)
        );
        transform-origin: bottom;
        animation: bar-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .bars span.peak {
        background: linear-gradient(
            180deg,
            var(--accent-2, #38bdf8),
            rgba(56, 189, 248, 0.35)
        );
    }

    @keyframes bar-rise {
        from {
            transform: scaleY(0.15);
            opacity: 0.4;
        }
    }

    .src-list {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .src-row {
        display: grid;
        grid-template-columns: 92px minmax(0, 1fr) 36px;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.6875rem;
    }

    .src-name {
        font-family: var(--mono);
        color: var(--muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .src-track {
        height: 5px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.05);
        overflow: hidden;
    }

    .src-track i {
        display: block;
        height: 100%;
        border-radius: 3px;
        background: var(--accent);
    }

    .src-count {
        font-family: var(--mono);
        font-size: 0.625rem;
        color: var(--faint);
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .float-chip {
        position: absolute;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5625rem 0.875rem;
        border-radius: 10px;
        border: 1px solid var(--border-strong);
        background: rgba(13, 20, 36, 0.88);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.7);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--muted);
        white-space: nowrap;
        animation: float 6s ease-in-out infinite alternate;
    }

    .float-chip svg {
        width: 14px;
        height: 14px;
        color: var(--accent);
        flex-shrink: 0;
    }

    .chip-tr {
        top: -18px;
        right: -14px;
    }

    .chip-bl {
        bottom: -16px;
        left: -14px;
        animation-delay: 3s;
    }

    @media (max-width: 940px) {
        .chip-tr {
            right: 0;
        }
        .chip-bl {
            left: 0;
        }
    }

    /* ── Sections ──────────────────────────────────────────── */
    .section {
        padding: clamp(4rem, 8vw, 6.5rem) 0;
        scroll-margin-top: 80px;
    }

    .section-tight {
        padding-bottom: 0;
    }

    .section-head {
        max-width: 620px;
        margin: 0 auto 3.5rem;
        text-align: center;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        font-family: var(--mono);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--accent);
        margin-bottom: 1rem;
    }

    .eyebrow::before,
    .eyebrow::after {
        content: "";
        width: 22px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--border-strong));
    }
    .eyebrow::after {
        background: linear-gradient(90deg, var(--border-strong), transparent);
    }

    .section-head h2 {
        font-size: clamp(1.75rem, 3.5vw, 2.375rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.15;
        margin: 0 0 1rem;
        text-wrap: balance;
    }

    .section-sub {
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.65;
        margin: 0;
    }

    /* ── Steps ─────────────────────────────────────────────── */
    .steps {
        position: relative;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .steps::before {
        content: "";
        position: absolute;
        top: 26px;
        left: 14%;
        right: 14%;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--border-strong) 25%,
            var(--border-strong) 75%,
            transparent
        );
    }

    @media (max-width: 760px) {
        .steps {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .steps::before {
            display: none;
        }
    }

    .step {
        text-align: center;
        padding: 2rem 1.5rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: rgba(13, 20, 36, 0.5);
        transition:
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .step:hover {
        border-color: var(--border-strong);
        transform: translateY(-3px);
    }

    .step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 52px;
        height: 52px;
        padding: 0 0.5rem;
        border-radius: 12px;
        border: 1px solid rgba(99, 102, 241, 0.35);
        background: radial-gradient(
            120% 120% at 50% 0%,
            rgba(99, 102, 241, 0.18),
            rgba(13, 20, 36, 1) 70%
        );
        font-family: var(--mono);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent);
        margin-bottom: 1.25rem;
    }

    .step h3 {
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 0 0 0.5rem;
    }

    .step p {
        color: var(--muted);
        font-size: 0.875rem;
        line-height: 1.65;
        margin: 0;
    }

    /* ── Feature cards ─────────────────────────────────────── */
    .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }

    @media (max-width: 940px) {
        .cards {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .cards {
            grid-template-columns: 1fr;
        }
    }

    .card {
        display: flex;
        flex-direction: column;
        padding: 1.75rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: rgba(13, 20, 36, 0.5);
        transition:
            border-color 0.2s ease,
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .card:hover {
        border-color: rgba(99, 102, 241, 0.4);
        background: rgba(13, 20, 36, 0.85);
        transform: translateY(-3px);
        box-shadow: 0 18px 40px -20px rgba(99, 102, 241, 0.35);
    }

    .card-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 11px;
        border: 1px solid rgba(99, 102, 241, 0.3);
        background: rgba(99, 102, 241, 0.1);
        color: var(--accent);
        margin-bottom: 1.25rem;
    }

    .card-icon svg {
        width: 20px;
        height: 20px;
    }

    .card h3 {
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 0 0 0.5rem;
    }

    .card p {
        color: var(--muted);
        font-size: 0.875rem;
        line-height: 1.65;
        margin: 0;
    }

    /* ── Tech chips ────────────────────────────────────────── */
    .chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.625rem;
        max-width: 760px;
        margin: 0 auto;
        padding: 0;
        list-style: none;
    }

    .chips li {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border: 1px solid var(--border);
        border-radius: 100px;
        background: rgba(13, 20, 36, 0.5);
        font-family: var(--mono);
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--muted);
        transition:
            color 0.15s ease,
            border-color 0.15s ease,
            background 0.15s ease;
        cursor: default;
    }

    .chips li::before {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--faint);
        transition: background 0.15s ease;
    }

    .chips li:hover {
        color: var(--text);
        border-color: rgba(99, 102, 241, 0.45);
        background: rgba(99, 102, 241, 0.08);
    }

    .chips li:hover::before {
        background: var(--accent);
    }

    /* ── CTA ───────────────────────────────────────────────── */
    .cta {
        position: relative;
        overflow: hidden;
        text-align: center;
        padding: clamp(3.5rem, 7vw, 5.5rem) clamp(1.5rem, 5vw, 4rem);
        border: 1px solid var(--border-strong);
        border-radius: 20px;
        background:
            radial-gradient(
                90% 140% at 50% -20%,
                rgba(99, 102, 241, 0.22),
                transparent 60%
            ),
            var(--bg-elev);
    }

    .cta::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image:
            linear-gradient(rgba(148, 163, 184, 0.04) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(148, 163, 184, 0.04) 1px,
                transparent 1px
            );
        background-size: 36px 36px;
    }

    .cta h2 {
        position: relative;
        font-size: clamp(1.625rem, 3.6vw, 2.375rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        margin: 0 0 1rem;
        text-wrap: balance;
    }

    .cta p {
        position: relative;
        color: var(--muted);
        font-size: 1.0625rem;
        line-height: 1.65;
        max-width: 46ch;
        margin: 0 auto 2.25rem;
    }

    .cta-actions {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.875rem;
    }

    /* ── Footer ────────────────────────────────────────────── */
    .footer {
        border-top: 1px solid var(--border);
        padding: 3.5rem 0 2.25rem;
        margin-top: 2rem;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 2.5rem;
        margin-bottom: 3rem;
    }

    @media (max-width: 700px) {
        .footer-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }

    .footer-brand p {
        margin: 1rem 0 0;
        max-width: 34ch;
        color: var(--faint);
        font-size: 0.875rem;
        line-height: 1.6;
    }

    .footer-col {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .footer-col h4 {
        font-family: var(--mono);
        font-size: 0.6875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--faint);
        margin: 0 0 0.25rem;
    }

    .footer-col a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.875rem;
        transition: color 0.15s ease;
    }

    .footer-col a:hover {
        color: var(--text);
    }

    .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
        padding-top: 1.75rem;
        border-top: 1px solid var(--border);
    }

    .footer-bottom p {
        color: var(--faint);
        font-size: 0.8125rem;
        margin: 0;
    }

    /* ── Architecture diagram ────────────────────────────── */
    .section-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.875rem;
        margin: -1.75rem 0 3rem;
    }

    .arch {
        margin: 0;
        padding: clamp(1.25rem, 3vw, 2rem);
        border: 1px solid var(--border);
        border-radius: 14px;
        background: rgba(13, 20, 36, 0.5);
    }

    .arch svg {
        display: block;
        width: 100%;
        height: auto;
    }

