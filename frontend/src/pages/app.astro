---
import Layout from "../layouts/Layout.astro";
---

<Layout title="LUMINA — Kubernetes GitOps Log Platform">
    <div class="landing">
        <!-- ══════════════════ Header ══════════════════ -->
        <header class="site-header">
            <div class="container header-inner">
                <a href="/app" class="logo" aria-label="LUMINA — home">
                    <span class="logo-mark">
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                        </svg>
                    </span>
                    <span class="logo-word">LUMINA</span>
                    <span class="logo-sub">Kubernetes GitOps Log Platform</span>
                </a>
                <nav class="nav" aria-label="Main navigation">
                    <a href="#how-it-works" class="nav-link">
                        How it works
                    </a>
                    <a href="#features" class="nav-link">
                        Features
                    </a>
                    <a href="/" class="nav-link">
                        Portfolio
                    </a>
                    <a href="/signin" class="nav-link">
                        Sign In
                    </a>
                    <a href="/signup" class="btn btn-primary btn-sm">
                        Get Started
                    </a>
                </nav>
            </div>
        </header>

        <main>
            <!-- ══════════════════ Hero ══════════════════ -->
            <section class="hero">
                <div class="container hero-grid">
                    <div class="hero-copy" data-reveal>
                        <span class="badge">
                            <span class="badge-dot"></span>
                            Kubernetes · ArgoCD GitOps · Proxmox
                        </span>
                        <h1 class="hero-title">
                            Real-time log analytics for your
                            <span class="gradient">
                                Kubernetes GitOps platform
                            </span>
                        </h1>
                        <p class="hero-sub">
                            LUMINA ships logs from every cluster node and pod
                            through Vector into Quickwit — full-text search,
                            live tailing, and audited CSV exports. Fully
                            self-hosted, continuously reconciled by GitOps.
                        </p>
                        <div class="hero-cta">
                            <a
                                href="https://github.com/traipoap/app"
                                target="_blank"
                                rel="noopener"
                                class="btn btn-primary"
                            >
                                Explore the code
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                                </svg>
                            </a>
                            <a href="/signup" class="btn btn-ghost">
                                Create Account
                            </a>
                        </div>
                        <ul class="hero-points" role="list">
                            <li>
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Vector → Quickwit
                            </li>
                            <li>
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Lucene full-text search
                            </li>
                            <li>
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
