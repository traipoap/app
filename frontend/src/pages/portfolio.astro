---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="TRAIPAP HUNTHONG — DevOps Engineer Portfolio"
    description="พอร์ตโฟลิโอสาย DevOps — GitOps Kubernetes platform 4 โครงการบน Proxmox + AWS DR สร้างเองจากเหล็กจน Live Production"
    lang="th"
    bodyClass="pf"
>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
        rel="stylesheet"
    />

    <div class="noise" aria-hidden="true"></div>
    <div id="toast" role="status"></div>

    <nav id="nav">
        <div class="nav-in">
            <span class="brand">
                <span class="sysdot"></span>k3s-home: <b>READY</b> ·{" "}
                <b>~/traipoap</b>
            </span>
            <div class="nav-links">
                <a href="#arch">สถาปัตยกรรม</a>
                <a href="#lab">ฮาร์ดแวร์</a>
                <a href="#iac">IaC</a>
                <a href="#pipeline">Pipeline</a>
                <a href="#gitops">GitOps</a>
                <a href="#obs">Observability</a>
                <a href="#process">กระบวนการ</a>
                <a href="#resume">เรซูเม่</a>
                <a href="#contact">ติดต่อ</a>
                <a href="/" style="color:var(--grn)">
                    ← LUMINA
                </a>
            </div>
            <span class="clock" id="clock">
                <b>--:--:--</b> ICT
            </span>
        </div>
    </nav>

    <!-- ================= HERO ================= -->
    <header class="hero wrap" id="top">
        <div class="hero-grid">
            <div>
                <div class="eyebrow">$ whoami</div>
                <h1 id="scrName" data-text="TRAIPAP HUNTHONG">
                    TRAIPAP HUNTHONG
                </h1>
                <div class="role mono">
                    Traipoap Hunthong <span class="slash">//</span> DevOps
                    Engineer
                </div>
                <p class="lead">
                    ผมไม่ได้แค่ "ใช้" ระบบคลาวด์ — ผม
                    <strong>สร้างมันขึ้นเองกับมือ</strong>
                    ตั้งแต่เหล็กจนไปถึงหน้าเว็บ และแพลตฟอร์ม Log-Search
                    ที่คุณกำลังจะเห็น ก็รันอยู่บน K3s Platform ที่ผม Provision
                    เอง <strong>สด ๆ ในวินาทีนี้</strong>
                </p>
                <div class="hero-cta">
                    <a class="btn prime" href="#arch">
                        ▸ อ่านกระบวนการทั้งหมด
                    </a>
                    <a class="btn" href="#pipeline">
                        ▶ ดู Pipeline จริง
                    </a>
                </div>
                <div class="hero-stats">
                    <div class="hstat">
                        <b>
                            <span class="count" data-to="4" data-dec="0">
                                4
                            </span>
                            +,
                        </b>
                        <span>ปี Cloud/Network Ops</span>
                    </div>
                    <div class="hstat">
                        <b>
                            <span class="count" data-to="4" data-dec="0">
                                4
                            </span>
                        </b>
                        <span>โครงการหลัก</span>
                    </div>
                    <div class="hstat">
                        <b>
                            <span class="count" data-to="2" data-dec="0">
                                2
                            </span>
                        </b>
                        <span>Certs · CKA/CKAD</span>
                    </div>
                    <div class="hstat">
                        <b>
                            <span class="count" data-to="0" data-dec="0">
                                0
                            </span>
                        </b>
                        <span>ขั้นตอน Deploy ด้วยมือ</span>
                    </div>
                </div>
                <div class="nodechips">
                    <span class="nchip">
                        <i></i>super-node · HAProxy L7 + NFS + Garage
                    </span>
                    <span class="nchip">
                        <i></i>k3s-master · etcd
                    </span>
                    <span class="nchip">
                        <i></i>k3s-worker · crun/youki
                    </span>
                </div>
            </div>
            <div class="term" aria-label="terminal จำลองคำสั่งจริงของคลัสเตอร์">
                <div class="term-bar">
                    <i></i>
                    <i></i>
                    <i></i>
                    <em>traipoap@super-node: ~/cluster — ssh</em>
                </div>
                <div class="term-body" id="term">
                    <div class="tl-cmd">kubectl get nodes -o wide</div>
                    <div class="tl-out">
                        NAME STATUS ROLES AGE VERSION k3s-master Ready
                        control-plane,etcd 88d v1.30.4+k3s1 k3s-worker Ready
                        worker 88d v1.30.4+k3s1
                    </div>
                    <div class="tl-cmd">
                        kubectl get pods -A --no-headers | grep -c Running
                    </div>
                    <div class="tl-out">14</div>
                    <div class="tl-cmd">
                        curl -s https://app.traipoap.com/healthz
                    </div>
                    <div class="tl-ok">
                        &#123;"status":"ok","uptime":"99.98%"&#125;
                    </div>
                    <div class="tl-dim">
                        ────────────────────────────────────────────
                        แพลตฟอร์มที่คุณกำลังดู คือผลลัพธ์ของคำสั่งด้านบน ✓
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="marquee" aria-hidden="true">
        <div class="mq-track" id="mq">
            <span>
