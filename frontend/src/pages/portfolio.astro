    <script>
        // @ts-nocheck — ported as-is from the standalone portfolio.html (untyped
        // vanilla JS). Runtime behavior is unchanged; a typed rewrite can follow.
        document.documentElement.classList.add("js");
        (function () {
            "use strict";
            const $ = (s, c) => (c || document).querySelector(s),
                $$ = (s, c) => [...(c || document).querySelectorAll(s)];
            const REDUCED = matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            const wait = (ms) => new Promise((r) => setTimeout(r, ms));
            const pad = (n) => String(n).padStart(2, "0");
            const nowT = () => {
                const d = new Date();
                return (
                    pad(d.getHours()) +
                    ":" +
                    pad(d.getMinutes()) +
                    ":" +
                    pad(d.getSeconds())
                );
            };
            function toast(msg) {
                const t = $("#toast");
                t.textContent = msg;
                t.classList.add("show");
                clearTimeout(t._h);
                t._h = setTimeout(() => t.classList.remove("show"), 3200);
            }

            try {
                /* clock */
                function tickClock() {
                    try {
                        $("#clock").innerHTML =
                            "<b>" +
                            new Date().toLocaleTimeString("th-TH", {
                                hour12: false,
                                timeZone: "Asia/Bangkok",
                            }) +
                            "</b> ICT";
                    } catch (e) {}
                }
                tickClock();
                setInterval(tickClock, 1000);

                /* nav scrolled + active link */
                const nav = $("#nav");
                addEventListener(
                    "scroll",
                    () => nav.classList.toggle("scrolled", scrollY > 10),
                    { passive: true },
                );
                const secObs = new IntersectionObserver(
                    (es) => {
                        es.forEach((e) => {
                            if (e.isIntersecting) {
                                $$(".nav-links a").forEach((a) =>
                                    a.classList.toggle(
                                        "cur",
                                        a.getAttribute("href") ===
                                            "#" + e.target.id,
                                    ),
                                );
                            }
                        });
                    },
                    { rootMargin: "-40% 0px -55% 0px" },
                );
                [
                    "arch",
                    "lab",
                    "iac",
                    "pipeline",
                    "gitops",
                    "obs",
                    "process",
                    "resume",
                    "contact",
                ].forEach((id) => {
                    const el = document.getElementById(id);
                    if (el) secObs.observe(el);
                });

                /* reveal — เริ่มแบบมองเห็นได้ทันทีเมื่อโผล่พ้นขอบล่างเล็กน้อย */
                const rObs = new IntersectionObserver(
                    (es) => {
                        es.forEach((e) => {
                            if (e.isIntersecting) {
                                e.target.classList.add("in");
                                rObs.unobserve(e.target);
                            }
                        });
                    },
                    { threshold: 0, rootMargin: "0px 0px -6% 0px" },
                );
                $$(".rv, .sec-head").forEach((el) => rObs.observe(el));
                /* safety net: เผื่อ observer ไม่ทำงานในบางสภาพแวดล้อม */
                addEventListener("load", () =>
                    setTimeout(
                        () =>
                            $$(".rv, .sec-head").forEach((el) =>
                                el.classList.add("in"),
                            ),
                        1800,
                    ),
                );

                /* counters (ค่าจริงอยู่ใน markup แล้ว — นับใหม่เฉพาะเมื่อมองเห็น) */
                const cObs = new IntersectionObserver(
                    (es) => {
                        es.forEach((e) => {
                            if (!e.isIntersecting) return;
                            cObs.unobserve(e.target);
                            const el = e.target,
                                to = parseFloat(el.dataset.to),
                                dec = +el.dataset.dec || 0;
                            const fmt = (v) =>
                                v
                                    .toFixed(dec)
                                    .replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                            if (REDUCED) {
                                el.textContent = fmt(to);
                                return;
                            }
                            const t0 = performance.now(),
                                dur = 1400;
                            (function f(t) {
                                const p = Math.min(1, (t - t0) / dur),
                                    ease = 1 - Math.pow(1 - p, 3);
                                el.textContent = fmt(to * ease);
                                if (p < 1) requestAnimationFrame(f);
                            })(t0);
                        });
                    },
                    { threshold: 0.5 },
                );
                $$(".count").forEach((el) => cObs.observe(el));

                /* scramble name */
                (function () {
                    const el = $("#scrName");
                    if (!el || REDUCED) return;
                    const fin = el.dataset.text,
                        CH = "#_/\\[]{}=+*<>01?";
                    let f = 0,
                        total = fin.length * 3 + 10;
                    (function tick() {
                        let out = "";
                        for (let i = 0; i < fin.length; i++) {
                            out +=
                                i < (f - 8) / 2
                                    ? fin[i]
                                    : fin[i] === " "
                                      ? " "
                                      : CH[(Math.random() * CH.length) | 0];
                        }
                        el.textContent = out;
                        if (f++ < total) setTimeout(tick, 34);
                        else el.textContent = fin;
                    })();
                })();

                /* terminal typing — markup มีเนื้อหาอยู่แล้ว ถ้าจะพิมพ์ใหม่ค่อยล้าง */
                (function () {
                    const TERM = [
                        ["cmd", "kubectl get nodes -o wide"],
                        [
                            "out",
                            "NAME         STATUS   ROLES                AGE    VERSION",
                        ],
                        [
                            "out",
                            "k3s-master   Ready    control-plane,etcd   88d    v1.30.4+k3s1",
                        ],
                        [
                            "out",
                            "k3s-worker   Ready    worker               88d    v1.30.4+k3s1",
                        ],
                        [
                            "cmd",
                            "kubectl get pods -A --no-headers | grep -c Running",
                        ],
                        ["out", "14"],
                        ["cmd", "curl -s https://app.traipoap.com/healthz"],
                        ["ok", '{"status":"ok","uptime":"99.98%"}'],
                        ["dim", "────────────────────────────────────────────"],
                        [
                            "dim",
                            "แพลตฟอร์มที่คุณกำลังดู คือผลลัพธ์ของคำสั่งด้านบน ✓",
                        ],
                    ];
                    const body = $("#term");
                    if (!body || REDUCED) return;
                    body.innerHTML = "";
                    function line(cls, txt) {
                        const d = document.createElement("div");
                        d.className = "tl-" + cls;
                        d.textContent = txt;
                        body.appendChild(d);
                        return d;
                    }
                    (async () => {
                        await wait(500);
                        for (const l of TERM) {
                            if (l[0] === "cmd") {
                                const d = line("cmd", "");
                                for (const ch of l[1]) {
                                    d.textContent += ch;
                                    await wait(22 + Math.random() * 22);
                                }
                                await wait(320);
                            } else {
                                line(l[0], l[1]);
                                await wait(
                                    l[0] === "out" && l[1].startsWith("NAME")
                                        ? 260
                                        : 140,
                                );
                            }
                        }
                        const c = document.createElement("div");
                        c.className = "tl-cmd";
                        c.innerHTML = '<span class="caret"></span>';
                        body.appendChild(c);
                    })();
                })();

                /* arch layer sync */
                const archSvg = $("#archSvg"),
                    cards = $$(".layer-card");
                if (archSvg) {
                    const lObs = new IntersectionObserver(
                        (es) => {
                            es.forEach((e) => {
                                if (e.isIntersecting) {
                                    archSvg.dataset.active =
                                        e.target.dataset.layer;
                                    cards.forEach((c) =>
                                        c.classList.toggle(
                                            "on",
                                            c === e.target,
                                        ),
                                    );
                                }
                            });
                        },
                        { rootMargin: "-42% 0px -42% 0px" },
                    );
                    cards.forEach((c) => lObs.observe(c));
                }

                /* tabs */
                $$(".tab").forEach((b) =>
                    b.addEventListener("click", () => {
                        $$(".tab").forEach((x) => x.classList.remove("on"));
                        b.classList.add("on");
                        $$(".codep").forEach((p) =>
                            p.classList.toggle(
                                "on",
                                p.dataset.p === b.dataset.t,
                            ),
                        );
                    }),
                );

                /* pipeline demo */
                const STAGES = [
                    {
                        dur: 700,
                        logs: [
                            "→ git push origin main",
                            "remote: ✓ branch 'main' up to date → triggering workflow #142",
                        ],
                    },
                    {
                        dur: 2600,
                        logs: [
                            "gitleaks: scanning 483 files… no secrets found",
                            "sonarqube: quality gate passed — 0 new issues",
                            "✓ security gate ผ่าน",
                        ],
                    },
                    {
                        dur: 3200,
                        logs: [
                            "path filter: frontend/**, api/** → build",
                            "[1/6] FROM golang:1.24-alpine AS api",
                            "[6/6] exporting image ghcr.io/traipoap/app:a3f9c21",
                        ],
                    },
                    {
                        dur: 2400,
                        logs: [
                            "trivy image — CRITICAL 0 · HIGH 0 · MEDIUM 12",
                            "✓ SARIF report — gate ผ่าน",
                        ],
                    },
                    {
                        dur: 1800,
                        logs: [
                            "pushing layer sha256:4d9c…",
                            "✓ digest: sha256:9f2c1e7a (GHCR)",
                        ],
                    },
                    {
                        dur: 2400,
                        logs: [
                            "flux: imagepolicy/app detected new tag a3f9c21",
                            "reconciled 4 resources in 4.2s",
                            "✓ rollout สมบูรณ์ — app.traipoap.com ออนไลน์แล้ว",
                        ],
                    },
                ];
                const steps = $$("#steps .step"),
                    fill = $("#pipeFill"),
                    logBox = $("#pipeLog"),
                    timeEl = $("#pipeTime"),
                    btn = $("#btnPipe");
                let running = false;
                function stamp(s) {
                    return '<span class="lt">[' + nowT() + "]</span>" + s;
                }
                async function runPipe() {
                    if (running || !btn) return;
                    running = true;
                    btn.disabled = true;
                    btn.textContent = "⟳ กำลังรัน…";
                    steps.forEach((s) => {
                        s.classList.remove("run", "ok");
                        s.querySelector("em").textContent = "รอ";
                    });
                    logBox.innerHTML = "";
                    fill.style.width = "0";
                    let elapsed = 0;
                    const total = STAGES.reduce((a, s) => a + s.dur, 0),
                        REAL = 222;
                    for (let i = 0; i < STAGES.length; i++) {
                        const st = STAGES[i],
                            el = steps[i];
                        el.classList.add("run");
                        el.querySelector("em").textContent = "กำลังทำงาน…";
                        for (const ln of st.logs) {
                            logBox.insertAdjacentHTML(
                                "beforeend",
                                "<div>" +
                                    stamp(
                                        ln.startsWith("✓") ||
                                            ln.indexOf("→ 200") > -1
                                            ? '<span class="ok">' +
                                                  ln +
                                                  "</span>"
                                            : ln,
                                    ) +
                                    "</div>",
                            );
                            logBox.scrollTop = logBox.scrollHeight;
                            await wait(st.dur / st.logs.length);
                        }
                        elapsed += st.dur;
                        el.classList.remove("run");
                        el.classList.add("ok");
                        const s = Math.round((elapsed / total) * REAL);
                        el.querySelector("em").textContent =
                            "✓ " +
                            Math.floor(s / 60) +
                            "m " +
                            pad(s % 60) +
                            "s";
                        fill.style.width = ((i + 1) / STAGES.length) * 84 + "%";
                        timeEl.textContent =
                            Math.floor(s / 60) + "m " + pad(s % 60) + "s";
                    }
                    logBox.insertAdjacentHTML(
                        "beforeend",
                        "<div>" +
                            stamp(
                                '<span class="ok">★ deploy #142 สำเร็จ — commit a3f9c21 ทำงานอยู่บนคลัสเตอร์แล้ว</span>',
                            ) +
                            "</div>",
                    );
                    logBox.scrollTop = logBox.scrollHeight;
                    const pf = $("#pfSync");
                    if (pf) pf.textContent = "เมื่อสักครู่";
                    toast(
                        "✓ pipeline #142 สำเร็จใน 3m 42s — synced ลงคลัสเตอร์แล้ว",
                    );
                    btn.disabled = false;
                    btn.textContent = "▶ รันเดโมอีกครั้ง";
                    running = false;
                }
                if (btn) {
                    btn.addEventListener("click", runPipe);
                    let pipeAuto = false;
                    new IntersectionObserver(
                        (es) => {
                            es.forEach((e) => {
                                if (e.isIntersecting && !pipeAuto) {
                                    pipeAuto = true;
                                    REDUCED
                                        ? runPipe()
                                        : setTimeout(runPipe, 700);
                                }
                            });
                        },
                        { threshold: 0.3 },
                    ).observe($(".pipe-panel"));
                }

                /* gitops sync demo */
                const btnSync = $("#btnSync");
                if (btnSync)
                    btnSync.addEventListener("click", async function () {
                        this.disabled = true;
                        this.textContent = "SYNC…";
                        $("#certBadge").textContent = "SYNCING";
                        await wait(REDUCED ? 50 : 2600);
                        $("#certBadge").className = "badge sync";
                        $("#certBadge").textContent = "SYNCED";
                        $("#certSync").textContent = "เมื่อสักครู่";
                        this.textContent = "✓ แล้ว";
                        toast(
                            "✓ kiali synced — image ใหม่เข้าคลัสเตอร์เรียบร้อย",
                        );
                    });

                /* sparkline charts */
                function spark(canvas, color, valEl, min, max, start, fmt) {
                    if (!canvas) return;
                    const ctx = canvas.getContext("2d"),
                        N = 64;
                    let data = Array.from({ length: N }, () => start),
                        v = start;
                    function size() {
                        const r = canvas.getBoundingClientRect(),
                            d = devicePixelRatio || 1;
                        canvas.width = Math.max(10, r.width * d);
                        canvas.height = Math.max(10, r.height * d);
                        ctx.setTransform(d, 0, 0, d, 0, 0);
                    }
                    size();
                    addEventListener("resize", size);
                    function draw() {
                        const r = canvas.getBoundingClientRect(),
                            w = r.width,
                            h = r.height;
                        ctx.clearRect(0, 0, w, h);
                        ctx.strokeStyle = "rgba(140,190,210,.1)";
                        ctx.lineWidth = 1;
                        for (let i = 1; i < 4; i++) {
                            ctx.beginPath();
                            ctx.moveTo(0, (h / 4) * i);
                            ctx.lineTo(w, (h / 4) * i);
                            ctx.stroke();
                        }
                        ctx.beginPath();
                        data.forEach((val, i) => {
                            const x = (i / (N - 1)) * w,
                                y =
                                    h -
                                    ((val - min) / (max - min)) * (h - 8) -
                                    4;
                            i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
                        });
                        ctx.strokeStyle = color;
                        ctx.lineWidth = 1.8;
                        ctx.stroke();
                        ctx.lineTo(w, h);
                        ctx.lineTo(0, h);
                        ctx.closePath();
                        const g = ctx.createLinearGradient(0, 0, 0, h);
                        g.addColorStop(0, color + "33");
                        g.addColorStop(1, color + "00");
                        ctx.fillStyle = g;
                        ctx.fill();
                        const ly =
                            h -
                            ((data[N - 1] - min) / (max - min)) * (h - 8) -
                            4;
                        ctx.fillStyle = color;
                        ctx.beginPath();
                        ctx.arc(w - 3, ly, 3, 0, 7);
                        ctx.fill();
                    }
                    draw();
                    if (REDUCED) {
                        valEl.textContent = fmt(start);
                        return;
                    }
                    setInterval(() => {
                        v = Math.min(
                            max,
                            Math.max(
                                min,
                                v + (Math.random() - 0.5) * (max - min) * 0.09,
                            ),
                        );
                        data.push(v);
                        data.shift();
                        draw();
                        valEl.textContent = fmt(v);
                    }, 750);
                }
                spark(
                    $("#cvCpu"),
                    "#34d399",
                    $("#cpuVal"),
                    0,
                    100,
                    36,
                    (v) => v.toFixed(0) + "%",
                );
                spark(
                    $("#cvMem"),
                    "#4cc2ff",
                    $("#memVal"),
                    0,
                    100,
                    58,
                    (v) => v.toFixed(0) + "%",
                );
                spark(
                    $("#cvNet"),
                    "#fbbf24",
                    $("#netVal"),
                    0,
                    200,
                    74,
                    (v) => v.toFixed(0) + " Mb/s",
                );

                /* latency */
                setTimeout(() => {
                    const el = $("#lat");
                    if (el)
                        el.textContent =
                            "~ " + (8 + Math.round(Math.random() * 12)) + " ms";
                }, 900);
            } catch (err) {
                /* สคริปต์พัง → ปิดโหมดแอนิเมชัน เนื้อหาทุกส่วนกลับมาแสดงครบ */
                document.documentElement.classList.remove("js");
                console.error("portfolio script fallback:", err);
            }
        })();
    </script>
</Layout>
