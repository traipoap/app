---
import Layout from "../layouts/Layout.astro";

// เวลา build จริงสำหรับแสดงใน footer — หน้า static ถูก generate ตอนรัน
// build/dev ดังนั้น new Date() ใน frontmatter คือเวลาตอน generate พอดี
const buildStamp = new Date().toLocaleString("th-TH", {
    hour12: false,
    timeZone: "Asia/Bangkok",
    dateStyle: "medium",
    timeStyle: "short",
});
---

<Layout
    title="Mindset & Methodology — Traipoap.DEV"
    description="ความเข้าใจของผมต่อ SDLC, DevOps, Agile, Scrum และ Digital Transformation ที่ผ่านการลงสนามจริง"
>
    <div class="methodology">
        <div class="noise" aria-hidden="true"></div>

        <nav id="nav">
            <div class="nav-in">
                <span class="brand">
                    <span class="sysdot"></span>k3s-home: <b>READY</b> ·{" "}
                    <b>~/traipoap/mindset</b>
                </span>
                <div class="nav-links">
                    <a class="home" href="/">
                        ← หน้าหลัก
                    </a>
                    <a href="#sdlc">SDLC</a>
                    <a href="#devops">DevOps</a>
                    <a href="#agile">Agile</a>
                    <a href="#scrum">Scrum</a>
                    <a href="#dx">Transformation</a>
                    <a href="#belief">ความเชื่อ</a>
                </div>
                <span class="clock" id="clock">
                    <b>--:--:--</b> ICT
                </span>
            </div>
        </nav>

        <!-- ================= OPENING ================= -->
        <header class="hero wrap">
            <div class="hero-grid">
                <div>
                    <div class="eyebrow">
                        $ cat /etc/mindset/principles.conf
                    </div>
                    <h1 id="scrTitle" data-text="PROCESS ≠ RITUAL">
                        PROCESS ≠ RITUAL
                    </h1>
                    <div class="sub-role">
                        กระบวนการ ไม่ใช่พิธีกรรม — เรื่องของ SDLC · DevOps ·
                        Agile · Scrum · Digital Transformation
                    </div>
                    <p class="lead">
                        เฟรมเวิร์กทั้งห้าตัวนี้ผมไม่ได้รู้จักจากการอ่านหนังสือสอบ
                        — แต่จากการ{" "}
                        <strong>
                            ทำระบบพัง ทำสปรินต์ล่ม
                            และนั่งอธิบายของทางเทคนิคให้คนไม่ใช่โปรแกรมเมอร์ฟังนับครั้งไม่ถ้วน
                        </strong>{" "}
                        หน้าต่อไปคือความเข้าใจฉบับ "ผ่านสนามจริง" ของผม
                    </p>
                    <div class="topic-chips">
                        <span class="tchip">
                            <b>2</b> สัปดาห์ / สปรินต์
                        </span>
                        <span class="tchip">
                            <b>5</b> หลัก CALMS
                        </span>
                        <span class="tchip">
                            <b>4</b> คุณค่า Agile
                        </span>
                        <span class="tchip">
                            <b>~4</b> ชม. lead time
                        </span>
                    </div>
                    <div class="hero-cta">
                        <a class="btn prime" href="#sdlc">
                            ▸ เริ่มที่ SDLC
                        </a>
                        <a class="btn" href="/#pipeline">
                            ▶ ดู Pipeline ของจริง
                        </a>
                    </div>
                </div>
                <figure class="loop-box">
                    <svg
                        class="loop"
                        viewBox="0 0 560 320"
                        role="img"
                        aria-label="DevOps infinity loop 8 เฟส"
                    >
                        <text class="ci" x="150" y="160" text-anchor="middle">
                            CONTINUOUS
                        </text>
                        <text class="ci" x="150" y="174" text-anchor="middle">
                            INTEGRATION
                        </text>
                        <text class="ci" x="410" y="160" text-anchor="middle">
                            CONTINUOUS
                        </text>
                        <text class="ci" x="410" y="174" text-anchor="middle">
                            DELIVERY
                        </text>
                        <path
                            class="lp"
                            id="loopPath"
                            d="M280,160 C280,95 215,50 150,50 C85,50 40,95 40,160 C40,225 85,270 150,270 C215,270 280,225 280,160 C280,95 345,50 410,50 C475,50 520,95 520,160 C520,225 475,270 410,270 C345,270 280,225 280,160 Z"
                        />
                        <path
                            class="lp-flow"
                            d="M280,160 C280,95 215,50 150,50 C85,50 40,95 40,160 C40,225 85,270 150,270 C215,270 280,225 280,160 C280,95 345,50 410,50 C475,50 520,95 520,160 C520,225 475,270 410,270 C345,270 280,225 280,160 Z"
                            opacity=".55"
                        />
                        <g>
                            <circle class="pdot" cx="150" cy="50" r="5" />
                            <text
                                class="ph"
                                x="150"
                                y="34"
                                text-anchor="middle"
                            >
                                PLAN
                            </text>
                        </g>
                        <g>
                            <circle class="pdot" cx="40" cy="160" r="5" />
                            <text
                                class="ph"
                                x="40"
                                y="146"
                                text-anchor="middle"
                            >
                                CODE
                            </text>
                        </g>
                        <g>
                            <circle class="pdot" cx="150" cy="270" r="5" />
                            <text
                                class="ph"
                                x="150"
                                y="292"
                                text-anchor="middle"
                            >
                                BUILD
                            </text>
                        </g>
                        <g>
                            <circle class="pdot" cx="232" cy="238" r="5" />
                            <text
                                class="ph"
                                x="228"
                                y="260"
                                text-anchor="middle"
                            >
                                TEST
                            </text>
                        </g>
                        <g>
                            <circle class="pdot o" cx="410" cy="50" r="5" />
                            <text
                                class="ph"
                                x="410"
                                y="34"
                                text-anchor="middle"
                            >
                                RELEASE
                            </text>
                        </g>
                        <g>
                            <circle class="pdot o" cx="520" cy="160" r="5" />
                            <text
                                class="ph"
                                x="520"
                                y="146"
                                text-anchor="middle"
                            >
                                DEPLOY
                            </text>
                        </g>
                        <g>
                            <circle class="pdot o" cx="410" cy="270" r="5" />
                            <text
                                class="ph"
                                x="410"
                                y="292"
                                text-anchor="middle"
                            >
                                OPERATE
                            </text>
                        </g>
                        <g>
                            <circle class="pdot o" cx="328" cy="238" r="5" />
                            <text
                                class="ph"
                                x="332"
                                y="260"
                                text-anchor="middle"
                            >
                                MONITOR
                            </text>
                        </g>
                        <circle
                            class="loop-dot"
                            id="loopDot"
                            r="5.5"
                            cx="280"
                            cy="160"
                        />
                    </svg>
                    <figcaption>
                        THE DEVOPS INFINITY — วนไม่มีวันจบ เพราะ "เสร็จ"
                        ของซอฟต์แวร์ไม่มีอยู่จริง
                    </figcaption>
                </figure>
            </div>
        </header>

        <div class="marquee" aria-hidden="true">
            <div class="mq-track">
                <span>
                    PLAN<b>∞</b>CODE<b>∞</b>BUILD<b>∞</b>TEST<b>∞</b>RELEASE
                    <b>∞</b>DEPLOY<b>∞</b>OPERATE<b>∞</b>MONITOR<b>∞</b>FEEDBACK
                    <b>∞</b>LEARN<b>∞</b>
                </span>
                <span>
                    PLAN<b>∞</b>CODE<b>∞</b>BUILD<b>∞</b>TEST<b>∞</b>RELEASE
                    <b>∞</b>DEPLOY<b>∞</b>OPERATE<b>∞</b>MONITOR<b>∞</b>FEEDBACK
                    <b>∞</b>LEARN<b>∞</b>
                </span>
            </div>
        </div>

        <!-- ================= 09 SDLC ================= -->
        <section id="sdlc">
            <div class="wrap">
                <div class="sec-head rv">
                    <span class="sec-idx">09</span>
                    <div>
                        <span class="sec-tag">
                            SOFTWARE DEVELOPMENT LIFE CYCLE
                        </span>
                        <h2 class="lm">
                            <span>
                                SDLC — วงจรชีวิตที่สอนผมเรื่องการ "รู้ตัวช้า"
                            </span>
                        </h2>
                        <p class="sub">
                            SDLC คือกรอบคิดว่าซอฟต์แวร์หนึ่งตัวเกิด เติบโต
                            และตายอย่างไร —
                            ความแตกต่างระหว่างโมเดลแต่ละแบบอยู่ตรง
                            "เราค้นพบความผิดพลาดเมื่อไหร่" ลองสลับดูทั้งสองแบบ
                        </p>
                    </div>
                </div>

                <div class="rv">
                    <div
                        class="seg"
                        role="tablist"
                        aria-label="เลือกโมเดล SDLC"
                    >
                        <button type="button" id="segWf" class="on">
                            WATERFALL
                        </button>
                        <button type="button" id="segAg">
                            AGILE / ITERATIVE
                        </button>
                    </div>

                    <div class="sdlc-view on" id="wfView">
                        <div class="wf-step">
                            <span class="lbl">Requirements</span>
                            <div class="bf" style="width:100%"></div>
                            <span class="mon">เดือน 1–2</span>
                        </div>
                        <div class="wf-step">
                            <span class="lbl">Design</span>
                            <div class="bf"></div>
                            <span class="mon">เดือน 3–4</span>
                        </div>
                        <div class="wf-step">
                            <span class="lbl">Development</span>
                            <div class="bf"></div>
                            <span class="mon">เดือน 5–7</span>
                        </div>
                        <div class="wf-step bad" id="wfBad">
                            <span class="lbl">Testing ⚠</span>
                            <div class="bf"></div>
                            <span class="mon">เดือน 8–9</span>
                        </div>
                        <div class="wf-step">
                            <span class="lbl">Deployment</span>
                            <div class="bf"></div>
                            <span class="mon">เดือน 10–12</span>
                        </div>
                        <div class="crack-note" id="crackNote">
                            ⚠ เดือนที่ 9: ลูกค้าบอกว่า "จริง ๆ
                            แล้วเราอยากได้ไม่เหมือนกัน" —
                            แต่งบและเวลาเหลือไม่ถึง 20%
                        </div>
                    </div>

                    <div class="sdlc-view" id="agView">
                        <div class="sprints" id="sprints"></div>
                    </div>

                    <div class="sdlc-note" id="sdlcNote"></div>
                </div>
            </div>
        </section>

        <!-- ================= 10 DEVOPS ================= -->
        <section
            id="devops"
            style="background:var(--bg2);border-block:1px solid var(--line)"
        >
            <div class="wrap">
                <div class="sec-head rv">
                    <span class="sec-idx">10</span>
                    <div>
                        <span class="sec-tag">DEVOPS — CULTURE FIRST</span>
                        <h2 class="lm">
                            <span>DevOps คือวัฒนธรรม ไม่ใช่ชื่อตำแหน่ง</span>
                        </h2>
                        <p class="sub">
                            ผมสรุปความเข้าใจทั้งหมดไว้ในตัวอักษรห้าตัว —{" "}
                            <b class="mono" style="color:var(--grn)">
                                CALMS
                            </b>{" "}
                            —
                            กดดูทีละตัวได้เลยว่าแต่ละตัวหน้าตาเป็นยังไงในชีวิตจริงของผม
                        </p>
                    </div>
                </div>

                <div class="rv">
                    <div
                        class="calms-row"
                        role="tablist"
                        aria-label="CALMS framework"
                    >
                        <button type="button" data-c="0" class="on">
                            C
                        </button>
                        <button type="button" data-c="1">
                            A
                        </button>
                        <button type="button" data-c="2">
                            L
                        </button>
                        <button type="button" data-c="3">
                            M
                        </button>
                        <button type="button" data-c="4">
                            S
                        </button>
                    </div>
                    <div class="calms-panel" id="calmsPanel"></div>

                    <div class="ways">
                        <div class="way rv">
                            <span class="n">THE FIRST WAY</span>
                            <b>Flow — ไหลให้เร็ว</b>
                            <p>
                                ทำให้งานไหลจากไอเดียถึงผู้ใช้เร็วที่สุด
                                ด้วยล็อตเล็ก ๆ และระบบอัตโนมัติ —
                                นี่คือเหตุผลที่ผมทำ pipeline ในหน้าหลัก
                            </p>
                        </div>
                        <div class="way rv" style="--d:1">
                            <span class="n">THE SECOND WAY</span>
                            <b>Feedback — ฟังให้เร็ว</b>
                            <p>
                                สัญญาณจาก production
                                ต้องย้อนกลับมาหาคนสร้างให้ไวที่สุด — Grafana +
                                Alert เข้า LINE ภายในหนึ่งนาที
                            </p>
                        </div>
                        <div class="way rv" style="--d:2">
                            <span class="n">THE THIRD WAY</span>
                            <b>Continual Learning — เรียนให้เรื่อย</b>
                            <p>
                                เจียดเวลาทำทดลองและซ้อมพังอย่างจงใจ —
                                เพราะบทเรียนที่ไม่เคยจ่ายวันนี้ จะแพงขึ้นทุกวัน
                            </p>
                        </div>
                    </div>

                    <div class="wall rv">
                        <div class="wall-box dev">
                            <b>DEV</b>
                            <small>
                                "ขอฟีเจอร์ใหม่เพิ่มอีก!"
                                <br />
                                วัดกันที่ความเร็ว
                            </small>
                        </div>
                        <div class="wall-vs">
                            <span class="x">✗</span>กำแพง "โยนตั๋วข้ามรั้ว"
                            <br />
                            ต่างคนต่างมี KPI คนละทิศ
                        </div>
                        <div class="wall-box ops">
                            <b>OPS</b>
                            <small>
                                "อย่าไปยุ่งกับระบบที่กำลังนิ่ง!"
                                <br />
                                วัดกันที่ความเสถียร
                            </small>
                        </div>
                    </div>
                    <div
                        class="wall rv"
                        style="grid-template-columns:1fr;max-width:520px;margin-left:auto;margin-right:auto;margin-top:14px"
                    >
                        <div class="wall-box merged">
                            <b>DEV + OPS = รับผิดชอบร่วมกัน</b>
                            <small>
                                ทีมเดียวกันเป็นเจ้าของทั้ง "ความเร็ว" และ
                                "ความเสถียร" — ใครสร้าง คนนั้นเฝ้า (you build
                                it, you run it)
                                <br />
                                โฮมแล็บของผมคือที่ซ้อมเรื่องนี้:
                                ผมเป็นทั้งคนเขียนและคนโดนปลุกตอนตีสาม
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= 11 AGILE ================= -->
        <section id="agile">
            <div class="wrap">
                <div class="sec-head rv">
                    <span class="sec-idx">11</span>
                    <div>
                        <span class="sec-tag">AGILE MANIFESTO (2001)</span>
                        <h2 class="lm">
                            <span>
                                Agile — สิ่งที่อยู่ทางซ้ายสำคัญกว่า
                                แต่อย่าทิ้งทางขวา
                            </span>
                        </h2>
                        <p class="sub">
                            สี่คุณค่าที่ผมอ่านครั้งแรกตอนยังเป็น IT Support
                            และอ่านใหม่อีกครั้งทุกครั้งที่ทีมเริ่มทำ "พิธีกรรม"
                            โดยลืม "เจตนา"
                        </p>
                    </div>
                </div>

                <div class="values">
                    <div class="val rv">
                        <span class="l">Individuals &amp; interactions</span>
                        <span class="over">OVER</span>
                        <span class="r">processes &amp; tools</span>
                    </div>
                    <div class="val rv" style="--d:1">
                        <span class="l">Working software</span>
                        <span class="over">OVER</span>
                        <span class="r">comprehensive documentation</span>
                    </div>
                    <div class="val rv" style="--d:2">
                        <span class="l">Customer collaboration</span>
                        <span class="over">OVER</span>
                        <span class="r">contract negotiation</span>
                    </div>
                    <div class="val rv" style="--d:3">
                        <span class="l">Responding to change</span>
                        <span class="over">OVER</span>
                        <span class="r">following a plan</span>
                    </div>
                </div>
                <div class="val-note rv">
                    <b>หมายเหตุฉบับลงสนาม:</b> ประโยคเต็มของ Manifesto ลงท้ายว่า
                    "…นั่นคือ แม้สิ่งทางขวาจะมีค่า
                    แต่เราให้ค่าสิ่งทางซ้ายมากกว่า" — ทีมที่ชอบอ้าง Agile เพื่อ
                    "ไม่ต้องเขียนเอกสารอะไรเลย" คือทีมที่อ่านแค่ครึ่งแรกครับ
                </div>

                <div class="principles">
                    <div class="pr rv">
                        <span class="n">PRINCIPLE #1 ที่ผมเก็บไว้</span>
                        <p>"ส่งมอบงานให้ลูกค้าตั้งแต่เนิ่น ๆ และต่อเนื่อง"</p>
                        <small>
                            — นี่คือหัวใจของเดโมทุก 2 สัปดาห์
                            และคือเหตุผลที่ผมยอมให้เว็บยังไม่สวยแต่ต้อง
                            "จับต้องได้" ก่อน
                        </small>
                    </div>
                    <div class="pr rv" style="--d:1">
                        <span class="n">PRINCIPLE #4 ที่ผมเก็บไว้</span>
                        <p>"คนฝั่งธุรกิจและคนทำของ ต้องทำงานด้วยกันทุกวัน"</p>
                        <small>
                            — โปรเจกต์ที่ผมเห็นพังทุกโปรเจกต์ มีสาเหตุเดียวกัน:
                            สองฝั่งนี้คุยกันผ่านเอกสารเท่านั้น
                        </small>
                    </div>
                    <div class="pr rv" style="--d:2">
                        <span class="n">PRINCIPLE #12 ที่ผมเก็บไว้</span>
                        <p>"สะท้อนคิดเป็นระยะ แล้วปรับตัวให้เข้าที่"</p>
                        <small>
                            — หรือ "Retro" — พิธีกรรมเดียวที่ผมยอมไม่ยอมขาด
                            แม้ทีมจะเหนื่อยแค่ไหนก็ตาม
                        </small>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= 12 SCRUM ================= -->
        <section
            id="scrum"
            style="background:var(--bg2);border-block:1px solid var(--line)"
        >
            <div class="wrap">
                <div class="sec-head rv">
                    <span class="sec-idx">12</span>
                    <div>
                        <span class="sec-tag">
                            SCRUM — ONE SPRINT, UP CLOSE
                        </span>
                        <h2 class="lm">
                            <span>Scrum — ลองกดดูทีละวันในสปรินต์ของผม</span>
                        </h2>
                        <p class="sub">
                            สปรินต์ 2 สัปดาห์หนึ่งรอบมีเหตุการณ์อะไรบ้าง
                            คลิกที่วันในปฏิทินเพื่อดูรายละเอียด — และสิ่งที่ผม
                            "ทำจริง" ในวันนั้น
                        </p>
                    </div>
                </div>

                <div class="scrum-grid">
                    <div class="rv">
                        <span class="goal-tag">
                            🎯 SPRINT GOAL: "ผู้ใช้ขอสิทธิ์ผ่านมือถือ
                            แล้วผู้อนุมัติกดอนุมัติได้จากหน้าเดียว"
                        </span>
                        <div class="cal" id="cal"></div>
                        <div class="artifacts">
                            <div class="art">
                                <b>Product Backlog</b>
                                <small>
                                    เจ้าของ: PRODUCT OWNER · เรียงตามคุณค่า
                                </small>
                            </div>
                            <div class="art-arrow">→</div>
                            <div class="art">
                                <b>Sprint Backlog</b>
                                <small>
                                    เจ้าของ: DEVELOPERS · สัญญาของสปรินต์นี้
                                </small>
                            </div>
                            <div class="art-arrow">→</div>
                        </div>
                        <div
                            class="artifacts"
                            style="grid-template-columns:1fr;max-width:280px;margin-top:12px"
                        >
                            <div class="art" style="border-color:var(--grn)">
                                <b>Increment ✓</b>
                                <small>
