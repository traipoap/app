    <script>
        document.documentElement.classList.add("js");
        (function () {
            "use strict";
            const $ = (s: string, c?: ParentNode) =>
                (c || document).querySelector(s) as HTMLElement | null;
            const qsa = (s: string, c?: ParentNode) => [
                ...((c || document) as ParentNode).querySelectorAll(s),
            ];
            const REDUCED = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            const wait = (ms: number) =>
                new Promise<void>((r) => window.setTimeout(r, ms));
            try {
                /* clock + nav */
                function tick() {
                    try {
                        const n = $("#clock");
                        if (n)
                            n.innerHTML =
                                "<b>" +
                                new Date().toLocaleTimeString("th-TH", {
                                    hour12: false,
                                    timeZone: "Asia/Bangkok",
                                }) +
                                "</b> ICT";
                    } catch (e) {}
                }
                tick();
                setInterval(tick, 1000);
                const nav = $("#nav");
                window.addEventListener(
                    "scroll",
                    () => {
                        if (nav)
                            nav.classList.toggle(
                                "scrolled",
                                window.scrollY > 10,
                            );
                    },
                    { passive: true },
                );
                const secObs = new IntersectionObserver(
                    (es: IntersectionObserverEntry[]) => {
                        es.forEach((e: IntersectionObserverEntry) => {
                            if (e.isIntersecting) {
                                qsa(".nav-links a").forEach((a: Element) => {
                                    const l = a as HTMLAnchorElement;
                                    l.classList.toggle(
                                        "cur",
                                        l.getAttribute("href") ===
                                            "#" + e.target.id,
                                    );
                                });
                            }
                        });
                    },
                    { rootMargin: "-40% 0px -55% 0px" },
                );
                ["sdlc", "devops", "agile", "scrum", "dx", "belief"].forEach(
                    (id) => {
                        const el = document.getElementById(id);
                        if (el) secObs.observe(el);
                    },
                );

                /* reveal + fallback */
                const rObs = new IntersectionObserver(
                    (es: IntersectionObserverEntry[]) => {
                        es.forEach((e: IntersectionObserverEntry) => {
                            if (e.isIntersecting) {
                                e.target.classList.add("in");
                                rObs.unobserve(e.target);
                            }
                        });
                    },
                    { threshold: 0, rootMargin: "0px 0px -6% 0px" },
                );
                qsa(".rv, .sec-head").forEach((el: Element) =>
                    rObs.observe(el),
                );
                window.addEventListener("load", () =>
                    window.setTimeout(
                        () =>
                            qsa(".rv, .sec-head").forEach((el: Element) =>
                                el.classList.add("in"),
                            ),
                        1800,
                    ),
                );

                /* scramble title — the h1 box is pinned to the final text's
                   size (hidden absolute sizer) so random glyphs of varying
                   width never reflow the layout (fixes the jitter) */
                (function () {
                    const el = $("#scrTitle");
                    if (!el || REDUCED) return;
                    const fin = el.dataset.text,
                        CH = "#_/\\[]{}=+*<>01≠";
                    if (!fin) return;
                    const sizer = document.createElement("span");
                    sizer.setAttribute("aria-hidden", "true");
                    sizer.style.cssText =
                        "position:absolute;top:0;left:0;width:100%;visibility:hidden;";
                    sizer.textContent = fin;
                    const holder = document.createTextNode("");
                    el.textContent = "";
                    el.style.position = "relative";
                    el.style.overflow = "hidden";
                    el.appendChild(sizer);
                    el.appendChild(holder);
                    el.style.height = sizer.offsetHeight + "px";
                    let f = 0,
                        total = fin.length * 3 + 10;
                    (function t() {
                        let o = "";
                        for (let i = 0; i < fin.length; i++) {
                            o +=
                                i < (f - 8) / 2
                                    ? fin[i]
                                    : fin[i] === " "
                                      ? " "
                                      : CH[(Math.random() * CH.length) | 0];
                        }
                        holder.data = o;
                        if (f++ < total) {
                            window.setTimeout(t, 34);
                        } else {
                            sizer.remove();
                            el.textContent = fin;
                            el.style.position = "";
                            el.style.overflow = "";
                            el.style.height = "";
                        }
                    })();
                })();

                /* infinity loop: draw-in + travelling dot */
                (function () {
                    const p = $("#loopPath") as SVGPathElement | null,
                        d = $("#loopDot") as SVGCircleElement | null;
                    if (!p || !d) return;
                    if (REDUCED) {
                        d.remove();
                        return;
                    }
                    const L = p.getTotalLength();
                    p.style.strokeDasharray = String(L);
                    p.style.strokeDashoffset = String(L);
                    p.getBoundingClientRect();
                    p.style.transition = "stroke-dashoffset 2.4s ease";
                    p.style.strokeDashoffset = "0";
                    window.setTimeout(() => {
                        p.style.strokeDasharray = "none";
                        p.style.transition = "none";
                    }, 2600);
                    const st = performance.now();
                    (function f(t: number) {
                        const k = ((t - st) % 13000) / 13000,
                            pt = p.getPointAtLength(k * L);
                        d.setAttribute("cx", String(pt.x));
                        d.setAttribute("cy", String(pt.y));
                        requestAnimationFrame(f);
                    })(st);
                })();

                /* 09 SDLC toggle */
                const NOTE_WF =
                    '<b>สิ่งที่วอเตอร์ฟอลล์สอนผม:</b> มันไม่ผิดสำหรับงานที่ "รู้ครบตั้งแต่แรก" (เช่นสร้างสะพาน) — แต่ซอฟต์แวร์ไม่ใช่สะพาน ความต้องการเปลี่ยนทุกวัน ยิ่งรู้ตัวช้า ค่าแก้ยิ่งแพงแบบยกกำลัง ในโปรเจกต์แรก ผมใช้เวลารวม 11 เดือน และ 7 เดือนสุดท้ายคือการทำในสิ่งที่ลูกค้าไม่ได้ขอ';
                const NOTE_AG =
                    '<b>สิ่งที่อิเทอเรชันสอนผม:</b> ทุก 2 สัปดาห์มีของจริงให้จับ = ทุก 2 สัปดาห์มีโอกาส "เปลี่ยนใจได้โดยจ่ายไม่แพง" ความเสี่ยงถูกซอยจนเล็ก และบทเรียนที่ได้จากแต่ละรอบคือดอกเบี้ยทบต้น';
                const note0 = $("#sdlcNote");
                if (note0) note0.innerHTML = NOTE_WF;
                $("#segWf")?.addEventListener("click", () => {
                    setMode(true);
                });
                $("#segAg")?.addEventListener("click", () => {
                    setMode(false);
                });
                function setMode(wf: boolean) {
                    const segWf = $("#segWf"),
                        segAg = $("#segAg"),
                        wfView = $("#wfView"),
                        agView = $("#agView"),
                        note = $("#sdlcNote"),
                        crack = $("#crackNote");
                    if (segWf) segWf.classList.toggle("on", wf);
                    if (segAg) segAg.classList.toggle("on", !wf);
                    if (wfView) wfView.classList.toggle("on", wf);
                    if (agView) agView.classList.toggle("on", !wf);
                    if (note) note.innerHTML = wf ? NOTE_WF : NOTE_AG;
                    if (crack) crack.classList.remove("show");
                    if (wf && !REDUCED) {
                        window.setTimeout(() => {
                            if (crack) crack.classList.add("show");
                        }, 900);
                    }
                }
                /* sprint blocks */
                (function () {
                    const box = $("#sprints");
                    if (!box) return;
                    let h = "";
                    for (let i = 1; i <= 12; i++) {
                        h +=
                            '<div class="sprint' +
                            (i === 12 ? " now" : "") +
                            '"><b>S' +
                            i +
                            "</b><small>" +
                            (i === 12 ? "● กำลังวิ่งอยู่" : "✓ ได้เดโม") +
                            "</small></div>";
                    }
                    box.innerHTML = h;
                })();
                if (!REDUCED)
                    window.setTimeout(() => {
                        const c = $("#crackNote");
                        if (c) c.classList.add("show");
                    }, 1200);

                /* 10 CALMS */
                const CALMS = [
                    {
                        t: "Culture",
                        h: "วัฒนธรรม",
                        def: "Dev และ Ops เลิกมีกำแพง หันมาถือเป้าหมายเดียวกัน — ส่งของให้เร็ว และของนั้นต้องไม่พัง",
                        prac: 'ทุกครั้งที่ผมทำระบบพัง (หรือจงใจทำให้พังใน Chaos Drill) จะตามด้วย "blameless postmortem" เสมอ: ถามว่า "ระบบพลาดตรงไหน" ไม่ถามว่า "ใครทำ"',
                        evi: "หลักฐาน: บันทึก Chaos Drill #3 ในหน้าหลัก — มีบทเรียน ไม่มีชื่อคนผิด",
                    },
                    {
                        t: "Automation",
                        h: "ระบบอัตโนมัติ",
                        def: "อะไรที่ทำซ้ำเกินสองครั้ง ต้องกลายเป็นโค้ด — คนควรใช้เวลาไปกับเรื่องที่ต้องใช้สมอง ไม่ใช่การคลิกซ้ำ",
                        prac: "โครงสร้างทั้งหมดสร้างด้วย Terraform, ตั้งค่าด้วย Ansible, ปล่อยของด้วย GitOps — ถ้าพรุ่งนี้เครื่องหายทั้งตู้ ผมประกอบใหม่ได้ในครึ่งชั่วโมง",
                        evi: "หลักฐาน: ~3,400 บรรทัด IaC ใน section 03 ของหน้าหลัก",
                    },
                    {
                        t: "Lean",
