            font-weight: 600;
        }
        .methodology .loop .pdot {
            fill: var(--grn);
        }
        .methodology .loop .pdot.o {
            fill: var(--cyn);
        }
        .methodology .loop-dot {
            fill: #fff;
            filter: drop-shadow(0 0 6px rgba(52, 211, 153, 0.9));
        }

        /* marquee */
        .methodology .marquee {
            border-block: 1px solid var(--line);
            overflow: hidden;
            background: rgba(10, 16, 22, 0.6);
        }
        .methodology .mq-track {
            display: flex;
            width: max-content;
            animation: mth-mq 28s linear infinite;
        }
        .methodology .mq-track span {
            font-family: var(--mono);
            font-size: 12.5px;
            color: var(--mut);
            padding: 13px 0;
            letter-spacing: 0.12em;
        }
        .methodology .mq-track span b {
            color: var(--grn);
            font-weight: 500;
            padding: 0 20px;
        }
        @keyframes mth-mq {
            to {
                transform: translateX(-50%);
            }
        }

        /* sections */
        .methodology section {
            padding: 96px 0;
            position: relative;
        }
        .methodology .sec-head {
            display: flex;
            gap: 22px;
            align-items: flex-start;
            margin-bottom: 48px;
        }
        .methodology .sec-idx {
            font-family: var(--disp);
            font-size: clamp(2.4rem, 5vw, 3.6rem);
            font-weight: 700;
            color: transparent;
            -webkit-text-stroke: 1.5px rgba(52, 211, 153, 0.55);
            line-height: 1;
            flex-shrink: 0;
        }
        .methodology .sec-head h2 {
            font-family: var(--disp);
            font-size: clamp(1.7rem, 3.4vw, 2.5rem);
            font-weight: 700;
            line-height: 1.2;
        }
        .methodology .sec-head .sub {
            color: var(--mut);
            margin-top: 8px;
            max-width: 62ch;
        }
        .methodology .sec-tag {
            font-family: var(--mono);
            font-size: 11px;
            color: var(--amb);
            letter-spacing: 0.18em;
            display: block;
            margin-bottom: 6px;
        }
        .methodology .lm {
            overflow: hidden;
        }

        @media (prefers-reduced-motion: no-preference) {
            html.js .methodology .rv {
                opacity: 0;
                transform: translateY(22px);
                transition:
                    opacity 0.7s ease,
                    transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
                transition-delay: calc(var(--d, 0) * 90ms);
            }
            html.js .methodology .rv.in {
                opacity: 1;
                transform: none;
            }
            html.js .methodology .lm > span {
                display: block;
                transform: translateY(115%);
                transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
            }
            html.js .methodology .in .lm > span {
                transform: translateY(0);
            }
            html.js .methodology .bar i {
                width: 0;
                transition: width 1.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            }
            html.js .methodology .in .bar i {
                width: var(--w);
            }
        }
        .methodology .bar {
            height: 6px;
            background: rgba(140, 190, 210, 0.1);
            border-radius: 3px;
            margin-top: 5px;
            overflow: hidden;
        }
        .methodology .bar i {
            display: block;
            height: 100%;
            width: var(--w);
            border-radius: 3px;
        }
        .methodology .bar.g i {
            background: linear-gradient(90deg, var(--grn), var(--cyn));
        }
        .methodology .bar.a i {
            background: linear-gradient(90deg, var(--amb), var(--red));
        }

        .methodology .card {
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--panel);
            padding: 26px 28px;
        }

        /* ==== 09 SDLC toggle ==== */
        .methodology .seg {
            display: inline-flex;
            border: 1px solid var(--line2);
            border-radius: 7px;
            overflow: hidden;
            margin-bottom: 30px;
        }
        .methodology .seg button {
            font-family: var(--mono);
            font-size: 12.5px;
            background: none;
            border: none;
            color: var(--dim);
            padding: 11px 26px;
            letter-spacing: 0.05em;
            transition: 0.25s;
        }
        .methodology .seg button.on {
            background: var(--grn);
            color: #04140c;
            font-weight: 700;
        }
        .methodology .sdlc-view {
            display: none;
        }
        .methodology .sdlc-view.on {
            display: block;
            animation: mth-vin 0.5s ease;
        }
        @keyframes mth-vin {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
            }
        }
        .methodology .wf-step {
            display: grid;
            grid-template-columns: 150px 1fr 90px;
            align-items: center;
            gap: 14px;
            margin-bottom: 10px;
        }
        .methodology .wf-step .lbl {
            font-family: var(--mono);
            font-size: 12px;
            color: var(--mut);
            text-align: right;
        }
        .methodology .wf-step .bf {
            height: 40px;
            border-radius: 5px;
            background: linear-gradient(90deg, #155e75, var(--cyn));
            opacity: 0.85;
            transition: 0.4s;
        }
        .methodology .wf-step:nth-child(2) .bf {
            width: 86%;
        }
        .methodology .wf-step:nth-child(3) .bf {
            width: 72%;
        }
        .methodology .wf-step:nth-child(4) .bf {
            width: 58%;
        }
        .methodology .wf-step:nth-child(5) .bf {
            width: 44%;
        }
        .methodology .wf-step .mon {
            font-family: var(--mono);
            font-size: 11px;
            color: var(--dim);
        }
        .methodology .wf-step.bad .bf {
            background: linear-gradient(90deg, #7f1d1d, var(--red));
            animation: mth-crack 0.5s ease;
        }
        .methodology .wf-step.bad .lbl {
            color: var(--red);
        }
        @keyframes mth-crack {
            0%,
            100% {
                transform: translateX(0);
            }
            25% {
                transform: translateX(-5px);
            }
            60% {
                transform: translateX(4px);
            }
        }
        .methodology .crack-note {
            font-family: var(--mono);
            font-size: 12px;
            color: var(--red);
            border: 1px dashed rgba(255, 92, 87, 0.5);
            border-radius: 6px;
            padding: 9px 15px;
            display: inline-block;
            margin-top: 10px;
            opacity: 0;
            transition: opacity 0.5s;
        }
        .methodology .crack-note.show {
            opacity: 1;
        }
        .methodology .sprints {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
        }
        .methodology .sprint {
            border: 1px solid rgba(52, 211, 153, 0.3);
            border-radius: 7px;
            background: rgba(52, 211, 153, 0.05);
            padding: 12px 10px;
            text-align: center;
            transition: 0.25s;
        }
        .methodology .sprint:hover {
            transform: translateY(-3px);
            border-color: var(--grn);
        }
        .methodology .sprint b {
            font-family: var(--disp);
            font-size: 1.05rem;
            color: var(--txt);
            display: block;
        }
        .methodology .sprint small {
            font-family: var(--mono);
            font-size: 9.5px;
            color: var(--grn);
        }
        .methodology .sprint.now {
            border-color: var(--grn);
            box-shadow: 0 0 18px rgba(52, 211, 153, 0.25);
        }
        .methodology .sprint.now small {
            animation: mth-blink 1.4s steps(1) infinite;
        }
        .methodology .sdlc-note {
            margin-top: 26px;
            border-left: 3px solid var(--grn);
            padding: 14px 20px;
            background: rgba(52, 211, 153, 0.05);
            color: var(--mut);
            font-size: 0.95rem;
            border-radius: 0 8px 8px 0;
        }
        .methodology .sdlc-note b {
            color: var(--grn);
        }

        /* ==== 10 DevOps CALMS ==== */
        .methodology .calms-row {
            display: flex;
            gap: 10px;
            margin-bottom: 26px;
            flex-wrap: wrap;
        }
        .methodology .calms-row button {
            font-family: var(--disp);
            font-weight: 700;
            font-size: 2.2rem;
            width: 76px;
            height: 76px;
            border-radius: 10px;
            border: 1px solid var(--line2);
            background: var(--panel);
            color: var(--dim);
            transition: 0.25s;
        }
        .methodology .calms-row button:hover {
            color: var(--txt);
            border-color: var(--grn);
        }
        .methodology .calms-row button.on {
            background: var(--grn-dk);
            border-color: var(--grn);
            color: var(--grn);
            box-shadow: 0 0 24px rgba(52, 211, 153, 0.25);
        }
        .methodology .calms-panel {
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--panel2);
            padding: 32px;
            min-height: 220px;
        }
        .methodology .calms-panel h3 {
            font-family: var(--disp);
            font-size: 1.5rem;
        }
        .methodology .calms-panel h3 span {
            color: var(--grn);
        }
        .methodology .calms-panel .def {
            color: var(--txt);
            margin-top: 10px;
            font-size: 1.02rem;
        }
        .methodology .calms-panel .prac {
            margin-top: 16px;
            color: var(--mut);
            font-size: 0.93rem;
        }
        .methodology .calms-panel .prac b {
            color: var(--amb);
            font-family: var(--mono);
            font-size: 11px;
            letter-spacing: 0.12em;
            font-weight: 500;
        }
        .methodology .calms-panel .evi {
            margin-top: 14px;
            font-family: var(--mono);
            font-size: 11.5px;
            color: var(--dim);
        }
        .methodology .calms-panel .evi b {
            color: var(--grn);
            font-weight: 500;
        }
        .methodology .ways {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 16px;
            margin-top: 26px;
        }
        .methodology .way {
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--panel);
            padding: 20px 22px;
            position: relative;
            transition: 0.25s;
        }
        .methodology .way:hover {
            border-color: var(--line2);
            transform: translateY(-4px);
        }
        .methodology .way .n {
            font-family: var(--mono);
            font-size: 10.5px;
            color: var(--amb);
            letter-spacing: 0.15em;
        }
        .methodology .way b {
            display: block;
            font-size: 1.05rem;
            margin-top: 6px;
        }
        .methodology .way p {
            font-size: 0.85rem;
            color: var(--mut);
            margin-top: 6px;
        }
        .methodology .way::after {
            content: "→";
            position: absolute;
            right: -14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--grn);
            font-size: 1.2rem;
            z-index: 2;
        }
        .methodology .way:last-child::after {
            display: none;
        }
        .methodology .wall {
            margin-top: 26px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 18px;
            align-items: center;
        }
        .methodology .wall-box {
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 24px;
            text-align: center;
            background: var(--panel);
        }
        .methodology .wall-box b {
            font-family: var(--disp);
            font-size: 1.3rem;
            display: block;
        }
        .methodology .wall-box small {
            color: var(--mut);
            font-size: 0.82rem;
        }
        .methodology .wall-box.dev b {
            color: var(--cyn);
        }
        .methodology .wall-box.ops b {
            color: var(--amb);
        }
        .methodology .wall-box.merged {
            background: linear-gradient(
                135deg,
                rgba(76, 194, 255, 0.12),
                rgba(52, 211, 153, 0.12)
            );
            border-color: var(--grn);
        }
        .methodology .wall-box.merged b {
            color: var(--grn);
        }
        .methodology .wall-vs {
            font-family: var(--mono);
            font-size: 11px;
            color: var(--dim);
            text-align: center;
        }
        .methodology .wall-vs .x {
            color: var(--red);
            font-size: 1.4rem;
            display: block;
        }
        .methodology .wall-vs .ok {
            color: var(--grn);
            font-size: 1.4rem;
            display: block;
        }

        /* ==== 11 Agile values ==== */
        .methodology .values {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .methodology .val {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 18px;
            align-items: center;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--panel);
            padding: 20px 24px;
            transition: 0.25s;
        }
        .methodology .val:hover {
            border-color: rgba(52, 211, 153, 0.45);
            transform: translateX(4px);
        }
        .methodology .val .l {
            font-size: 1.02rem;
            font-weight: 600;
            color: var(--txt);
        }
        .methodology .val .l::before {
            content: "✓ ";
            color: var(--grn);
        }
        .methodology .val .over {
            font-family: var(--mono);
            font-size: 10.5px;
            color: var(--dim);
            letter-spacing: 0.1em;
        }
        .methodology .val .r {
            font-size: 0.92rem;
            color: var(--dim);
            text-decoration: line-through;
            text-decoration-color: rgba(255, 92, 87, 0.5);
            text-align: right;
        }
        .methodology .val-note {
            margin-top: 18px;
            font-size: 0.9rem;
            color: var(--mut);
            border: 1px dashed var(--line2);
            border-radius: 8px;
            padding: 14px 20px;
        }
        .methodology .val-note b {
            color: var(--amb);
        }
        .methodology .principles {
            margin-top: 34px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }
        .methodology .pr {
            border: 1px solid var(--line);
            border-left: 3px solid var(--grn);
            border-radius: 8px;
            background: var(--panel);
            padding: 20px 22px;
        }
        .methodology .pr .n {
            font-family: var(--mono);
            font-size: 10.5px;
            color: var(--grn);
            letter-spacing: 0.12em;
        }
        .methodology .pr p {
            font-size: 0.87rem;
            color: var(--txt);
            margin-top: 8px;
        }
        .methodology .pr small {
            color: var(--mut);
            font-size: 0.8rem;
            display: block;
            margin-top: 8px;
        }

        /* ==== 12 Scrum ==== */
        .methodology .scrum-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 34px;
            align-items: start;
        }
        .methodology .goal-tag {
            font-family: var(--mono);
            font-size: 12px;
            color: var(--amb);
            border: 1px solid rgba(251, 191, 36, 0.35);
            border-radius: 6px;
            padding: 8px 16px;
            display: inline-block;
            margin-bottom: 20px;
        }
        .methodology .cal {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 9px;
        }
        .methodology .day {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--panel);
            padding: 12px 10px;
            text-align: center;
            transition: 0.22s;
            position: relative;
        }
        .methodology .day:hover {
            border-color: var(--line2);
            transform: translateY(-2px);
        }
        .methodology .day.on {
            border-color: var(--grn);
            background: var(--grn-dk);
            box-shadow: 0 0 16px rgba(52, 211, 153, 0.2);
        }
        .methodology .day b {
            font-family: var(--mono);
            font-size: 12px;
            color: var(--txt);
            display: block;
        }
        .methodology .day small {
            font-size: 9.5px;
            color: var(--dim);
            font-family: var(--mono);
        }
        .methodology .day .ev {
            display: inline-block;
            font-size: 9px;
            font-family: var(--mono);
            margin-top: 6px;
            padding: 2px 7px;
            border-radius: 3px;
            letter-spacing: 0.04em;
        }
        .methodology .day .ev.p {
            background: rgba(251, 191, 36, 0.14);
            color: var(--amb);
        }
        .methodology .day .ev.r {
            background: rgba(52, 211, 153, 0.14);
            color: var(--grn);
        }
        .methodology .day .ev.d {
            background: rgba(76, 194, 255, 0.12);
            color: var(--cyn);
        }
        .methodology .day-info {
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--panel2);
            padding: 26px;
            position: sticky;
            top: 86px;
            min-height: 300px;
        }
        .methodology .day-info .tag {
            font-family: var(--mono);
            font-size: 10.5px;
            color: var(--amb);
            letter-spacing: 0.14em;
        }
        .methodology .day-info h3 {
            font-family: var(--disp);
            font-size: 1.3rem;
            margin-top: 8px;
        }
        .methodology .day-info .tb {
            font-family: var(--mono);
            font-size: 11.5px;
            color: var(--cyn);
            margin-top: 4px;
        }
        .methodology .day-info p {
            color: var(--mut);
            font-size: 0.9rem;
            margin-top: 14px;
        }
        .methodology .day-info .me {
            margin-top: 16px;
            border-top: 1px dashed var(--line2);
            padding-top: 14px;
            font-size: 0.87rem;
            color: var(--txt);
        }
        .methodology .day-info .me b {
            color: var(--grn);
            font-family: var(--mono);
            font-size: 10.5px;
            letter-spacing: 0.1em;
            font-weight: 500;
            display: block;
            margin-bottom: 4px;
        }
        .methodology .artifacts {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
            margin-top: 26px;
            align-items: center;
        }
        .methodology .art {
            border: 1px solid var(--line);
            border-radius: 9px;
            background: var(--panel);
            padding: 16px 18px;
            transition: 0.25s;
        }
        .methodology .art:hover {
            border-color: var(--grn);
            transform: translateY(-3px);
        }
        .methodology .art b {
            font-size: 0.92rem;
            display: block;
        }
        .methodology .art small {
            font-family: var(--mono);
            font-size: 10px;
            color: var(--dim);
        }
        .methodology .art-arrow {
            color: var(--grn);
            text-align: center;
            font-size: 1.1rem;
        }
        .methodology .sc-val-chips {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
            margin-top: 26px;
        }
        .methodology .sc-val-chips span {
            font-family: var(--mono);
            font-size: 11px;
            border: 1px solid var(--line2);
            padding: 5px 13px;
            border-radius: 20px;
            color: var(--mut);
        }
        .methodology .honest {
            margin-top: 26px;
            border: 1px solid rgba(251, 191, 36, 0.3);
            background:
                linear-gradient(
                    180deg,
                    rgba(251, 191, 36, 0.05),
                    transparent 60%
                ),
                var(--panel);
            border-radius: 10px;
            padding: 22px 26px;
            color: var(--mut);
            font-size: 0.93rem;
        }
        .methodology .honest b {
            color: var(--amb);
        }

        /* ==== 13 DX ==== */
        .methodology .dx-phases {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
            position: relative;
            margin-bottom: 40px;
        }
        .methodology .dx-phases::before {
            content: "";
            position: absolute;
            top: 8px;
            left: 6%;
            right: 6%;
            height: 1px;
            background: var(--line2);
        }
        .methodology .dxp {
            padding: 0 16px;
            position: relative;
        }
        .methodology .dxp::before {
            content: "";
            position: absolute;
            top: 2px;
            left: 16px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: var(--bg);
            border: 2px solid var(--grn);
        }
        .methodology .dxp time {
            font-family: var(--mono);
            font-size: 10.5px;
            color: var(--amb);
            letter-spacing: 0.06em;
        }
        .methodology .dxp b {
            display: block;
            margin-top: 6px;
        }
        .methodology .dxp p {
            font-size: 0.82rem;
            color: var(--mut);
            margin-top: 4px;
        }
        .methodology .ba-row {
            display: grid;
            grid-template-columns: 1.1fr 1fr 1fr;
            gap: 20px;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid var(--line);
        }
        .methodology .ba-row:last-child {
            border-bottom: 0;
        }
        .methodology .ba-row .m b {
            display: block;
            font-size: 0.95rem;
        }
        .methodology .ba-row .m small {
            color: var(--dim);
            font-family: var(--mono);
            font-size: 10.5px;
        }
        .methodology .ba-col {
            font-size: 0.85rem;
        }
        .methodology .ba-col .cap {
            font-family: var(--mono);
            font-size: 10px;
            letter-spacing: 0.1em;
            display: flex;
            justify-content: space-between;
            color: var(--dim);
            margin-bottom: 2px;
        }
        .methodology .ba-col.before .cap b {
            color: var(--amb);
        }
        .methodology .ba-col.after .cap b {
            color: var(--grn);
        }
        .methodology .dx-quote {
            margin-top: 34px;
            font-family: var(--body);
            font-size: 1.15rem;
            color: var(--txt);
            border-left: 3px solid var(--grn);
            padding: 6px 24px;
            max-width: 70ch;
        }
        .methodology .dx-quote small {
            display: block;
            margin-top: 10px;
            font-family: var(--mono);
            font-size: 11px;
            color: var(--dim);
        }

        /* manifesto */
        .methodology .manifesto {
            display: flex;
