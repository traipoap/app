---
import Layout from "../layouts/Layout.astro";
import "../styles/main.css";
---

<Layout title="Dashboard — LUMINA">
    <!-- Client-side route protection: runs in the browser -->
    <script>
        (function protectRoute() {
            if (typeof window === "undefined") return;

            // Check both storages (signin sets localStorage, other code may use sessionStorage)
            const token =
                window.sessionStorage.getItem("authToken") ||
                window.localStorage.getItem("authToken");

            if (!token) {
                // small delay to avoid interfering with initial rendering
                setTimeout(function () {
                    window.location.href = "/signin";
                }, 100);
            }
        })();
    </script>
    <main class="main-content dash-main">
        <!-- Header + Controls -->
        <header class="dash-header">
            <div class="dash-title">
                <h1>Dashboard</h1>
                <p>
                    Cluster log overview — totals &amp; time series come from
                    live Quickwit count queries; level/source breakdowns are
                    sampled from the latest 500 logs in range.
                </p>
            </div>
            <div class="dash-controls">
                <select class="filter-select" id="dashIndex" aria-label="Index">
                    <option value="">Loading...</option>
                </select>
                <div class="fb-chips" role="group" aria-label="Time range">
                    <button
                        class="level-btn"
                        data-range="1h"
                        type="button"
                        onclick="setDashRange('1h', this)"
                    >
                        1h
                    </button>
                    <button
                        class="level-btn active"
                        data-range="24h"
                        type="button"
                        onclick="setDashRange('24h', this)"
                    >
                        24h
                    </button>
                    <button
                        class="level-btn"
                        data-range="7d"
                        type="button"
                        onclick="setDashRange('7d', this)"
                    >
                        7d
                    </button>
                    <button
                        class="level-btn"
                        data-range="30d"
                        type="button"
                        onclick="setDashRange('30d', this)"
                    >
                        30d
                    </button>
                </div>
                <button
                    class="tb-btn"
                    type="button"
                    id="dashRefresh"
                    onclick="loadDashStats()"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M23 4v6h-6"></path>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                    </svg>
                    <span class="tb-label">Refresh</span>
                </button>
            </div>
        </header>

        <!-- Stat Cards -->
        <section class="dashboard-grid" aria-label="Key metrics">
            <div class="dashboard-card">
                <h4>Total Logs</h4>
                <div class="value" id="dashTotal">
                    –
                </div>
                <div class="value-sub" id="dashTotalSub">
                    exact count · last 24h
                </div>
            </div>
            <div class="dashboard-card">
                <h4>Errors</h4>
                <div
                    class="value"
                    id="dashErrors"
                    style="color: var(--danger);"
                >
                    –
                </div>
                <div class="value-sub">error + critical · sampled</div>
            </div>
            <div class="dashboard-card">
                <h4>Warnings</h4>
                <div
                    class="value"
                    id="dashWarns"
                    style="color: var(--warning);"
                >
                    –
                </div>
                <div class="value-sub">warn · sampled</div>
            </div>
            <div class="dashboard-card">
                <h4>Error Rate</h4>
                <div
                    class="value"
                    id="dashErrorRate"
                    style="color: var(--danger);"
                >
                    –
                </div>
                <div class="value-sub">of sampled logs</div>
            </div>
            <div class="dashboard-card">
                <h4>Active Sources</h4>
                <div
                    class="value"
                    id="dashSources"
                    style="color: var(--accent-2);"
                >
                    –
                </div>
                <div class="value-sub">unique sources · sampled</div>
            </div>
            <div class="dashboard-card">
                <h4>Peak Period</h4>
                <div class="value" id="dashPeak">
                    –
                </div>
                <div class="value-sub">busiest bucket · exact</div>
            </div>
        </section>

        <!-- Charts -->
        <section class="dashboard-chart-container">
            <div class="chart-card">
                <h4>
                    Logs Over Time{" "}
                    <span class="chart-sub">
                        (24 buckets · exact count queries)
                    </span>
                </h4>
                <div class="bar-chart" id="timeChart">
                    <div class="chart-loading">Loading…</div>
                </div>
            </div>
            <div class="chart-card">
                <h4>
                    Log Distribution{" "}
                    <span class="chart-sub">(latest 500 logs)</span>
                </h4>
                <div class="legend" id="levelLegend">
                    <div class="chart-loading">Loading…</div>
                </div>
            </div>
        </section>

        <!-- Top Sources -->
        <section class="top-sources">
            <h4>
                Top Log Sources{" "}
                <span class="chart-sub">(latest 500 logs in range)</span>
            </h4>
            <div id="topSourcesList">
                <div class="chart-loading">Loading…</div>
            </div>
        </section>
    </main>

    <!-- Toast -->
    <div class="toast" id="toast">
        <span class="toast-icon">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <circle cx="12" cy="12" r="10" />
                <path d="M8 12l3 3 5-6" />
            </svg>
        </span>
        <span class="toast-message" id="toastMessage">
            Action completed
        </span>
    </div>

    <script src="../scripts/dashboard-stats.js"></script>
    <style>
        .dash-main {
            gap: 1.125rem;
        }

        .dash-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .dash-title h1 {
            font-size: 1.375rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            margin-bottom: 0.25rem;
        }

        .dash-title p {
            font-size: 0.8125rem;
            color: var(--muted);
            max-width: 60ch;
        }

        .dash-controls {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            flex-wrap: wrap;
        }

        .value-sub {
            margin-top: 0.375rem;
            font-family: var(--mono);
            font-size: 0.625rem;
            color: var(--faint);
        }

        .chart-sub {
            font-weight: 500;
            text-transform: none;
            letter-spacing: 0;
            color: var(--faint);
            opacity: 0.8;
        }

        .chart-loading {
            padding: 1.5rem 0;
            text-align: center;
            font-family: var(--mono);
            font-size: 0.75rem;
            color: var(--faint);
        }

        @media (max-width: 900px) {
            .dash-header {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</Layout>
