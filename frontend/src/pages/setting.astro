---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Setting — LUMINA"
    description="Manage your LUMINA account preferences and session."
>
    <div class="settings-page">
        <header class="page-head">
            <div>
                <p class="page-eyebrow">LUMINA · Workspace</p>
                <h1 class="page-title">Settings</h1>
            </div>
            <a href="/dashboard" class="back-dash">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M19 12H5"></path>
                    <path d="M12 19l-7-7 7-7"></path>
                </svg>
                Back to Dashboard
            </a>
        </header>

        <div class="settings-grid">
            <!-- Profile -->
            <section class="card">
                <div class="card-head">
                    <h2>Profile</h2>
                    <p>Basic account information.</p>
                </div>
                <div class="field">
                    <label for="fullName">Full name</label>
                    <input id="fullName" type="text" value="" readonly />
                </div>
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" type="email" value="" readonly />
                </div>
                <div class="field">
                    <span class="field-label" id="roleLabel">
                        Role
                    </span>
                    <span
                        class="role-badge"
                        id="roleBadge"
                        aria-labelledby="roleLabel"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span id="roleText">…</span>
                    </span>
                </div>
            </section>

            <!-- Preferences -->
            <section class="card">
                <div class="card-head">
                    <h2>Preferences</h2>
                    <p>Defaults applied to every search.</p>
                </div>
                <div class="field">
                    <label for="defaultIndex">Default index</label>
                    <select id="defaultIndex">
                        <option value="syslogs">syslogs</option>
                        <option value="otel-logs-v7">otel-logs-v7</option>
                        <option value="otel-traces-v7">otel-traces-v7</option>
                    </select>
                </div>
                <div class="field">
                    <label for="defaultRange">Default time range</label>
                    <select id="defaultRange">
                        <option>Last 1 hour</option>
                        <option selected>Last 24 hours</option>
                        <option>Last 7 days</option>
                        <option>Last 30 days</option>
                    </select>
                </div>
                <div class="field">
                    <span class="field-label">Theme</span>
                    <div class="seg" role="group" aria-label="Theme">
                        <span class="seg-item active">Dark</span>
                        <span class="seg-item dim">Light</span>
                    </div>
                </div>
            </section>

            <!-- Users (admin only) -->
            <section class="card card-wide" id="usersCard" hidden>
                <div class="card-head">
                    <h2>Users</h2>
                    <p>Registered accounts — assign roles or remove access.</p>
                </div>
                <p
                    class="users-status"
                    id="usersStatus"
                    role="status"
                    aria-live="polite"
                >
                    Loading users…
                </p>
                <div class="user-list" id="userList"></div>
                <p class="user-empty" id="userEmpty" hidden>
                    No registered accounts.
                </p>
            </section>

            <!-- Session -->
            <section class="card card-wide">
                <div class="card-head">
                    <h2>Session</h2>
                    <p>Sign out of LUMINA on this device.</p>
                </div>
                <div class="card-foot">
                    <p class="session-note">
                        Connected as
                        <span class="mono" id="sessionEmail">
                            …
                        </span>
                    </p>
                    <button class="btn-signout" type="button" id="signoutBtn">
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        Sign out
                    </button>
                </div>
            </section>
        </div>
    </div>

    <script>
        document.getElementById("signoutBtn")?.addEventListener("click", () => {
            signout();
        });

        // ── Users management (admin only) ──────────────────────────────────
        const API_BASE = "";

        function getToken() {
            return storageGet("authToken");
        }

        function getRefreshToken() {
            return storageGet("refreshToken");
        }

        /** Write to both backends (and drop the stale copy) so reads stay consistent. */
        function saveToken(key: string, value: string) {
            storageRemove(key);
            window.localStorage.setItem(key, value);
            window.sessionStorage.setItem(key, value);
        }

        function storageGet(key: string) {
            return (
                window.sessionStorage.getItem(key) ||
                window.localStorage.getItem(key)
            );
        }

        function storageRemove(key: string) {
            window.localStorage.removeItem(key);
            window.sessionStorage.removeItem(key);
        }

        function clearTokens() {
            storageRemove("authToken");
            storageRemove("refreshToken");
        }

        function signout() {
            clearTokens();
            window.location.href = "/signin";
        }

        // Coalesce concurrent 401s into a single refresh — the refresh token
        // is rotated (single-use), so a second parallel call would fail.
        let refreshInFlight: Promise<boolean> | null = null;

        async function tryRefreshToken() {
            if (refreshInFlight) return refreshInFlight;
            refreshInFlight = (async () => {
                const refreshToken = getRefreshToken();
                if (!refreshToken) return false;
                try {
                    const res = await fetch(`${API_BASE}/api/auth/refresh`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ refresh_token: refreshToken }),
                    });
                    if (!res.ok) {
                        clearTokens();
                        signout();
                        return false;
                    }
                    const data = await res.json();
                    if (!data.token) return false;
                    saveToken("authToken", data.token);
                    if (data.refresh_token)
                        saveToken("refreshToken", data.refresh_token);
                    return true;
                } catch {
                    return false;
                } finally {
                    refreshInFlight = null;
                }
            })();
            return refreshInFlight;
        }

        /**
         * fetch wrapper that injects the Bearer token and, on a 401,
         * refreshes once before retrying the request.
         */
        async function authenticatedFetch(
            url: string,
            options: RequestInit & { headers?: Record<string, string> } = {},
        ) {
            const doFetch = () =>
                fetch(url, {
                    ...options,
                    headers: {
                        ...(options.headers || {}),
                        Authorization: `Bearer ${getToken()}`,
                    },
                });

            const res = await doFetch();
            if (res.status === 401 && (await tryRefreshToken())) {
                return doFetch();
            }
            return res;
        }

        function decodeTokenPayload(token: string) {
            try {
                const b64 = token
                    .split(".")[1]
                    .replace(/-/g, "+")
                    .replace(/_/g, "/");
                const padded = b64.padEnd(
                    b64.length + ((4 - (b64.length % 4)) % 4),
                    "=",
                );
                return JSON.parse(atob(padded));
            } catch {
                return null;
            }
        }

        // Current session identity from the JWT claims (user_id/username/role).
        const ME = (() => {
            const payload = decodeTokenPayload(getToken() || "");
            if (!payload) return null;
            return {
                id: Number(payload.user_id),
                username: payload.username,
                email: payload.email,
                role: payload.role,
            };
        })();

        // Populate the static profile card from the session — the markup no
        // longer carries hardcoded identities.
        (() => {
            const set = (id: string, value: string | undefined) => {
                const el = document.getElementById(id);
                if (el && value) el.textContent = value;
            };
            const setInput = (id: string, value: string | undefined) => {
                const el = document.getElementById(
                    id,
                ) as HTMLInputElement | null;
                if (el && value) el.value = value;
            };
            setInput("fullName", ME?.username);
            setInput("email", ME?.email);
            set("sessionEmail", ME?.email || ME?.username);
            set("roleText", ME?.role === "admin" ? "Administrator" : "User");
        })();

        const usersCard = document.getElementById("usersCard");
        const userList = document.getElementById("userList");
        const usersStatus = document.getElementById("usersStatus");
        const userEmpty = document.getElementById("userEmpty");

        interface User {
            id: number;
            username: string;
            role: string;
        }

        let users: User[] = [];

        function escapeHtml(value: string) {
            const div = document.createElement("div");
            div.textContent = value;
            return div.innerHTML;
        }

        function setStatus(message: string, kind?: "" | "error" | "ok") {
            if (!usersStatus) return;
            usersStatus.textContent = message;
            usersStatus.className = "users-status" + (kind ? ` ${kind}` : "");
        }

        async function serverError(res: Response) {
            try {
                return (await res.json()).error || `Server error ${res.status}`;
            } catch {
                return `Server error ${res.status}`;
            }
        }

        function renderUsers() {
            if (!userList) return;
            const adminCount = users.filter((u) => u.role === "admin").length;
            userList.innerHTML = users
                .map((u) => {
                    const self = ME && ME.id === u.id;
                    const isLastAdmin = u.role === "admin" && adminCount <= 1;
                    const canManage = !self;
                    const roleDisabled =
                        !canManage || (u.role === "admin" && isLastAdmin);
                    const roleTitle = self
                        ? "You"
                        : u.role === "admin" && isLastAdmin
                          ? "Last admin"
                          : "";
                    return `
                    <div class="user-row" data-id="${u.id}">
                        <div class="user-id">
                            <span class="user-name">${escapeHtml(u.username)}</span>
                            ${self ? '<span class="user-self">you</span>' : ""}
                        </div>
                        <div class="user-actions">
                            <span class="role-badge ${u.role === "admin" ? "admin" : "user"}">${u.role}</span>
                            <button class="btn-mini" data-action="role" ${roleDisabled ? "disabled" : ""} title="${roleTitle}">
                                ${u.role === "admin" ? "Make user" : "Make admin"}
                            </button>
                            <button class="btn-mini danger" data-action="delete" ${!canManage ? "disabled" : ""} title="${self ? "You" : ""}">
                                Delete
                            </button>
                        </div>
                    </div>`;
                })
                .join("");
            if (userEmpty) userEmpty.hidden = users.length > 0;
        }

        async function loadUsers() {
            try {
                const res = await authenticatedFetch(`${API_BASE}/api/users`);
                if (res.status === 401 || res.status === 403) {
                    if (usersCard) usersCard.hidden = true;
                    return;
                }
                if (!res.ok) throw new Error(await serverError(res));
                users = await res.json();
                renderUsers();
                setStatus(
                    `${users.length} registered account${users.length === 1 ? "" : "s"}`,
                );
            } catch (err) {
                console.error("Failed to load users:", err);
                setStatus("Failed to load users.", "error");
            }
        }

        userList?.addEventListener("click", async (event) => {
            const btn =
                event.target instanceof Element
                    ? (event.target.closest(
                          "button[data-action]",
                      ) as HTMLButtonElement)
                    : null;
            if (!btn || btn.disabled) return;
            const id = Number(
                (btn.closest(".user-row") as HTMLElement | null)?.dataset.id,
            );
            const user = users.find((u) => u.id === id);
            if (!user) return;

            if (btn.dataset.action === "delete") {
                const ok = confirm(
                    `Delete account "${user.username}"? This cannot be undone.`,
                );
                if (!ok) return;
            }

            btn.disabled = true;
            try {
                let res;
                if (btn.dataset.action === "delete") {
                    res = await authenticatedFetch(
                        `${API_BASE}/api/users/${id}`,
                        { method: "DELETE" },
                    );
                } else {
                    const newRole = user.role === "admin" ? "user" : "admin";
                    res = await authenticatedFetch(
                        `${API_BASE}/api/users/${id}/role`,
                        {
                            method: "PATCH",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ role: newRole }),
                        },
                    );
                }
                if (!res.ok) throw new Error(await serverError(res));

                if (btn.dataset.action === "delete") {
                    users = users.filter((u) => u.id !== id);
                    setStatus("Account deleted.", "ok");
                } else {
                    const updated = await res.json();
                    if (updated?.role) user.role = updated.role;
                    setStatus(`${user.username} is now ${user.role}.`, "ok");
                }
                renderUsers();
            } catch (err) {
                console.error("User action failed:", err);
                setStatus(
                    err instanceof Error ? err.message : String(err),
                    "error",
                );
                renderUsers();
            }
        });

        // Only admins see the section — gate on the JWT role claim so
        // non-admins neither see the card nor fire the request.
        if (ME && ME.role === "admin") {
            if (usersCard) usersCard.hidden = false;
            loadUsers();
        }
    </script>
    <style>
        .settings-page {
            width: 100%;
            max-width: 980px;
            margin: 0 auto;
            padding: 2.5rem 1.25rem 4rem;
        }

        .page-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .page-eyebrow {
            font-family: var(--mono);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--faint);
            margin-bottom: 0.5rem;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            color: var(--text);
        }

        .back-dash {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.9375rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: rgba(148, 163, 184, 0.04);
            color: var(--muted);
            text-decoration: none;
            font-size: 0.8125rem;
            font-weight: 500;
            transition:
                color 0.15s ease,
                border-color 0.15s ease,
                background 0.15s ease;
        }

        .back-dash svg {
            width: 15px;
            height: 15px;
        }

        .back-dash:hover {
            color: var(--text);
            border-color: var(--border-strong);
            background: rgba(148, 163, 184, 0.08);
        }

        .settings-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .card {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding: 1.5rem;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .card-wide {
            grid-column: 1 / -1;
        }

        .card-head h2 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text);
        }

        .card-head p {
            margin-top: 0.25rem;
            font-size: 0.8125rem;
            color: var(--muted);
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .field label,
        .field-label {
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--muted);
        }

        .field input,
        .field select {
            width: 100%;
            padding: 0.625rem 0.8125rem;
            background: var(--bg-elev);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            font-size: 0.875rem;
            transition:
                border-color 0.15s ease,
                box-shadow 0.15s ease;
        }

        .field input[readonly] {
            color: var(--muted);
        }

        .field input:focus,
        .field select:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.18);
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            align-self: flex-start;
            padding: 0.4375rem 0.8125rem;
            border: 1px solid rgba(129, 140, 248, 0.28);
            border-radius: 100px;
            background: rgba(129, 140, 248, 0.1);
            color: #c7d2fe;
            font-size: 0.8125rem;
            font-weight: 600;
        }

        .role-badge svg {
            width: 15px;
            height: 15px;
        }

        .seg {
            display: inline-flex;
            align-self: flex-start;
            padding: 0.25rem;
            gap: 0.25rem;
            background: var(--bg-elev);
            border: 1px solid var(--border);
            border-radius: 8px;
        }

        .seg-item {
            padding: 0.375rem 0.875rem;
            border-radius: 6px;
            font-size: 0.8125rem;
            font-weight: 500;
            color: var(--faint);
        }

        .seg-item.active {
            background: rgba(129, 140, 248, 0.14);
            color: #c7d2fe;
        }

        .card-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            padding-top: 0.5rem;
            border-top: 1px solid var(--border);
        }

        .session-note {
            font-size: 0.8125rem;
            color: var(--muted);
        }

        .session-note .mono {
            font-family: var(--mono);
            font-size: 0.75rem;
            color: var(--text);
        }

        .btn-signout {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5625rem 1rem;
            background: rgba(248, 113, 113, 0.08);
            border: 1px solid rgba(248, 113, 113, 0.3);
            border-radius: 8px;
            color: var(--danger);
            font-size: 0.8125rem;
            font-weight: 600;
            cursor: pointer;
            transition:
                background 0.15s ease,
                border-color 0.15s ease;
        }

        .btn-signout svg {
            width: 15px;
            height: 15px;
        }

        .btn-signout:hover {
            background: rgba(248, 113, 113, 0.14);
            border-color: rgba(248, 113, 113, 0.45);
        }

        /* ── Users ── */
        .users-status {
            font-size: 0.8125rem;
            color: var(--muted);
            min-height: 1.1em;
        }

        .user-empty {
            margin: 0;
            padding: 1.25rem;
            text-align: center;
            font-size: 0.8125rem;
            color: var(--faint);
            border: 1px dashed var(--border);
            border-radius: 8px;
        }

        .users-status.error {
            color: var(--danger);
        }

        .users-status.ok {
            color: var(--success);
        }

        .user-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .user-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            flex-wrap: wrap;
            padding: 0.75rem 0.875rem;
            background: var(--bg-elev);
            border: 1px solid var(--border);
            border-radius: 10px;
        }

        .user-id {
            display: flex;
            align-items: baseline;
            gap: 0.5rem;
            min-width: 0;
        }

        .user-name {
            font-family: var(--mono);
            font-size: 0.875rem;
            color: var(--text);
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-self {
            font-size: 0.625rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--faint);
        }

        .user-actions {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .user-actions .role-badge {
            padding: 0.3125rem 0.6875rem;
            font-size: 0.75rem;
        }

        .role-badge.user {
            border-color: var(--border-strong);
            background: rgba(148, 163, 184, 0.06);
            color: var(--muted);
        }

        .btn-mini {
            padding: 0.375rem 0.75rem;
            border: 1px solid var(--border-strong);
            border-radius: 7px;
            background: rgba(148, 163, 184, 0.05);
            color: var(--muted);
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition:
                color 0.15s ease,
                border-color 0.15s ease,
                background 0.15s ease;
        }

        .btn-mini:hover:not(:disabled) {
            color: var(--text);
            border-color: var(--accent);
            background: rgba(129, 140, 248, 0.1);
        }

        .btn-mini.danger {
            color: var(--danger);
            border-color: rgba(248, 113, 113, 0.3);
            background: rgba(248, 113, 113, 0.06);
        }

        .btn-mini.danger:hover:not(:disabled) {
            border-color: rgba(248, 113, 113, 0.5);
            background: rgba(248, 113, 113, 0.12);
        }

        .btn-mini:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        @media (max-width: 767px) {
            .settings-page {
                padding: 1.75rem 1rem 3rem;
            }

            .page-head {
                flex-direction: column;
                align-items: flex-start;
            }

            .settings-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
