---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Setting — LUMINA"
    description="Manage your LUMINA account preferences and session."
>
    <div class="settings-page">
        <header class="page-head">
            <div>
                <p class="page-eyebrow">LUMINA · Workspace</p>
                <h1 class="page-title">Settings</h1>
            </div>
            <a href="/dashboard" class="back-dash">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M19 12H5"></path>
                    <path d="M12 19l-7-7 7-7"></path>
                </svg>
                Back to Dashboard
            </a>
        </header>

        <div class="settings-grid">
            <!-- Profile -->
            <section class="card">
                <div class="card-head">
                    <h2>Profile</h2>
                    <p>Basic account information.</p>
                </div>
                <div class="field">
                    <label for="fullName">Full name</label>
                    <input
                        id="fullName"
                        type="text"
                        value="Platform Admin"
                        readonly
                    />
                </div>
                <div class="field">
                    <label for="email">Email</label>
                    <input
                        id="email"
                        type="email"
                        value="admin@example.com"
                        readonly
                    />
                </div>
                <div class="field">
                    <span class="field-label" id="roleLabel">
                        Role
                    </span>
                    <span class="role-badge" aria-labelledby="roleLabel">
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Administrator
                    </span>
                </div>
            </section>

            <!-- Preferences -->
            <section class="card">
                <div class="card-head">
                    <h2>Preferences</h2>
                    <p>Defaults applied to every search.</p>
                </div>
                <div class="field">
                    <label for="defaultIndex">Default index</label>
                    <select id="defaultIndex">
                        <option value="syslogs">syslogs</option>
                        <option value="otel-logs-v7">otel-logs-v7</option>
                        <option value="otel-traces-v7">otel-traces-v7</option>
                    </select>
                </div>
                <div class="field">
                    <label for="defaultRange">Default time range</label>
                    <select id="defaultRange">
                        <option>Last 1 hour</option>
                        <option selected>Last 24 hours</option>
                        <option>Last 7 days</option>
                        <option>Last 30 days</option>
                    </select>
                </div>
                <div class="field">
                    <span class="field-label">Theme</span>
                    <div class="seg" role="group" aria-label="Theme">
                        <span class="seg-item active">Dark</span>
                        <span class="seg-item dim">Light</span>
                    </div>
                </div>
            </section>

            <!-- Session -->
            <section class="card card-wide">
                <div class="card-head">
                    <h2>Session</h2>
                    <p>Sign out of LUMINA on this device.</p>
                </div>
                <div class="card-foot">
                    <p class="session-note">
                        Connected as
                        <span class="mono">admin@example.com</span>
                    </p>
                    <button class="btn-signout" type="button" id="signoutBtn">
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        Sign out
                    </button>
                </div>
            </section>
        </div>
    </div>

    <script>
        document.getElementById("signoutBtn")?.addEventListener("click", () => {
            localStorage.removeItem("authToken");
            sessionStorage.removeItem("authToken");
            window.location.href = "/signin";
        });
    </script>
    <style>
        .settings-page {
            width: 100%;
            max-width: 980px;
            margin: 0 auto;
            padding: 2.5rem 1.25rem 4rem;
        }

        .page-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .page-eyebrow {
            font-family: var(--mono);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--faint);
            margin-bottom: 0.5rem;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            color: var(--text);
        }

        .back-dash {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.9375rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: rgba(148, 163, 184, 0.04);
            color: var(--muted);
            text-decoration: none;
            font-size: 0.8125rem;
            font-weight: 500;
            transition:
                color 0.15s ease,
                border-color 0.15s ease,
                background 0.15s ease;
        }

        .back-dash svg {
            width: 15px;
            height: 15px;
        }

        .back-dash:hover {
            color: var(--text);
            border-color: var(--border-strong);
            background: rgba(148, 163, 184, 0.08);
        }

        .settings-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .card {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding: 1.5rem;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .card-wide {
            grid-column: 1 / -1;
        }

        .card-head h2 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text);
        }

        .card-head p {
            margin-top: 0.25rem;
            font-size: 0.8125rem;
            color: var(--muted);
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .field label,
        .field-label {
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--muted);
        }

        .field input,
        .field select {
            width: 100%;
            padding: 0.625rem 0.8125rem;
            background: var(--bg-elev);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            font-size: 0.875rem;
            transition:
                border-color 0.15s ease,
                box-shadow 0.15s ease;
        }

        .field input[readonly] {
            color: var(--muted);
        }

        .field input:focus,
        .field select:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.18);
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            align-self: flex-start;
            padding: 0.4375rem 0.8125rem;
            border: 1px solid rgba(129, 140, 248, 0.28);
            border-radius: 100px;
            background: rgba(129, 140, 248, 0.1);
            color: #c7d2fe;
            font-size: 0.8125rem;
            font-weight: 600;
        }

        .role-badge svg {
            width: 15px;
            height: 15px;
        }

        .seg {
            display: inline-flex;
            align-self: flex-start;
            padding: 0.25rem;
            gap: 0.25rem;
            background: var(--bg-elev);
            border: 1px solid var(--border);
            border-radius: 8px;
        }

        .seg-item {
            padding: 0.375rem 0.875rem;
            border-radius: 6px;
            font-size: 0.8125rem;
            font-weight: 500;
            color: var(--faint);
        }

        .seg-item.active {
            background: rgba(129, 140, 248, 0.14);
            color: #c7d2fe;
        }

        .card-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            padding-top: 0.5rem;
            border-top: 1px solid var(--border);
        }

        .session-note {
            font-size: 0.8125rem;
            color: var(--muted);
        }

        .session-note .mono {
            font-family: var(--mono);
            font-size: 0.75rem;
            color: var(--text);
        }

        .btn-signout {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5625rem 1rem;
            background: rgba(248, 113, 113, 0.08);
            border: 1px solid rgba(248, 113, 113, 0.3);
            border-radius: 8px;
            color: var(--danger);
            font-size: 0.8125rem;
            font-weight: 600;
            cursor: pointer;
            transition:
                background 0.15s ease,
                border-color 0.15s ease;
        }

        .btn-signout svg {
            width: 15px;
            height: 15px;
        }

        .btn-signout:hover {
            background: rgba(248, 113, 113, 0.14);
            border-color: rgba(248, 113, 113, 0.45);
        }

        @media (max-width: 767px) {
            .settings-page {
                padding: 1.75rem 1rem 3rem;
            }

            .page-head {
                flex-direction: column;
                align-items: flex-start;
            }

            .settings-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
