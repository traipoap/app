            <!-- ══════════════════ How it works ══════════════════ -->
            <section class="section" id="how-it-works">
                <div class="container">
                    <div class="section-head" data-reveal>
                        <span class="eyebrow">Pipeline</span>
                        <h2>From node to answer in three steps</h2>
                        <p class="section-sub">
                            No agents to babysit and no dashboards to assemble —
                            the whole pipeline is declared in Git and reconciled
                            continuously.
                        </p>
                    </div>
                    <div class="steps" data-reveal data-reveal-delay="100">
                        <div class="step">
                            <span class="step-num">01</span>
                            <h3>Collect</h3>
                            <p>
                                Vector tails K3s nodes, containers, and syslogs,
                                batching every event into Quickwit indexes.
                            </p>
                        </div>
                        <div class="step">
                            <span class="step-num">02</span>
                            <h3>Query</h3>
                            <p>
                                Full-text Lucene search with level, host,
                                source, and time-range filters via the Go API.
                            </p>
                        </div>
                        <div class="step">
                            <span class="step-num">03</span>
                            <h3>Export</h3>
                            <p>
                                CSV streamed server-side — every export
                                fingerprinted with SHA-256 for auditability.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

