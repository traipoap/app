    <script>
        document.documentElement.classList.add("js");
        const revealEls = document.querySelectorAll("[data-reveal]");
        if ("IntersectionObserver" in window) {
            const io = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                            io.unobserve(entry.target);
                        }
                    }
                },
                { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
            );
            revealEls.forEach((el) => io.observe(el));
        } else {
            revealEls.forEach((el) => el.classList.add("is-visible"));
        }
    </script>
</Layout>

<style>
    /* ── Design tokens ─────────────────────────────────────── */
    .landing {
        --bg: #070b14;
        --bg-elev: #0b1120;
        --panel: #0d1424;
        --border: rgba(148, 163, 184, 0.14);
        --border-strong: rgba(148, 163, 184, 0.28);
        --text: #e7ecf5;
        --muted: #9aa7bd;
        --faint: #64748b;
        --accent: #818cf8;
        --accent-strong: #6366f1;
        --accent-2: #22d3ee;
        --success: #34d399;
        --warning: #fbbf24;
        --danger: #f87171;
        --mono:
            "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

        min-height: 100vh;
        background: var(--bg);
        color: var(--text);
        font-family:
            "Inter",
            system-ui,
            -apple-system,
            "Segoe UI",
            sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: clip;
    }

    .landing ::selection {
        background: rgba(99, 102, 241, 0.35);
        color: #fff;
    }

    .container {
        max-width: 1120px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 2rem);
    }

    /* ── Reveal on scroll ──────────────────────────────────── */
    html.js .landing [data-reveal] {
        opacity: 0;
        transform: translateY(18px);
        transition:
            opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
            transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: calc(var(--reveal-delay, 0) * 1ms);
    }
    html.js .landing [data-reveal].is-visible {
        opacity: 1;
        transform: none;
    }
    .landing [data-reveal-delay="60"] {
        --reveal-delay: 60;
    }
    .landing [data-reveal-delay="100"] {
        --reveal-delay: 100;
    }
    .landing [data-reveal-delay="120"] {
        --reveal-delay: 120;
    }
    .landing [data-reveal-delay="150"] {
        --reveal-delay: 150;
    }

    /* ── Header ────────────────────────────────────────────── */
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(7, 11, 20, 0.72);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border);
    }

    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
        gap: 1rem;
    }

    .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        text-decoration: none;
        color: var(--text);
    }

    .logo-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        color: #fff;
        background: linear-gradient(
            135deg,
            var(--accent-strong),
            #4f46e5 55%,
            var(--accent-2)
        );
        box-shadow: 0 4px 14px -4px rgba(99, 102, 241, 0.55);
    }

    .logo-mark svg {
        width: 17px;
        height: 17px;
    }

    .logo-word {
        font-size: 0.9375rem;
        font-weight: 700;
        letter-spacing: 0.14em;
    }

    .logo-sub {
        padding-left: 0.625rem;
        margin-left: 0.25rem;
        border-left: 1px solid var(--border-strong);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--faint);
        white-space: nowrap;
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .nav-link {
        padding: 0.5rem 0.875rem;
        text-decoration: none;
        color: var(--muted);
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 8px;
        transition:
            color 0.15s ease,
            background 0.15s ease;
    }

    .nav-link:hover {
        color: var(--text);
        background: rgba(148, 163, 184, 0.08);
    }

    @media (max-width: 760px) {
        .logo-sub,
        .nav .nav-link:not(.btn) {
            display: none;
        }
    }

    /* ── Buttons ───────────────────────────────────────────── */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.7rem 1.375rem;
        border-radius: 10px;
        border: 1px solid transparent;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9375rem;
        line-height: 1.2;
        cursor: pointer;
        transition:
            background 0.18s ease,
            border-color 0.18s ease,
            box-shadow 0.18s ease,
            transform 0.18s ease,
            color 0.18s ease;
        white-space: nowrap;
    }

    .btn svg {
        width: 17px;
        height: 17px;
    }

    .btn-sm {
        padding: 0.45rem 0.95rem;
        font-size: 0.875rem;
        border-radius: 8px;
    }

    .btn-lg {
        padding: 0.875rem 1.75rem;
        font-size: 1rem;
        border-radius: 12px;
    }

    .btn-primary {
        background: var(--accent-strong);
        color: #fff;
        box-shadow:
            0 1px 0 rgba(255, 255, 255, 0.12) inset,
            0 10px 28px -10px rgba(99, 102, 241, 0.55);
    }

    .btn-primary:hover {
        background: #7478f3;
        transform: translateY(-1px);
        box-shadow:
            0 1px 0 rgba(255, 255, 255, 0.14) inset,
            0 14px 34px -10px rgba(99, 102, 241, 0.65);
    }

    .btn-primary:active {
        transform: translateY(0);
    }

    .btn-ghost {
        background: rgba(148, 163, 184, 0.04);
        border-color: var(--border-strong);
        color: var(--text);
    }

    .btn-ghost:hover {
        background: rgba(148, 163, 184, 0.1);
        border-color: rgba(148, 163, 184, 0.45);
    }

    /* ── Hero ──────────────────────────────────────────────── */
    .hero {
        position: relative;
        padding: clamp(4rem, 8vw, 6.5rem) 0 clamp(4.5rem, 9vw, 7rem);
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image:
            linear-gradient(rgba(148, 163, 184, 0.055) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(148, 163, 184, 0.055) 1px,
                transparent 1px
            );
        background-size: 44px 44px;
        -webkit-mask-image: radial-gradient(
            ellipse 85% 65% at 50% 0%,
            #000 25%,
            transparent 72%
        );
        mask-image: radial-gradient(
            ellipse 85% 65% at 50% 0%,
            #000 25%,
            transparent 72%
        );
    }

    .hero::after {
        content: "";
        position: absolute;
        top: -220px;
        left: 50%;
        transform: translateX(-50%);
        width: min(900px, 90vw);
        height: 520px;
        pointer-events: none;
        background:
            radial-gradient(
                closest-side,
                rgba(99, 102, 241, 0.2),
                transparent 70%
            ),
            radial-gradient(
                closest-side,
                rgba(34, 211, 238, 0.08),
                transparent 70%
            );
    }

    .hero-grid {
        position: relative;
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        gap: clamp(2.5rem, 5vw, 4.5rem);
        align-items: center;
    }

    @media (max-width: 940px) {
        .hero-grid {
            grid-template-columns: 1fr;
            max-width: 640px;
            margin-inline: auto;
        }
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.875rem 0.375rem 0.75rem;
        border: 1px solid var(--border-strong);
        border-radius: 100px;
        background: rgba(99, 102, 241, 0.08);
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        margin-bottom: 1.75rem;
    }

    .badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.18);
        animation: pulse 2.4s ease-in-out infinite;
    }

    .hero-title {
        font-size: clamp(2.375rem, 5.2vw, 3.5rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -0.03em;
        margin: 0 0 1.375rem;
        color: var(--text);
        text-wrap: balance;
    }

    .gradient {
        background: linear-gradient(
            100deg,
            var(--accent) 10%,
            var(--accent-2) 90%
        );
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
    }

    .hero-sub {
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--muted);
        margin: 0 0 2.25rem;
        max-width: 52ch;
    }

    .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        margin-bottom: 2.5rem;
    }

    .hero-points {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .hero-points li {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--faint);
    }

    .hero-points svg {
        width: 14px;
        height: 14px;
        color: var(--accent);
        flex-shrink: 0;
    }

    /* ── Hero visual: dashboard window ─────────────────────── */
    .stage {
        position: relative;
    }

    .stage::before {
        content: "";
        position: absolute;
        inset: 8% -6% -10% -6%;
        background: radial-gradient(
            closest-side,
            rgba(99, 102, 241, 0.22),
            transparent 75%
        );
        filter: blur(10px);
        pointer-events: none;
    }

    .window {
        position: relative;
        background: var(--bg-elev);
        border: 1px solid var(--border-strong);
        border-radius: 14px;
        box-shadow:
            0 30px 80px -30px rgba(0, 0, 0, 0.8),
            0 12px 50px -18px rgba(99, 102, 241, 0.3);
        overflow: hidden;
    }

    .window-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid var(--border);
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        opacity: 0.9;
    }
    .dot.red {
        background: #f2555a;
    }
    .dot.yellow {
        background: #f5b93d;
    }
    .dot.green {
        background: #48c78a;
    }

    .window-title {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 0.6875rem;
        color: var(--faint);
        letter-spacing: 0.02em;
    }

    .window-body {
        display: grid;
        grid-template-columns: 48px 1fr;
        gap: 0;
    }

    .side {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 0;
        border-right: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.015);
    }

    .side-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        color: var(--faint);
        border: 1px solid transparent;
    }

    .side-icon svg {
        width: 15px;
        height: 15px;
    }

    .side-icon.active {
        color: var(--accent);
        background: rgba(99, 102, 241, 0.12);
        border-color: rgba(99, 102, 241, 0.35);
    }

    .main {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        padding: 0.875rem;
        min-width: 0;
    }

    .query {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: rgba(7, 11, 20, 0.6);
        font-family: var(--mono);
        font-size: 0.75rem;
        overflow: hidden;
        white-space: nowrap;
    }

    .query-prompt {
        color: var(--accent);
        font-weight: 600;
    }

    .query-text {
        color: var(--muted);
    }

    .caret {
        width: 7px;
        height: 14px;
        margin-left: -3px;
        background: var(--accent);
        opacity: 0.8;
        animation: blink 1.1s steps(1) infinite;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.625rem;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 0.625rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--panel);
    }

    .stat-label {
        font-size: 0.625rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--faint);
    }

    .stat-value {
        font-size: 1.0625rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--text);
        font-variant-numeric: tabular-nums;
    }

    .stat-trend {
        align-self: flex-start;
        margin-top: 2px;
        font-size: 0.6875rem;
        font-weight: 600;
        padding: 0.0625rem 0.4375rem;
        border-radius: 4px;
    }

    .stat-trend.up {
        color: var(--success);
        background: rgba(52, 211, 153, 0.12);
    }

    .stat-trend.down {
        color: var(--danger);
        background: rgba(248, 113, 113, 0.12);
    }

    .logs {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .log-row {
        display: grid;
        grid-template-columns: 62px 52px minmax(0, 1fr);
        align-items: baseline;
        gap: 0.625rem;
        padding: 0.4375rem 0.625rem;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.02);
        font-family: var(--mono);
        font-size: 0.75rem;
        animation: log-in 0.5s ease both;
    }

    .log-row:nth-child(1) {
        animation-delay: 0.25s;
    }
    .log-row:nth-child(2) {
        animation-delay: 0.4s;
    }
    .log-row:nth-child(3) {
        animation-delay: 0.55s;
    }
    .log-row:nth-child(4) {
        animation-delay: 0.7s;
    }

    .log-time {
        color: var(--faint);
        font-variant-numeric: tabular-nums;
    }

    .log-level {
        justify-self: start;
        font-size: 0.625rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        padding: 0.125rem 0.4375rem;
        border-radius: 4px;
        border: 1px solid;
    }

    .log-level.info {
        color: var(--success);
        background: rgba(52, 211, 153, 0.1);
        border-color: rgba(52, 211, 153, 0.25);
    }
    .log-level.warn {
        color: var(--warning);
        background: rgba(251, 191, 36, 0.1);
        border-color: rgba(251, 191, 36, 0.25);
    }
    .log-level.error {
        color: var(--danger);
        background: rgba(248, 113, 113, 0.1);
        border-color: rgba(248, 113, 113, 0.25);
    }

    .log-msg {
        color: var(--muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .window-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.625rem 1rem;
        border-top: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.015);
        font-size: 0.75rem;
    }

    .live {
        display: inline-flex;
        align-items: center;
        gap: 0.4375rem;
        font-weight: 600;
        color: var(--text);
    }

    .live i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 8px rgba(52, 211, 153, 0.8);
        animation: pulse 2s ease-in-out infinite;
    }

    .window-meta {
        font-family: var(--mono);
        font-size: 0.6875rem;
        color: var(--faint);
    }

    .float-chip {
        position: absolute;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5625rem 0.875rem;
        border-radius: 10px;
        border: 1px solid var(--border-strong);
        background: rgba(13, 20, 36, 0.88);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.7);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--muted);
        white-space: nowrap;
        animation: float 6s ease-in-out infinite alternate;
    }

    .float-chip svg {
        width: 14px;
        height: 14px;
        color: var(--accent);
        flex-shrink: 0;
    }

    .chip-tr {
        top: -18px;
        right: -14px;
    }

    .chip-bl {
        bottom: -16px;
        left: -14px;
        animation-delay: 3s;
    }

    @media (max-width: 940px) {
        .chip-tr {
            right: 0;
        }
        .chip-bl {
            left: 0;
        }
    }

    /* ── Sections ──────────────────────────────────────────── */
    .section {
        padding: clamp(4rem, 8vw, 6.5rem) 0;
        scroll-margin-top: 80px;
    }

    .section-tight {
        padding-bottom: 0;
    }

    .section-head {
        max-width: 620px;
        margin: 0 auto 3.5rem;
        text-align: center;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        font-family: var(--mono);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--accent);
        margin-bottom: 1rem;
    }

    .eyebrow::before,
    .eyebrow::after {
        content: "";
        width: 22px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--border-strong));
    }
    .eyebrow::after {
        background: linear-gradient(90deg, var(--border-strong), transparent);
    }

    .section-head h2 {
        font-size: clamp(1.75rem, 3.5vw, 2.375rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.15;
        margin: 0 0 1rem;
        text-wrap: balance;
    }

    .section-sub {
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.65;
        margin: 0;
    }

    /* ── Steps ─────────────────────────────────────────────── */
    .steps {
        position: relative;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .steps::before {
        content: "";
        position: absolute;
        top: 26px;
        left: 14%;
        right: 14%;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--border-strong) 25%,
            var(--border-strong) 75%,
            transparent
        );
    }

    @media (max-width: 760px) {
        .steps {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .steps::before {
            display: none;
        }
    }

    .step {
        text-align: center;
        padding: 2rem 1.5rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: rgba(13, 20, 36, 0.5);
        transition:
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .step:hover {
        border-color: var(--border-strong);
        transform: translateY(-3px);
    }

    .step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 52px;
        height: 52px;
        padding: 0 0.5rem;
        border-radius: 12px;
        border: 1px solid rgba(99, 102, 241, 0.35);
        background: radial-gradient(
            120% 120% at 50% 0%,
            rgba(99, 102, 241, 0.18),
            rgba(13, 20, 36, 1) 70%
        );
        font-family: var(--mono);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent);
        margin-bottom: 1.25rem;
    }

    .step h3 {
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 0 0 0.5rem;
    }

    .step p {
        color: var(--muted);
        font-size: 0.875rem;
        line-height: 1.65;
        margin: 0;
    }

    /* ── Feature cards ─────────────────────────────────────── */
    .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }

    @media (max-width: 940px) {
        .cards {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .cards {
            grid-template-columns: 1fr;
        }
    }

    .card {
        display: flex;
        flex-direction: column;
        padding: 1.75rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: rgba(13, 20, 36, 0.5);
        transition:
            border-color 0.2s ease,
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .card:hover {
        border-color: rgba(99, 102, 241, 0.4);
        background: rgba(13, 20, 36, 0.85);
        transform: translateY(-3px);
        box-shadow: 0 18px 40px -20px rgba(99, 102, 241, 0.35);
    }

    .card-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 11px;
        border: 1px solid rgba(99, 102, 241, 0.3);
        background: rgba(99, 102, 241, 0.1);
        color: var(--accent);
        margin-bottom: 1.25rem;
    }

    .card-icon svg {
        width: 20px;
        height: 20px;
    }

    .card h3 {
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 0 0 0.5rem;
    }

    .card p {
        color: var(--muted);
        font-size: 0.875rem;
        line-height: 1.65;
        margin: 0;
    }

    /* ── Tech chips ────────────────────────────────────────── */
    .chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.625rem;
        max-width: 760px;
        margin: 0 auto;
        padding: 0;
        list-style: none;
    }

    .chips li {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border: 1px solid var(--border);
        border-radius: 100px;
        background: rgba(13, 20, 36, 0.5);
        font-family: var(--mono);
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--muted);
        transition:
            color 0.15s ease,
            border-color 0.15s ease,
            background 0.15s ease;
        cursor: default;
    }

    .chips li::before {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--faint);
        transition: background 0.15s ease;
    }

    .chips li:hover {
        color: var(--text);
        border-color: rgba(99, 102, 241, 0.45);
        background: rgba(99, 102, 241, 0.08);
    }

    .chips li:hover::before {
        background: var(--accent);
    }

    /* ── CTA ───────────────────────────────────────────────── */
    .cta {
        position: relative;
        overflow: hidden;
        text-align: center;
        padding: clamp(3.5rem, 7vw, 5.5rem) clamp(1.5rem, 5vw, 4rem);
        border: 1px solid var(--border-strong);
        border-radius: 20px;
