            font-family: var(--mono);
            font-size: 11.5px;
            color: var(--dim);
            white-space: nowrap;
        }
        .clock b {
            color: var(--amb);
            font-weight: 500;
        }
        .sysdot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--grn);
            margin-right: 6px;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5);
            }
            50% {
                box-shadow: 0 0 0 5px rgba(52, 211, 153, 0);
            }
        }

        /* ============ HERO ============ */
        .hero {
            padding: 130px 0 0;
            position: relative;
        }
        .hero-grid {
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 48px;
            align-items: center;
        }
        .eyebrow {
            font-family: var(--mono);
            font-size: 13px;
            color: var(--grn);
            margin-bottom: 14px;
        }
        .eyebrow::after {
            content: "▮";
            animation: blink 1.1s steps(1) infinite;
            margin-left: 2px;
        }
        @keyframes blink {
            50% {
                opacity: 0;
            }
        }
        h1 {
            font-family: var(--disp);
            font-weight: 700;
            font-size: clamp(2.4rem, 6.2vw, 4.6rem);
            letter-spacing: -0.02em;
            line-height: 1.05;
            /* สำรองที่ 2 บรรทัดไว้เลย — ระหว่างที่ scramble เปลี่ยนตัวอักษร
               ถ้าจำนวนบรรทัดกระเด้ง 1↔2 บรรทัดจะทำให้ทั้งหน้าสั่น */
            min-height: calc(2 * 1.05em);
            color: #f2f7fa;
        }
        .role {
            font-family: var(--disp);
            font-size: clamp(1rem, 2vw, 1.3rem);
            color: var(--amb);
            margin-top: 10px;
            font-weight: 500;
        }
        .role .slash {
            color: var(--dim);
        }
        .hero p.lead {
            color: var(--mut);
            margin-top: 20px;
            max-width: 52ch;
            font-size: 1.02rem;
        }
        .hero p.lead strong {
            color: var(--txt);
        }
        .hero-cta {
            display: flex;
            gap: 14px;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        .btn {
            font-family: var(--mono);
            font-size: 13px;
            padding: 13px 22px;
            border-radius: 5px;
            border: 1px solid var(--line2);
            background: transparent;
            color: var(--txt);
            transition: 0.25s;
            letter-spacing: 0.02em;
            display: inline-block;
        }
        .btn:hover {
            border-color: var(--grn);
            color: var(--grn);
            box-shadow: 0 0 22px rgba(52, 211, 153, 0.15);
            transform: translateY(-2px);
        }
        .btn.prime {
            background: var(--grn);
            border-color: var(--grn);
            color: #04140c;
            font-weight: 700;
        }
        .btn.prime:hover {
            color: #04140c;
            box-shadow: 0 0 28px rgba(52, 211, 153, 0.4);
        }
        .hero-stats {
            display: flex;
            gap: 0;
            margin-top: 44px;
            border: 1px solid var(--line);
            border-radius: 8px;
            overflow: hidden;
            background: rgba(12, 20, 29, 0.55);
        }
        .hstat {
            flex: 1;
            padding: 16px 18px;
            border-right: 1px solid var(--line);
        }
        .hstat:last-child {
            border-right: 0;
        }
        .hstat b {
            font-family: var(--disp);
            font-size: clamp(1.3rem, 2.4vw, 1.8rem);
            color: var(--grn);
            display: block;
            line-height: 1.1;
        }
        .hstat span {
            font-size: 12px;
            color: var(--mut);
        }
        .nodechips {
            display: flex;
            gap: 10px;
            margin-top: 18px;
            flex-wrap: wrap;
        }
        .nchip {
            font-family: var(--mono);
            font-size: 11.5px;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 5px 13px;
            color: var(--mut);
            display: flex;
            align-items: center;
            gap: 7px;
        }
        .nchip i {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--grn);
            animation: pulse 2.4s infinite;
        }
        .nchip:nth-child(2) i {
            animation-delay: 0.5s;
        }
        .nchip:nth-child(3) i {
            animation-delay: 1s;
        }

        /* terminal */
        .term {
            background: #050b09;
            border: 1px solid rgba(52, 211, 153, 0.22);
            border-radius: 10px;
            box-shadow:
                0 24px 70px rgba(0, 0, 0, 0.55),
                0 0 0 1px rgba(52, 211, 153, 0.05);
            overflow: hidden;
        }
        .term-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 11px 14px;
            background: #0a120f;
            border-bottom: 1px solid rgba(52, 211, 153, 0.14);
        }
        .term-bar i {
            width: 11px;
            height: 11px;
            border-radius: 50%;
        }
        .term-bar i:nth-child(1) {
            background: #ff5f57;
        }
        .term-bar i:nth-child(2) {
            background: #febc2e;
        }
        .term-bar i:nth-child(3) {
            background: #28c840;
        }
        .term-bar em {
            font-family: var(--mono);
            font-size: 11.5px;
            color: var(--dim);
            font-style: normal;
            margin-left: 8px;
        }
        .term-body {
            padding: 18px 16px;
            font-family: var(--mono);
            font-size: 12.5px;
            line-height: 1.9;
            min-height: 330px;
            color: #9fe8c8;
        }
        .tl-cmd {
            color: #eafff4;
        }
        .tl-cmd::before {
            content: "$ ";
            color: var(--grn);
        }
        .tl-out {
            color: #5d8a76;
            white-space: pre-wrap;
        }
        .tl-ok {
            color: var(--grn);
        }
        .tl-dim {
            color: #3f5a4e;
        }
        .caret {
            display: inline-block;
            width: 8px;
            height: 14px;
            background: var(--grn);
            vertical-align: -2px;
            animation: blink 1s steps(1) infinite;
        }

        /* marquee */
        .marquee {
            border-block: 1px solid var(--line);
            margin-top: 70px;
            overflow: hidden;
            background: rgba(10, 16, 22, 0.6);
        }
        .mq-track {
            display: flex;
            gap: 0;
            width: max-content;
            animation: mq 32s linear infinite;
        }
        .mq-track span {
            font-family: var(--mono);
            font-size: 12.5px;
            color: var(--mut);
            padding: 13px 0;
            letter-spacing: 0.12em;
        }
        .mq-track span b {
            color: var(--grn);
            font-weight: 500;
            padding: 0 22px;
        }
        @keyframes mq {
            to {
                transform: translateX(-50%);
            }
        }

        /* ============ SECTIONS ============ */
        section {
            padding: 96px 0;
            position: relative;
        }
        .sec-head {
            display: flex;
            gap: 22px;
            align-items: flex-start;
            margin-bottom: 52px;
        }
        .sec-idx {
            font-family: var(--disp);
            font-size: clamp(2.4rem, 5vw, 3.6rem);
            font-weight: 700;
            color: transparent;
            -webkit-text-stroke: 1.5px rgba(52, 211, 153, 0.55);
            line-height: 1;
            flex-shrink: 0;
        }
        .sec-head h2 {
            font-family: var(--disp);
            font-size: clamp(1.7rem, 3.4vw, 2.5rem);
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -0.01em;
        }
        .sec-head .sub {
            color: var(--mut);
            margin-top: 8px;
            max-width: 60ch;
        }
        .sec-tag {
            font-family: var(--mono);
            font-size: 11px;
            color: var(--amb);
            letter-spacing: 0.18em;
            display: block;
            margin-bottom: 6px;
        }
        .lm {
            overflow: hidden;
        }

        /* — reveal states: เปิดใช้เฉพาะเมื่อ JS พร้อม และไม่ปิดกั้นการเคลื่อนไหว — */
        @media (prefers-reduced-motion: no-preference) {
            html.js .rv {
                opacity: 0;
                transform: translateY(22px);
                transition:
                    opacity 0.7s ease,
                    transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
                transition-delay: calc(var(--d, 0) * 90ms);
            }
            html.js .rv.in {
                opacity: 1;
                transform: none;
            }
            html.js .lm > span {
                display: block;
                transform: translateY(115%);
                transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
            }
            html.js .in .lm > span {
                transform: translateY(0);
            }
            html.js .bar i {
                width: 0;
                transition: width 1.4s cubic-bezier(0.2, 0.8, 0.2, 1);
            }
            html.js .in .bar i {
                width: var(--w);
            }
        }
        .bar {
            height: 5px;
            background: rgba(140, 190, 210, 0.1);
            border-radius: 3px;
            margin-top: 5px;
            overflow: hidden;
        }
        .bar i {
            display: block;
            height: 100%;
            width: var(--w);
            border-radius: 3px;
            background: linear-gradient(90deg, var(--grn), var(--cyn));
        }

        /* ============ ARCH (sticky 2-col) ============ */
        .arch-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 56px;
            align-items: start;
        }
        .arch-stick {
            position: sticky;
            top: 86px;
        }
        .arch-frame {
            border: 1px solid var(--line);
            border-radius: 10px;
            background: rgba(8, 13, 19, 0.85);
            padding: 18px;
            position: relative;
        }
        .arch-frame::after {
            content: "LIVE — อ่านถึงชั้นไหน ไดอะแกรมไฮไลต์ตาม";
            position: absolute;
            bottom: -11px;
            left: 18px;
            font-family: var(--mono);
            font-size: 10.5px;
            color: var(--bg);
            background: var(--amb);
            padding: 2px 10px;
            border-radius: 3px;
            letter-spacing: 0.05em;
        }
        svg.arch {
            width: 100%;
            height: auto;
            display: block;
        }
        .arch .node {
            fill: var(--panel);
            stroke: var(--line2);
            stroke-width: 1.2;
            transition: 0.35s;
        }
        .arch .lbl {
            fill: var(--txt);
            font-family: var(--mono);
            font-size: 13px;
            font-weight: 600;
        }
        .arch .sub {
            fill: var(--dim);
            font-family: var(--mono);
            font-size: 10px;
        }
        .arch .tag {
            fill: var(--amb);
            font-family: var(--mono);
            font-size: 10px;
        }
        .arch .flow {
            stroke: var(--line2);
            stroke-width: 1.4;
            fill: none;
            stroke-dasharray: 5 5;
            animation: dash 1.4s linear infinite;
        }
        .arch .flow.hot {
            stroke: rgba(52, 211, 153, 0.7);
        }
        @keyframes dash {
            to {
                stroke-dashoffset: -20;
            }
        }
        .arch [data-part] {
            opacity: 0.42;
            transition: opacity 0.4s;
        }
        .arch[data-active="edge"] [data-part~="edge"],
        .arch[data-active="gateway"] [data-part~="gateway"],
        .arch[data-active="compute"] [data-part~="compute"],
        .arch[data-active="app"] [data-part~="app"],
        .arch[data-active="app"] [data-part~="observe"] {
            opacity: 1;
        }
        .arch[data-active="edge"] [data-part~="edge"] .node,
        .arch[data-active="gateway"] [data-part~="gateway"] .node,
        .arch[data-active="compute"] [data-part~="compute"] .node,
        .arch[data-active="app"] [data-part~="app"] .node,
        .arch[data-active="app"] [data-part~="observe"] .node {
            stroke: var(--grn);
            filter: drop-shadow(0 0 7px rgba(52, 211, 153, 0.5));
        }
        .arch .pod {
            fill: rgba(52, 211, 153, 0.12);
            stroke: rgba(52, 211, 153, 0.5);
            stroke-width: 0.8;
        }
        .arch .podlbl {
            fill: var(--grn);
            font-family: var(--mono);
            font-size: 9.5px;
        }
        .layers {
            display: flex;
            flex-direction: column;
            gap: 22px;
        }
        .layer-card {
            border: 1px solid var(--line);
            border-left: 3px solid var(--line2);
            border-radius: 8px;
            background: var(--panel);
            padding: 26px 28px;
            transition: 0.35s;
        }
        .layer-card.on {
            border-left-color: var(--grn);
            background: var(--panel2);
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.35);
        }
        .layer-card h3 {
            font-family: var(--disp);
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .layer-card h3 .mono {
            font-size: 11px;
            color: var(--amb);
            border: 1px solid rgba(251, 191, 36, 0.3);
            padding: 2px 8px;
            border-radius: 3px;
        }
        .layer-card p {
            color: var(--mut);
            font-size: 0.95rem;
            margin-top: 10px;
        }
        .layer-card ul {
            margin-top: 12px;
            list-style: none;
        }
        .layer-card li {
            font-size: 0.88rem;
            color: var(--mut);
            padding-left: 20px;
            position: relative;
            margin-top: 6px;
        }
        .layer-card li::before {
            content: "▸";
            color: var(--grn);
            position: absolute;
            left: 0;
        }
        .layer-card li b {
            color: var(--txt);
            font-weight: 500;
        }

        /* ============ HARDWARE ============ */
        .hw-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }
        .hw-card {
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--panel);
            padding: 22px;
            position: relative;
            overflow: hidden;
            transition: 0.3s;
        }
        .hw-card:hover {
            transform: translateY(-5px);
            border-color: var(--line2);
            box-shadow: 0 18px 44px rgba(0, 0, 0, 0.4);
        }
        .hw-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--grn), transparent);
        }
        .hw-host {
            font-family: var(--mono);
            font-size: 14px;
            color: var(--grn);
        }
        .hw-role {
            font-family: var(--mono);
            font-size: 10.5px;
            color: var(--amb);
            border: 1px solid rgba(251, 191, 36, 0.3);
            border-radius: 3px;
            padding: 1px 8px;
            display: inline-block;
            margin-top: 6px;
            letter-spacing: 0.08em;
        }
        .hw-spec {
            margin-top: 16px;
            font-size: 0.83rem;
            color: var(--mut);
        }
        .hw-spec div {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px dashed rgba(140, 190, 210, 0.12);
            padding: 5px 0;
            gap: 8px;
        }
        .hw-spec b {
            color: var(--txt);
            font-family: var(--mono);
            font-weight: 500;
            font-size: 0.8rem;
            text-align: right;
        }
        .meter {
            margin-top: 14px;
        }
        .meter label {
            font-family: var(--mono);
            font-size: 10.5px;
            color: var(--dim);
            display: flex;
            justify-content: space-between;
        }
        .meter label b {
            color: var(--cyn);
            font-weight: 500;
        }
        .hw-uptime {
            margin-top: 14px;
            font-family: var(--mono);
            font-size: 11px;
            color: var(--dim);
        }
        .hw-uptime b {
            color: var(--txt);
        }

        /* ============ IaC ============ */
        .iac-grid {
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            gap: 48px;
            align-items: start;
        }
        .iac-points {
            list-style: none;
        }
        .iac-points li {
            padding: 16px 0;
            border-bottom: 1px solid var(--line);
            display: flex;
            gap: 16px;
        }
        .iac-points .n {
            font-family: var(--disp);
            font-weight: 700;
            color: var(--grn);
            font-size: 1.1rem;
            min-width: 34px;
        }
        .iac-points b {
            display: block;
            font-weight: 600;
        }
        .iac-points p {
            color: var(--mut);
            font-size: 0.9rem;
            margin-top: 3px;
        }
        .iac-metrics {
            display: flex;
            gap: 14px;
            margin-top: 26px;
            flex-wrap: wrap;
        }
        .im {
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 12px 18px;
            background: var(--panel);
        }
        .im b {
            font-family: var(--disp);
            font-size: 1.5rem;
            color: var(--amb);
            display: block;
            line-height: 1.2;
        }
        .im span {
            font-size: 11.5px;
            color: var(--mut);
        }
        .tabs {
            display: flex;
            gap: 0;
            border-bottom: 1px solid var(--line);
            margin-bottom: 0;
        }
        .tab {
            font-family: var(--mono);
            font-size: 12px;
            background: none;
            border: none;
            color: var(--dim);
            padding: 12px 18px;
            border-bottom: 2px solid transparent;
            transition: 0.2s;
            letter-spacing: 0.03em;
        }
        .tab:hover {
            color: var(--txt);
        }
        .tab.on {
            color: var(--grn);
            border-bottom-color: var(--grn);
        }
        .codebox {
            background: #050b09;
            border: 1px solid var(--line);
            border-top: 0;
            border-radius: 0 0 10px 10px;
            overflow: auto;
        }
        .codebox pre {
            font-family: var(--mono);
            font-size: 12.5px;
            line-height: 1.85;
            padding: 22px;
            color: #a8c9bb;
            min-width: max-content;
        }
        .codep {
            display: none;
        }
        .codep.on {
            display: block;
        }
        .k {
            color: var(--amb);
        }
        .s {
            color: #8ce99a;
        }
        .c {
            color: #4b6358;
            font-style: italic;
        }
        .v {
            color: var(--cyn);
        }
        .f {
            color: #e9b4ff;
        }

        /* ============ PIPELINE ============ */
        .pipe-panel {
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--panel);
            overflow: hidden;
        }
        .pipe-top {
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 18px 24px;
            border-bottom: 1px solid var(--line);
            flex-wrap: wrap;
            background: var(--panel2);
        }
        .commit {
            font-family: var(--mono);
            font-size: 12px;
            color: var(--mut);
        }
        .commit b {
            color: var(--amb);
            font-weight: 500;
        }
        .commit .hash {
            color: var(--grn);
        }
        .pipe-total {
            margin-left: auto;
            font-family: var(--mono);
            font-size: 13px;
            color: var(--dim);
        }
        .pipe-total b {
            color: var(--txt);
            font-size: 1.15rem;
            font-weight: 600;
        }
        #btnPipe {
            margin-left: 12px;
        }
        .steps {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            position: relative;
        }
        .steps::before {
            content: "";
            position: absolute;
            top: 25px;
            left: 8%;
            right: 8%;
            height: 2px;
            background: rgba(140, 190, 210, 0.12);
        }
        #pipeFill {
            position: absolute;
            top: 25px;
            left: 8%;
            height: 2px;
            background: var(--grn);
            width: 0;
            transition: width 0.6s ease;
            box-shadow: 0 0 10px rgba(52, 211, 153, 0.7);
        }
        .step {
            text-align: center;
            padding: 20px 8px 24px;
            position: relative;
        }
        .step .dot {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 2px solid var(--line2);
            background: var(--bg2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: var(--mono);
            font-size: 12px;
            color: var(--dim);
            position: relative;
            z-index: 1;
            transition: 0.3s;
        }
        .step b {
            display: block;
            font-size: 0.85rem;
            margin-top: 12px;
            font-weight: 600;
            color: var(--mut);
            transition: 0.3s;
        }
        .step small {
            display: block;
            font-family: var(--mono);
            font-size: 10px;
            color: var(--dim);
            margin-top: 3px;
        }
        .step em {
            font-style: normal;
            font-family: var(--mono);
            font-size: 10px;
            color: var(--dim);
            display: block;
            margin-top: 6px;
            min-height: 14px;
        }
        .step.run .dot {
            border-color: var(--amb);
            color: var(--amb);
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
        .step.run b {
            color: var(--amb);
        }
        .step.ok .dot {
            border-color: var(--grn);
            background: var(--grn-dk);
            color: var(--grn);
        }
        .step.ok b {
            color: var(--txt);
        }
        .step.ok em {
            color: var(--grn);
        }
        .step.bad .dot {
