    <script>
        // @ts-nocheck — ported as-is from the standalone portfolio.html (untyped
        // vanilla JS). Runtime behavior is unchanged; a typed rewrite can follow.
        document.documentElement.classList.add("js");
        (function () {
            "use strict";
            const $ = (s, c) => (c || document).querySelector(s),
                $$ = (s, c) => [...(c || document).querySelectorAll(s)];
            const REDUCED = matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            const wait = (ms) => new Promise((r) => setTimeout(r, ms));
            const pad = (n) => String(n).padStart(2, "0");
            function toast(msg) {
                const t = $("#toast");
                t.textContent = msg;
                t.classList.add("show");
                clearTimeout(t._h);
                t._h = setTimeout(() => t.classList.remove("show"), 3200);
            }

            try {
                /* clock */
                function tickClock() {
                    try {
                        $("#clock").innerHTML =
                            "<b>" +
                            new Date().toLocaleTimeString("th-TH", {
                                hour12: false,
                                timeZone: "Asia/Bangkok",
                            }) +
                            "</b> ICT";
                    } catch (e) {}
                }
                tickClock();
                setInterval(tickClock, 1000);

                /* nav scrolled + active link */
                const nav = $("#nav");
                addEventListener(
                    "scroll",
                    () => nav.classList.toggle("scrolled", scrollY > 10),
                    { passive: true },
                );
                const secObs = new IntersectionObserver(
                    (es) => {
                        es.forEach((e) => {
                            if (e.isIntersecting) {
                                $$(".nav-links a").forEach((a) =>
                                    a.classList.toggle(
                                        "cur",
                                        a.getAttribute("href") ===
                                            "#" + e.target.id,
                                    ),
                                );
                            }
                        });
                    },
                    { rootMargin: "-40% 0px -55% 0px" },
                );
                [
                    "arch",
                    "lab",
                    "iac",
                    "pipeline",
                    "gitops",
                    "obs",
                    "process",
                    "resume",
                    "contact",
                ].forEach((id) => {
                    const el = document.getElementById(id);
                    if (el) secObs.observe(el);
                });

                /* reveal — เริ่มแบบมองเห็นได้ทันทีเมื่อโผล่พ้นขอบล่างเล็กน้อย */
                const rObs = new IntersectionObserver(
                    (es) => {
                        es.forEach((e) => {
                            if (e.isIntersecting) {
                                e.target.classList.add("in");
                                rObs.unobserve(e.target);
                            }
                        });
                    },
                    { threshold: 0, rootMargin: "0px 0px -6% 0px" },
                );
                $$(".rv, .sec-head").forEach((el) => rObs.observe(el));
                /* safety net: เผื่อ observer ไม่ทำงานในบางสภาพแวดล้อม */
                addEventListener("load", () =>
                    setTimeout(
                        () =>
                            $$(".rv, .sec-head").forEach((el) =>
                                el.classList.add("in"),
                            ),
                        1800,
                    ),
                );

                /* counters (ค่าจริงอยู่ใน markup แล้ว — นับใหม่เฉพาะเมื่อมองเห็น) */
                const cObs = new IntersectionObserver(
                    (es) => {
                        es.forEach((e) => {
                            if (!e.isIntersecting) return;
                            cObs.unobserve(e.target);
                            const el = e.target,
                                to = parseFloat(el.dataset.to),
                                dec = +el.dataset.dec || 0;
                            const fmt = (v) =>
                                v
                                    .toFixed(dec)
                                    .replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                            if (REDUCED) {
                                el.textContent = fmt(to);
                                return;
                            }
                            const t0 = performance.now(),
                                dur = 1400;
                            (function f(t) {
                                const p = Math.min(1, (t - t0) / dur),
                                    ease = 1 - Math.pow(1 - p, 3);
                                el.textContent = fmt(to * ease);
                                if (p < 1) requestAnimationFrame(f);
                            })(t0);
                        });
                    },
                    { threshold: 0.5 },
                );
                $$(".count").forEach((el) => cObs.observe(el));

                /* scramble name */
                (function () {
                    const el = $("#scrName");
                    if (!el || REDUCED) return;
                    const fin = el.dataset.text,
                        CH = "#_/\\[]{}=+*<>01?";
                    let f = 0,
                        total = fin.length * 3 + 10;
                    (function tick() {
                        let out = "";
                        for (let i = 0; i < fin.length; i++) {
                            out +=
                                i < (f - 8) / 2
                                    ? fin[i]
                                    : fin[i] === " "
                                      ? " "
                                      : CH[(Math.random() * CH.length) | 0];
                        }
                        el.textContent = out;
                        if (f++ < total) setTimeout(tick, 34);
                        else el.textContent = fin;
                    })();
                })();

                /* terminal typing — markup มีเนื้อหาอยู่แล้ว ถ้าจะพิมพ์ใหม่ค่อยล้าง */
                (function () {
                    const TERM = [
                        ["cmd", "kubectl get nodes -o wide"],
                        [
                            "out",
                            "NAME         STATUS   ROLES                AGE    VERSION",
                        ],
                        [
                            "out",
                            "k3s-cp-01    Ready    control-plane,etcd   88d    v1.30.4+k3s1",
                        ],
                        [
                            "out",
                            "k3s-cp-02    Ready    control-plane,etcd   88d    v1.30.4+k3s1",
                        ],
                        [
                            "out",
                            "k3s-cp-03    Ready    control-plane,etcd   88d    v1.30.4+k3s1",
                        ],
                        [
                            "out",
                            "k3s-worker-01 Ready    worker               88d    v1.30.4+k3s1",
                        ],
                        [
                            "out",
                            "k3s-worker-02 Ready    worker               88d    v1.30.4+k3s1",
                        ],
                        [
                            "cmd",
                            "kubectl get pods -A --no-headers | grep -c Running",
                        ],
                        ["out", "14"],
                        ["cmd", "curl -s https://app.traipoap.com/healthz"],
                        ["ok", '{"status":"ok"}'],
                        ["dim", "────────────────────────────────────────────"],
                        [
                            "dim",
                            "แพลตฟอร์มที่คุณกำลังดู คือผลลัพธ์ของคำสั่งด้านบน ✓",
                        ],
                    ];
                    const body = $("#term");
                    if (!body || REDUCED) return;
                    body.innerHTML = "";
                    function line(cls, txt) {
                        const d = document.createElement("div");
                        d.className = "tl-" + cls;
                        d.textContent = txt;
                        body.appendChild(d);
                        return d;
                    }
                    (async () => {
                        await wait(500);
                        for (const l of TERM) {
                            if (l[0] === "cmd") {
                                const d = line("cmd", "");
                                for (const ch of l[1]) {
                                    d.textContent += ch;
                                    await wait(22 + Math.random() * 22);
                                }
                                await wait(320);
                            } else {
                                line(l[0], l[1]);
                                await wait(
                                    l[0] === "out" && l[1].startsWith("NAME")
                                        ? 260
                                        : 140,
                                );
                            }
                        }
                        const c = document.createElement("div");
                        c.className = "tl-cmd";
                        c.innerHTML = '<span class="caret"></span>';
                        body.appendChild(c);
                    })();
                })();

                /* arch layer sync — เลือก card ที่ center ใกล้เคียงกับกลางจอที่สุด
                   (ใช้ scroll handler แทน IntersectionObserver: band แคบ 16% +
                   event batching ของ IO ทำให้ card สั้น ๆ อย่าง LAYER 02 โดนข้าม
                   ตอนไถเร็ว ตอนนี้ลำดับ 01→02→03→04 ติดกันเสมอ) */
                const archSvg = $("#archSvg"),
                    cards = $$(".layer-card");
                if (archSvg && cards.length) {
                    let ticking = false;
                    const sync = () => {
                        ticking = false;
                        const mid = innerHeight / 2;
                        let best = null,
                            bestD = Infinity;
                        for (const c of cards) {
                            const r = c.getBoundingClientRect();
                            if (r.bottom < 0 || r.top > innerHeight) continue;
                            const d = Math.abs((r.top + r.bottom) / 2 - mid);
                            if (d < bestD) {
                                bestD = d;
                                best = c;
                            }
                        }
                        if (!best) return; // ไม่มี card ในจอ — คงสถานะเดิม
                        archSvg.dataset.active = best.dataset.layer;
                        cards.forEach((c) =>
                            c.classList.toggle("on", c === best),
                        );
                    };
                    addEventListener(
                        "scroll",
                        () => {
                            if (!ticking) {
                                ticking = true;
                                requestAnimationFrame(sync);
                            }
                        },
                        { passive: true },
                    );
                    sync();
                }

                /* tabs */
                $$(".tab").forEach((b) =>
                    b.addEventListener("click", () => {
                        $$(".tab").forEach((x) => x.classList.remove("on"));
                        b.classList.add("on");
                        $$(".codep").forEach((p) =>
                            p.classList.toggle(
                                "on",
                                p.dataset.p === b.dataset.t,
                            ),
                        );
                    }),
                );

                /* pipeline — live data from GitHub (public repo traipoap/app) */
                const GH = "https://api.github.com/repos/traipoap/app";
                let pipeBusy = false,
                    pipeLoaded = false;
                const btnPipe = $("#btnPipe"),
                    logBox = $("#pipeLog"),
                    timeEl = $("#pipeTime"),
                    commitEl = $("#pipeCommit"),
                    runLink = $("#pipeRunLink");
                function esc(s) {
                    return String(s ?? "").replace(
                        /[&<>"']/g,
                        (c) =>
                            ({
                                "&": "&amp;",
                                "<": "&lt;",
                                ">": "&gt;",
                                '"': "&quot;",
                                "'": "&#39;",
                            })[c],
                    );
                }
                function durMS(a, b) {
                    const d = Date.parse(b) - Date.parse(a);
                    return d > 0 ? d : 0;
                }
                function fmtDur(ms) {
                    const s = Math.round(ms / 1000);
                    return Math.floor(s / 60) + "m " + pad(s % 60) + "s";
                }
                function clock(iso) {
                    return new Date(iso).toLocaleTimeString("th-TH", {
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit",
                    });
                }
                function logLine(text, cls) {
                    const t = new Date().toLocaleTimeString("th-TH", {
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit",
                    });
                    logBox.insertAdjacentHTML(
                        "beforeend",
                        '<div><span class="lt">[' +
                            t +
                            "]</span>" +
                            (cls
                                ? '<span class="' +
                                  cls +
                                  '">' +
                                  text +
                                  "</span>"
                                : text) +
                            "</div>",
                    );
                    logBox.scrollTop = logBox.scrollHeight;
                }
                async function gh(path) {
                    const res = await fetch(GH + path, {
                        headers: { Accept: "application/vnd.github+json" },
                    });
                    if (res.status === 403 || res.status === 429)
                        throw new Error(
                            "ถูก rate limit ของ GitHub — ลองใหม่ในสักครู่",
                        );
                    if (!res.ok) throw new Error("HTTP " + res.status);
                    return res.json();
                }
                async function loadLivePipeline() {
                    if (pipeBusy) return;
                    pipeBusy = true;
                    if (btnPipe) {
                        btnPipe.disabled = true;
                        btnPipe.textContent = "⟳ กำลังโหลด…";
                    }
                    try {
                        // 1) run ล่าสุดของ pipeline (security → build → trivy → push)
                        const runs = await gh("/actions/runs?per_page=30");
                        const all = runs.workflow_runs || [];
                        const run =
                            all.find((r) =>
                                String(r.name || "").startsWith("Pipeline"),
                            ) || all[0];
                        if (!run)
                            throw new Error(
                                "ยังไม่มี run ของ pipeline ใน repo",
                            );
                        if (runLink) runLink.href = run.html_url;

                        // 2) jobs + commit ของ run นั้น
                        const jobs =
                            (
                                await gh(
                                    `/actions/runs/${run.id}/jobs?per_page=30`,
                                )
                            ).jobs || [];
                        let commit = null;
                        try {
                            commit = await gh(`/commits/${run.head_sha}`);
                        } catch {
                            commit = null;
                        }

                        // header: commit จริง + เวลาทั้งหมดจริง
                        const sha = String(run.head_sha || "").slice(0, 7);
                        const msg =
                            (commit && commit.commit.message) ||
                            (run.head_commit && run.head_commit.message) ||
                            "";
                        const author =
                            (commit && commit.author && commit.author.login) ||
                            (run.actor && run.actor.login) ||
                            "—";
                        if (commitEl)
                            commitEl.innerHTML =
                                'commit <span class="hash">' +
                                esc(sha) +
                                "</span> · <b>" +
                                esc(String(msg).split("\n")[0]) +
                                "</b> · " +
                                esc(author) +
                                " → " +
                                esc(run.head_branch || "main");
                        const total = durMS(run.created_at, run.updated_at);
                        if (timeEl) timeEl.textContent = fmtDur(total);

                        // steps: status จริงของแต่ละ job
                        const done = jobs.filter((j) => j.conclusion).length;
                        const dots = ["⇪", "✓", "✓", "▣", "▣", "▣", "⟳", "⇧"];
                        const stepsBox = $("#steps");
                        if (stepsBox) {
                            stepsBox.innerHTML =
                                '<i id="pipeFill"></i>' +
                                jobs
                                    .map((j, i) => {
                                        const c = j.conclusion || "pending";
                                        const cls =
                                            c === "success"
                                                ? "ok"
                                                : c === "failure"
                                                  ? "bad"
                                                  : c === "skipped"
                                                    ? "skip"
                                                    : "run";
                                        const label =
                                            c === "success"
                                                ? "✓ " +
                                                  fmtDur(
                                                      durMS(
                                                          j.started_at,
                                                          j.completed_at,
                                                      ),
                                                  )
                                                : c === "failure"
                                                  ? "✗ failed"
                                                  : c === "skipped"
                                                    ? "⊘ skipped"
                                                    : "กำลังทำงาน…";
                                        return (
                                            '<div class="step ' +
                                            cls +
                                            '"><span class="dot">' +
                                            (dots[i] || "·") +
                                            "</span><b>" +
                                            esc(j.name) +
                                            "</b><em>" +
                                            label +
                                            "</em></div>"
                                        );
                                    })
                                    .join("");
                            const fillEl = document.getElementById("pipeFill");
                            if (fillEl)
                                fillEl.style.width = jobs.length
                                    ? Math.round((done / jobs.length) * 84) +
                                      "%"
                                    : "0";
                        }

                        // log: job-by-job + ลิงก์ run
                        logBox.innerHTML = "";
                        logLine(
                            "workflow #" +
                                run.run_number +
                                " · " +
                                esc(run.event) +
                                " · เริ่ม " +
                                clock(run.created_at),
                        );
                        for (const j of jobs) {
                            const d = fmtDur(
                                durMS(j.started_at, j.completed_at),
                            );
                            if (j.conclusion === "success")
                                logLine(
                                    esc(j.name) + " → ✓ ผ่าน (" + d + ")",
                                    "ok",
                                );
                            else if (j.conclusion === "failure")
                                logLine(
                                    esc(j.name) + " → ✗ failed (" + d + ")",
                                    "err",
                                );
                            else if (j.conclusion === "skipped")
                                logLine(
                                    esc(j.name) +
                                        " → ⊘ skipped (path ไม่เปลี่ยน)",
                                );
                            else logLine(esc(j.name) + " → กำลังทำงาน…");
                        }
                        const ok = run.conclusion === "success";
                        logLine(
                            "pipeline " +
                                (ok ? "สำเร็จ" : run.conclusion || "กำลังรัน") +
                                " · เวลาทั้งหมด " +
                                fmtDur(total) +
                                ' · <a href="' +
                                esc(run.html_url) +
                                '" target="_blank" rel="noopener">ดู run บน GitHub ↗</a>',
                            ok ? "ok" : "err",
                        );
                        pipeLoaded = true;
                    } catch (err) {
                        logBox.innerHTML = "";
                        logLine(
                            "โหลดข้อมูลจาก GitHub ไม่สำเร็จ — " +
                                (err && err.message ? err.message : ""),
                            "err",
                        );
                        logLine("กด ⟳ รีเฟรช เพื่อลองอีกครั้ง");
                    } finally {
                        pipeBusy = false;
                        if (btnPipe) {
                            btnPipe.disabled = false;
                            btnPipe.textContent = "⟳ รีเฟรช";
                        }
                    }
                }
                if (btnPipe)
                    btnPipe.addEventListener("click", loadLivePipeline);
                new IntersectionObserver(
                    (es) => {
                        es.forEach((e) => {
                            if (e.isIntersecting && !pipeLoaded)
                                loadLivePipeline();
                        });
                    },
                    { threshold: 0.3 },
                ).observe($(".pipe-panel"));

                /* gitops sync demo */
                const btnSync = $("#btnSync");
                if (btnSync)
                    btnSync.addEventListener("click", async function () {
                        this.disabled = true;
                        this.textContent = "SYNC…";
                        $("#certBadge").textContent = "SYNCING";
                        await wait(REDUCED ? 50 : 2600);
                        $("#certBadge").className = "badge sync";
                        $("#certBadge").textContent = "SYNCED";
                        $("#certSync").textContent = "เมื่อสักครู่";
                        this.textContent = "✓ แล้ว";
                        toast(
                            "✓ kiali synced — image ใหม่เข้าคลัสเตอร์เรียบร้อย",
                        );
                    });

                /* sparkline charts */
                function spark(canvas, color, valEl, min, max, start, fmt) {
                    if (!canvas) return;
                    const ctx = canvas.getContext("2d"),
                        N = 64;
                    let data = Array.from({ length: N }, () => start),
                        v = start;
                    function size() {
                        const r = canvas.getBoundingClientRect(),
                            d = devicePixelRatio || 1;
                        canvas.width = Math.max(10, r.width * d);
                        canvas.height = Math.max(10, r.height * d);
                        ctx.setTransform(d, 0, 0, d, 0, 0);
                    }
                    size();
                    addEventListener("resize", size);
                    function draw() {
                        const r = canvas.getBoundingClientRect(),
                            w = r.width,
                            h = r.height;
                        ctx.clearRect(0, 0, w, h);
                        ctx.strokeStyle = "rgba(140,190,210,.1)";
                        ctx.lineWidth = 1;
                        for (let i = 1; i < 4; i++) {
                            ctx.beginPath();
                            ctx.moveTo(0, (h / 4) * i);
                            ctx.lineTo(w, (h / 4) * i);
                            ctx.stroke();
                        }
                        ctx.beginPath();
                        data.forEach((val, i) => {
                            const x = (i / (N - 1)) * w,
                                y =
                                    h -
                                    ((val - min) / (max - min)) * (h - 8) -
                                    4;
                            i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
                        });
                        ctx.strokeStyle = color;
                        ctx.lineWidth = 1.8;
                        ctx.stroke();
                        ctx.lineTo(w, h);
                        ctx.lineTo(0, h);
                        ctx.closePath();
                        const g = ctx.createLinearGradient(0, 0, 0, h);
                        g.addColorStop(0, color + "33");
                        g.addColorStop(1, color + "00");
                        ctx.fillStyle = g;
                        ctx.fill();
                        const ly =
                            h -
                            ((data[N - 1] - min) / (max - min)) * (h - 8) -
                            4;
                        ctx.fillStyle = color;
                        ctx.beginPath();
                        ctx.arc(w - 3, ly, 3, 0, 7);
                        ctx.fill();
                    }
                    draw();
                    if (REDUCED) {
                        valEl.textContent = fmt(start);
                        return;
                    }
                    setInterval(() => {
                        v = Math.min(
                            max,
                            Math.max(
                                min,
                                v + (Math.random() - 0.5) * (max - min) * 0.09,
                            ),
                        );
                        data.push(v);
                        data.shift();
                        draw();
                        valEl.textContent = fmt(v);
                    }, 750);
                }
                spark(
                    $("#cvCpu"),
                    "#34d399",
                    $("#cpuVal"),
                    0,
                    100,
                    36,
                    (v) => v.toFixed(0) + "%",
                );
                spark(
                    $("#cvMem"),
                    "#4cc2ff",
                    $("#memVal"),
                    0,
                    100,
                    58,
                    (v) => v.toFixed(0) + "%",
                );
                spark(
                    $("#cvNet"),
                    "#fbbf24",
                    $("#netVal"),
                    0,
                    200,
                    74,
                    (v) => v.toFixed(0) + " Mb/s",
                );

                /* latency — ค่าจริง: ใช้ response duration ของ initial
                   document จาก Resource Timing (fallback: HEAD ไปที่หน้าเดียวกัน) */
                (function () {
                    const el = $("#lat");
                    if (!el) return;
                    const show = (ms: number) =>
                        (el.textContent =
                            "~ " + (ms < 1 ? "1" : Math.round(ms)) + " ms");
                    try {
                        const entries = performance.getEntriesByType(
                            "resource",
                        ) as PerformanceResourceTiming[];
                        const doc = entries.find(
                            (e) =>
                                e.name.indexOf(location.origin) === 0 &&
                                e.responseEnd > 0,
                        );
                        if (doc) {
                            show(doc.responseEnd - doc.startTime);
                            return;
                        }
                    } catch {
                        /* timing unavailable → ใช้ fallback ด้านล่าง */
                    }
                    const t0 = performance.now();
                    fetch(location.href, { method: "HEAD", cache: "no-store" })
                        .catch(() => undefined)
                        .finally(() => show(performance.now() - t0 - 40));
                })();
            } catch (err) {
                /* สคริปต์พัง → ปิดโหมดแอนิเมชัน เนื้อหาทุกส่วนกลับมาแสดงครบ */
                document.documentElement.classList.remove("js");
                console.error("portfolio script fallback:", err);
            }
        })();
    </script>
</Layout>
