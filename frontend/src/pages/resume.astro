    </style>

    <!-- Sheet + dynamic entry styles must be global: they target nodes
         created at runtime (no data-astro-cid attribute). -->
    <style is:global>
        /* ═══════════ A4 sheet (screen) ═══════════ */
        .cv-sheet {
            --cv-accent: #6366f1;
            width: 210mm;
            color: #1f2937;
            font-family:
                "Inter",
                system-ui,
                -apple-system,
                "Segoe UI",
                sans-serif;
            font-size: 13px;
            line-height: 1.5;
            transform-origin: top center;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            position: relative;
        }

        /* One card per printed A4 page — the preview is the print.
           (named .cv-a4 to avoid clashing with the outer .cv-page layout) */
        .cv-a4 {
            position: relative;
            min-height: 296.8mm;
            padding: 14mm 15mm;
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 24px 64px rgba(2, 6, 16, 0.55);
        }

        .cv-a4 + .cv-a4 {
            margin-top: 30px;
        }

        .cv-a4-num {
            position: absolute;
            top: -11px;
            right: 14px;
            background: #4f46e5;
            color: #ffffff;
            font:
                600 11px/1 "Inter",
                system-ui,
                sans-serif;
            padding: 3px 9px;
            border-radius: 999px;
            letter-spacing: 0.02em;
        }

        /* Offscreen measurement context, same box as a page's content. */
        .cv-measure {
            position: absolute;
            top: 0;
            left: -4000px;
            width: 100%;
            padding: 14mm 15mm;
            visibility: hidden;
            pointer-events: none;
        }

        .cv-sheet-head {
            margin-bottom: 4px;
        }

        .cv-headbar {
            width: 52px;
            height: 4px;
            border-radius: 2px;
            background: var(--cv-accent);
            margin-bottom: 16px;
        }

        .cv-name {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #0f172a;
            line-height: 1.15;
        }

        .cv-roletitle {
            margin-top: 3px;
            font-size: 15px;
            font-weight: 600;
            color: var(--cv-accent);
        }

        .cv-contact {
            margin-top: 12px;
            font-size: 11.5px;
            color: #475569;
        }

        .cv-contact .sep {
            margin: 0 8px;
            color: #cbd5e1;
        }

        .cv-sheet-head.has-photo {
            display: flex;
            align-items: flex-start;
            gap: 22px;
        }

        .cv-head-text {
            flex: 1;
            min-width: 0;
        }

        .cv-photo {
            width: 88px;
            height: 88px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            flex: none;
        }

        .cv-cols {
            display: grid;
            grid-template-columns: 1.55fr 1fr;
            gap: 4px 36px;
            align-items: start;
        }

        .cv-col-side .cv-chip {
            font-size: 11px;
            padding: 2px 10px;
        }

        .cv-col-side .cv-pairgrid {
            grid-template-columns: 1fr;
        }

        /* Narrow side column: stack name over meta instead of one cramped row. */
        .cv-col-side .cv-pair {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
        }

        .cv-col-side .cv-pair-meta {
            font-size: 11px;
        }

        /* ═══════════ ATS / AI template — plain, parser-friendly ═══════════ */
        .cv-sheet.ats {
            --cv-accent: #111827;
            font-size: 13.5px;
            line-height: 1.55;
        }

        .cv-sheet.ats .cv-headbar {
            display: none;
        }

        .cv-sheet.ats .cv-photo {
            display: none;
        }

        .cv-sheet.ats .cv-name {
            font-size: 32px;
            letter-spacing: -0.01em;
        }

        .cv-sheet.ats .cv-contact {
            font-size: 12px;
            color: #374151;
        }

        .cv-sheet.ats .cv-section {
            margin-top: 18px;
        }

        .cv-sheet.ats .cv-section h3 {
            font-size: 12px;
            letter-spacing: 0.12em;
