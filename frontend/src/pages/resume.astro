        // ── Form → state sync (static fields) ──────────────────────────
        function bindStaticFields() {
            form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
                "[data-field]:not([data-list])",
            ).forEach((input) => {
                const field = input.dataset.field as keyof CVData;
                input.value = String(
                    (data as unknown as Record<string, unknown>)[field] ?? "",
                );
            });
        }

        // ── Account sync (per-account CV stored via the backend) ──────
        function getToken() {
            return (
                window.sessionStorage.getItem("authToken") ||
                window.localStorage.getItem("authToken")
            );
        }

        function getRefreshToken() {
            return (
                window.sessionStorage.getItem("refreshToken") ||
                window.localStorage.getItem("refreshToken")
            );
        }

        async function tryRefreshToken() {
            const refreshToken = getRefreshToken();
            if (!refreshToken) return false;
            try {
                const res = await fetch("/api/auth/refresh", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ refresh_token: refreshToken }),
                });
                if (!res.ok) return false;
                const body = await res.json();
                if (body.token) {
                    window.localStorage.setItem("authToken", body.token);
                    // Refresh tokens are rotated (single-use) — persist the
                    // new one so the next refresh doesn't use the stale token.
                    if (body.refresh_token)
                        window.localStorage.setItem(
                            "refreshToken",
                            body.refresh_token,
                        );
                    return true;
                }
                return false;
            } catch {
                return false;
            }
        }

        async function authenticatedFetch(
            url: string,
            options: RequestInit = {},
        ) {
            const res = await fetch(url, {
                ...options,
                headers: {
                    ...(options.headers || {}),
                    Authorization: `Bearer ${getToken()}`,
                },
            });
            if (res.status === 401) {
                const refreshed = await tryRefreshToken();
                if (refreshed) {
                    return await fetch(url, {
                        ...options,
                        headers: {
                            ...(options.headers || {}),
                            Authorization: `Bearer ${getToken()}`,
                        },
                    });
                }
            }
            return res;
        }

        // ── Versioned CV store ─────────────────────────────────────────
        // The account blob holds every named version of the CV:
        //   { v: 2, active: "DevOps", versions: { "DevOps": CV, ... } }
        // `versions` mirrors the blob in memory; `activeName` is the
        // version the form currently works on (null = new, unsaved).
        const clone = <T,>(x: T): T => JSON.parse(JSON.stringify(x)) as T;
        let versions: Record<string, CVData> = {};
        let activeName: string | null = null;

        function toBlob(): unknown {
            const all: Record<string, CVData> = {};
            for (const [k, v] of Object.entries(versions)) all[k] = clone(v);
            if (activeName) all[activeName] = clone(data);
            return { v: 2, active: activeName, versions: all };
        }

        async function persist(): Promise<boolean> {
            try {
                if (!Object.keys(versions).length && !activeName) {
                    const res = await authenticatedFetch("/api/resume", {
                        method: "DELETE",
                    });
                    return res.ok || res.status === 404;
                }
                const res = await authenticatedFetch("/api/resume", {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ data: toBlob() }),
                });
                return res.ok;
            } catch {
                return false;
            }
        }

        // Autosave path: only sync when the form is attached to a named
        // version — a brand-new draft must not create ghost versions.
        async function pushToAccount(): Promise<boolean> {
            if (!activeName) return false;
            return persist();
        }

        function applyData(next: CVData) {
            data = next;
            form.querySelectorAll<HTMLButtonElement>(".swatch").forEach((s) =>
                s.classList.toggle(
                    "is-active",
                    s.dataset.accent === data.accent,
                ),
            );
            syncTemplateButtons();
            renderPhotoPreview();
            bindStaticFields();
            renderAllLists();
            syncBreakButtons();
            renderSheet();
        }

        // Fetch the account blob and adopt every stored version.
        async function loadAccountStore(): Promise<boolean> {
            try {
                const res = await authenticatedFetch("/api/resume");
                if (!res.ok) return false;
                const body = await res.json();
                const blob = body.data as {
                    v?: unknown;
                    active?: unknown;
                    versions?: unknown;
                } | null;
                if (!blob || typeof blob !== "object") return false;
                versions = {};
                if (
                    blob.v === 2 &&
                    blob.versions &&
                    typeof blob.versions === "object"
                ) {
                    for (const [k, cv] of Object.entries(
                        blob.versions as Record<string, unknown>,
                    )) {
                        const n = normalizeDraft(cv);
                        if (n) versions[k] = n;
                    }
                } else {
                    // Legacy single-CV blob — adopt it as version "Resume".
                    const n = normalizeDraft(blob);
                    if (n) versions.Resume = n;
                }
                let name: string | null = null;
                if (typeof blob.active === "string" && versions[blob.active])
                    name = blob.active;
                if (!name) name = Object.keys(versions)[0] ?? null;
                if (!name || !versions[name]) return false;
                activeName = name;
                applyData(clone(versions[name]));
                // Keep a local offline cache of the account copy.
                try {
                    window.localStorage.setItem(
                        DRAFT_KEY,
                        JSON.stringify(data),
                    );
                } catch {
                    // Offline cache is best-effort.
                }
                return true;
            } catch {
                return false;
            }
        }

        function loadVersion(name: string): boolean {
            if (!versions[name]) return false;
            activeName = name;
            applyData(clone(versions[name]));
            syncVersionUI();
            return true;
        }

        function syncVersionUI() {
            const sel = document.getElementById(
                "cvVersions",
            ) as HTMLSelectElement | null;
            if (!sel) return;
            const keys = Object.keys(versions);
            sel.length = 0;
            for (const k of keys) sel.add(new Option(k, k));
            sel.value = activeName && versions[activeName] ? activeName : "";
            const del = document.querySelector<HTMLButtonElement>(
                '[data-action="delete"]',
            );
            if (del) del.disabled = !activeName;
        }

        // ── Autosave ───────────────────────────────────────
        let saveTimer: number | undefined;
        // Skip the next autosave — used right after an explicit "delete" so
        // the cleared form doesn't get re-pushed to the account.
        let suppressAutosave = false;
        function scheduleSave() {
            if (suppressAutosave) {
                suppressAutosave = false;
                return;
            }
            window.clearTimeout(saveTimer);
            saveTimer = window.setTimeout(async () => {
                const t = new Date().toLocaleTimeString([], {
                    hour: "2-digit",
                    minute: "2-digit",
                });
                let localOk = false;
                try {
                    window.localStorage.setItem(
                        DRAFT_KEY,
                        JSON.stringify(data),
                    );
                    localOk = true;
                } catch {
                    // Storage full or blocked — the account copy below still saves.
                }
                if (!activeName) {
                    draftStatus.style.color = "";
                    draftStatus.textContent = `Saved locally at ${t} — new version: press "บันทึก" to store it in your account.`;
                    return;
                }
                draftStatus.style.color = "";
                draftStatus.textContent = "Saving to your account…";
                const synced = await pushToAccount();
                if (synced) {
                    draftStatus.style.color = "";
                    draftStatus.textContent = `Saved to your account as "${activeName}" at ${t}. In the print dialog choose “Save as PDF”.`;
                } else if (localOk) {
                    draftStatus.style.color = "";
                    draftStatus.textContent = `Saved locally at ${t} — couldn't reach your account (check connection).`;
                } else {
                    draftStatus.style.color = "var(--danger)";
                    draftStatus.textContent =
                        "Could not save the draft — storage blocked and account sync failed.";
                }
            }, 400);
        }

        function onStateChange() {
            renderSheet();
            scheduleSave();
        }

        function syncBreakButtons() {
            form.querySelectorAll<HTMLButtonElement>("[data-break]").forEach(
                (b) => {
                    const key = b.dataset.break;
                    b.setAttribute(
                        "aria-pressed",
                        String(key ? data.breaks[key] === true : false),
                    );
                },
            );
        }

        // ── Events ─────────────────────────────────────────────────────
        form.addEventListener("submit", (e) => e.preventDefault());

        form.addEventListener("input", (e) => {
            const t = e.target as HTMLElement;
            if (t instanceof HTMLTextAreaElement) {
                t.style.height = "auto";
                t.style.height = t.scrollHeight + "px";
            }
            const field = t.dataset?.field;
            if (!field) return;
            const list = t.dataset?.list as keyof CVData | undefined;
            const isCheck =
                t instanceof HTMLInputElement && t.type === "checkbox";
            const value = isCheck
                ? t.checked
                : (
                      t as
                          | HTMLInputElement
                          | HTMLTextAreaElement
                          | HTMLSelectElement
                  ).value;
            if (list && Array.isArray(data[list])) {
                const idx = Number(t.dataset?.index);
                const item = (
                    data[list] as unknown as Record<string, unknown>[]
                )[idx];
                if (item) {
                    item[field] = value;
                    if (field === "current") {
                        const entryEl = t.closest(".entry");
                        const endInput = entryEl?.querySelector(
                            '[data-field="end"]',
                        ) as HTMLInputElement | null;
                        if (endInput) endInput.disabled = Boolean(value);
                    }
                    onStateChange();
                }
            } else if (!list) {
                (data as unknown as Record<string, unknown>)[field] = value;
                onStateChange();
            }
        });

        const ENTRY_BOXES: Record<string, string> = {
            experience: "experienceEntries",
            projects: "projectEntries",
            education: "educationEntries",
            languages: "languageEntries",
            certifications: "certEntries",
        };

        function focusNewEntry(key: string) {
            const box = document.getElementById(ENTRY_BOXES[key]);
            const last = box?.querySelector<HTMLElement>(".entry:last-child");
            if (!last) return;
            last.scrollIntoView({ behavior: "smooth", block: "center" });
            const first = last.querySelector<HTMLElement>(
                "input:not([type=checkbox]), textarea, select",
            );
            first?.focus({ preventScroll: true });
        }

        form.addEventListener("click", async (e) => {
            const target = e.target as HTMLElement;

            const add = target.closest<HTMLButtonElement>("[data-add]");
            if (add) {
                const key = add.dataset.add as keyof CVData;
                const factories: Record<string, () => unknown> = {
                    experience: blankExperience,
                    projects: blankProject,
                    education: blankEducation,
                    languages: blankLanguage,
                    certifications: blankCert,
                };
                (data[key] as unknown[]).push(factories[key]());
                renderAllLists();
                focusNewEntry(key);
                onStateChange();
                return;
            }

            const remove = target.closest<HTMLButtonElement>("[data-remove]");
            if (remove) {
                const key = remove.dataset.remove as keyof CVData;
                const idx = Number(remove.dataset.index);
                (data[key] as unknown[]).splice(idx, 1);
                renderAllLists();
                onStateChange();
                return;
            }

            // Per-section "start on new page" toggles.
            const brk = target.closest<HTMLButtonElement>("[data-break]");
            if (brk) {
                const key = brk.dataset.break;
                if (key) {
                    data.breaks[key] = !data.breaks[key];
                    if (!data.breaks[key]) delete data.breaks[key];
                    brk.setAttribute(
                        "aria-pressed",
                        String(Boolean(data.breaks[key])),
                    );
                }
                onStateChange();
                return;
            }

            // The photo remove button lives inside the form, not the toolbar.
            if (target.closest("[data-action='photo-remove']")) {
                data.photo = null;
                renderPhotoPreview();
                onStateChange();
                return;
            }

            const chipRemove = target.closest<HTMLButtonElement>(
                "[data-skill-remove]",
            );
            if (chipRemove) {
                const skill = chipRemove.dataset.skillRemove;
                data.skills = data.skills.filter((s) => s !== skill);
                renderSkills();
                onStateChange();
            }
        });

        // Skills: Enter / comma / Tab commits the token.
        const skillInput = document.getElementById(
            "skillInput",
        ) as HTMLInputElement;
        function commitSkill() {
            const raw = skillInput.value.trim().replace(/,+$/, "");
            if (!raw) return;
            for (const piece of raw.split(",")) {
                const s = piece.trim();
                if (
                    s &&
                    !data.skills.some(
                        (x) => x.toLowerCase() === s.toLowerCase(),
                    )
                )
                    data.skills.push(s);
            }
            skillInput.value = "";
            renderSkills();
            onStateChange();
        }
        skillInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === ",") {
                e.preventDefault();
                commitSkill();
            } else if (
                e.key === "Backspace" &&
                !skillInput.value &&
                data.skills.length
            ) {
                data.skills.pop();
                renderSkills();
                onStateChange();
            }
        });
        skillInput.addEventListener("blur", () => {
            if (skillInput.value.trim()) commitSkill();
        });

        // ── Photo ──────────────────────────────────────────────────────
        const photoFile = document.getElementById(
            "photoFile",
        ) as HTMLInputElement;
        const photoPreview = document.getElementById(
            "photoPreview",
        ) as HTMLElement;
        const photoRemove = document.getElementById(
            "photoRemove",
        ) as HTMLElement;

        function renderPhotoPreview() {
            if (data.photo) {
                photoPreview.replaceChildren(
                    el("img", { src: data.photo, alt: "Profile" }),
                );
                photoRemove.hidden = false;
            } else {
                photoPreview.replaceChildren();
                photoRemove.hidden = true;
            }
        }

        function fileToDataUrl(file: File): Promise<string> {
            return new Promise((resolve, reject) => {
                const url = URL.createObjectURL(file);
                const img = new Image();
                img.onload = () => {
                    URL.revokeObjectURL(url);
                    const max = 480;
                    const ratio = Math.min(
                        1,
                        max / Math.max(img.width, img.height),
                    );
                    const w = Math.max(1, Math.round(img.width * ratio));
                    const h = Math.max(1, Math.round(img.height * ratio));
                    const canvas = document.createElement("canvas");
                    canvas.width = w;
                    canvas.height = h;
                    const ctx = canvas.getContext("2d");
                    if (!ctx) {
                        reject(new Error("Canvas is not supported"));
                        return;
                    }
                    ctx.fillStyle = "#ffffff";
                    ctx.fillRect(0, 0, w, h);
                    ctx.drawImage(img, 0, 0, w, h);
                    resolve(canvas.toDataURL("image/jpeg", 0.9));
                };
                img.onerror = () => {
                    URL.revokeObjectURL(url);
                    reject(new Error("Could not read the image"));
                };
                img.src = url;
            });
        }

        if (photoFile) {
            photoFile.addEventListener("change", async () => {
                const file = photoFile.files?.[0];
                photoFile.value = "";
                if (!file) return;
                if (!file.type.startsWith("image/")) {
                    alert("Please choose an image file (JPG or PNG).");
                    return;
                }
                try {
                    data.photo = await fileToDataUrl(file);
                    renderPhotoPreview();
                    onStateChange();
                } catch {
                    alert("Sorry, that image could not be processed.");
                }
            });
        }

        function syncTemplateButtons() {
            document
                .querySelectorAll<HTMLButtonElement>(".seg-btn")
                .forEach((b) =>
                    b.classList.toggle(
                        "is-active",
                        b.dataset.template === data.template,
                    ),
                );
        }

        // Toolbar.
        document
            .querySelector<HTMLElement>(".cv-toolbar")
            ?.addEventListener("click", async (e) => {
                const target = e.target as HTMLElement;

                const templateBtn =
                    target.closest<HTMLButtonElement>("[data-template]");
                if (templateBtn) {
                    const t = templateBtn.dataset.template;
                    data.template =
                        t === "classic" || t === "ats" ? t : "modern";
                    syncTemplateButtons();
                    onStateChange();
                    return;
                }

                const swatch =
                    target.closest<HTMLButtonElement>("[data-accent]");
                if (swatch) {
                    data.accent = swatch.dataset.accent!;
                    document
                        .querySelectorAll<HTMLButtonElement>(".swatch")
                        .forEach((s) =>
                            s.classList.toggle("is-active", s === swatch),
                        );
                    onStateChange();
                    return;
                }

                const action =
                    target.closest<HTMLButtonElement>("[data-action]")?.dataset
                        .action;
                if (action === "export") {
                    renderSheet();
                    window.print();
                } else if (action === "clear") {
                    if (
                        confirm(
                            "Start a new CV? Your current draft will be cleared.",
                        )
                    ) {
                        data = defaultData();
                        document
                            .querySelectorAll<HTMLButtonElement>(".swatch")
                            .forEach((s, i) =>
                                s.classList.toggle("is-active", i === 0),
                            );
                        syncTemplateButtons();
                        renderPhotoPreview();
                        bindStaticFields();
                        renderAllLists();
                        syncBreakButtons();
                        onStateChange();
                        activeName = null; // cleared form = fresh, unsaved version
                        syncVersionUI();
                    }
                } else if (action === "save") {
                    const raw = window.prompt(
                        "ตั้งชื่อเวอร์ชันนี้ (เช่น DevOps, General, Thai)",
                        activeName ?? "",
                    );
                    if (raw === null) return;
                    const name = raw.trim();
                    if (!name) {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            "ต้องตั้งชื่อเวอร์ชันก่อนบันทึก";
                        return;
                    }
                    if (
                        versions[name] &&
                        activeName !== name &&
                        !window.confirm(
                            `มีเวอร์ชัน "${name}" อยู่แล้ว — ต้องการเขียนทับไหม?`,
                        )
                    )
                        return;
                    draftStatus.style.color = "";
                    draftStatus.textContent = "กำลังบันทึก…";
                    versions[name] = clone(data);
                    activeName = name;
                    const ok = await persist();
                    syncVersionUI();
                    if (ok) {
                        const t = new Date().toLocaleTimeString([], {
                            hour: "2-digit",
                            minute: "2-digit",
                        });
                        draftStatus.style.color = "";
                        draftStatus.textContent = `บันทึกเป็นเวอร์ชัน "${name}" แล้ว เมื่อ ${t}`;
                    } else {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            "บันทึกไม่สำเร็จ — ลองอีกครั้ง";
                    }
                } else if (action === "load") {
                    const keys = Object.keys(versions);
                    if (!keys.length) {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            'ยังไม่มีเวอร์ชันที่บันทึกไว้ — กด "บันทึก" ก่อน';
                        return;
                    }
                    let name =
                        activeName && versions[activeName]
                            ? activeName
                            : keys[0];
                    if (keys.length > 1) {
                        const answer = window.prompt(
                            "โหลดเวอร์ชันไหน?\n" +
                                keys
                                    .map(
                                        (k, i) =>
                                            `${i + 1}. ${k}${k === name ? " (ปัจจุบัน)" : ""}`,
                                    )
                                    .join("\n"),
                            String(keys.indexOf(name) + 1),
                        );
                        if (answer === null) return;
                        const idx = Number(answer) - 1;
                        if (
                            !Number.isInteger(idx) ||
                            idx < 0 ||
                            idx >= keys.length
                        )
                            return;
                        name = keys[idx];
                    }
                    if (loadVersion(name)) {
                        draftStatus.style.color = "";
                        draftStatus.textContent = `โหลดเวอร์ชัน "${name}" แล้ว`;
                    }
                } else if (action === "delete") {
                    const keys = Object.keys(versions);
                    if (!keys.length) {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            "ยังไม่มีเวอร์ชันที่บันทึกไว้";
                        return;
                    }
                    const target =
                        activeName && versions[activeName]
                            ? activeName
                            : keys[0];
                    if (!window.confirm(`ลบเวอร์ชัน "${target}" ออกจากบัญชี?`))
                        return;
                    delete versions[target];
                    if (activeName === target) activeName = null;
                    draftStatus.style.color = "";
                    draftStatus.textContent = "กำลังลบ…";
                    const ok = await persist();
                    if (ok) {
                        if (
                            activeName === null &&
                            !Object.keys(versions).length
                        ) {
                            // No versions left — drop the offline cache too so a
                            // stale local draft can't resurrect on next boot.
                            try {
                                window.localStorage.removeItem(DRAFT_KEY);
                            } catch {
                                // best-effort
                            }
                            applyData(defaultData());
                        }
                        syncVersionUI();
                        draftStatus.style.color = "";
                        draftStatus.textContent = `ลบเวอร์ชัน "${target}" แล้ว`;
                    } else {
                        syncVersionUI();
                        draftStatus.style.color = "var(--danger)";
