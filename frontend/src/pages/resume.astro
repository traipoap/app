        const LEVELS = [
            "Native",
            "Fluent",
            "Professional",
            "Intermediate",
            "Basic",
        ];

        function renderLanguages() {
            const box = document.getElementById("languageEntries");
            if (!box) return;
            box.replaceChildren(
                ...data.languages.map((l, i) => {
                    const select = document.createElement("select");
                    for (const lv of LEVELS)
                        select.append(el("option", { value: lv }, lv));
                    // Preserve custom levels (e.g. "Working proficiency") from drafts.
                    if (l.level && !LEVELS.includes(l.level))
                        select.append(
                            el("option", { value: l.level }, l.level),
                        );
                    select.value = l.level || "Fluent";
                    select.dataset.list = "languages";
                    select.dataset.index = String(i);
                    select.dataset.field = "level";
                    return entryShell(
                        "languages",
                        i,
                        fieldRow(
                            "Language",
                            Object.assign(
                                textInput("languages", i, "name", "Thai"),
                                { value: l.name },
                            ),
                            "Level",
                            select,
                        ),
                    );
                }),
            );
            if (!box.childElementCount)
                box.append(
                    el(
                        "p",
                        { class: "entry-empty" },
                        "No languages yet — add what you work in.",
                    ),
                );
        }

