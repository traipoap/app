        }

        .cv-para {
            color: #334155;
        }

        .cv-entry {
            margin-bottom: 12px;
        }

        .cv-entry:last-child {
            margin-bottom: 0;
        }

        .cv-entry-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 12px;
        }

        .cv-entry-role {
            font-size: 13.5px;
            font-weight: 700;
            color: #0f172a;
        }

        .cv-entry-company {
