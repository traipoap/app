            gap: 6px;
        }

        .cv-chip {
            padding: 3px 11px;
            border-radius: 999px;
            background: #eef2ff;
            background: color-mix(in srgb, var(--cv-accent) 9%, white);
            border: 1px solid #c7d2fe;
            border-color: color-mix(in srgb, var(--cv-accent) 28%, white);
