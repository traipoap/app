                            ),
                            "Company",
                            Object.assign(
                                textInput(
                                    "experience",
                                    i,
                                    "company",
                                    "Acme Corp",
                                ),
                                { value: e.company },
                            ),
                        ),
                        fieldRow(
                            "Location",
                            Object.assign(
                                textInput(
                                    "experience",
                                    i,
                                    "location",
                                    "Bangkok",
                                ),
                                { value: e.location },
                            ),
                        ),
                        fieldRow(
