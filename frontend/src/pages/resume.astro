        // ── Events ─────────────────────────────────────────────────────
        form.addEventListener("submit", (e) => e.preventDefault());

        form.addEventListener("input", (e) => {
            const t = e.target as HTMLElement;
            if (t instanceof HTMLTextAreaElement) {
                t.style.height = "auto";
                t.style.height = t.scrollHeight + "px";
            }
            const field = t.dataset?.field;
            if (!field) return;
            const list = t.dataset?.list as keyof CVData | undefined;
            const isCheck =
                t instanceof HTMLInputElement && t.type === "checkbox";
            const value = isCheck
                ? t.checked
                : (
                      t as
                          | HTMLInputElement
                          | HTMLTextAreaElement
                          | HTMLSelectElement
                  ).value;
            if (list && Array.isArray(data[list])) {
                const idx = Number(t.dataset?.index);
                const item = (
                    data[list] as unknown as Record<string, unknown>[]
                )[idx];
                if (item) {
                    item[field] = value;
                    if (field === "current") {
                        const entryEl = t.closest(".entry");
                        const endInput = entryEl?.querySelector(
                            '[data-field="end"]',
                        ) as HTMLInputElement | null;
                        if (endInput) endInput.disabled = Boolean(value);
                    }
                    onStateChange();
                }
            } else if (!list) {
                (data as unknown as Record<string, unknown>)[field] = value;
                onStateChange();
            }
        });

        const ENTRY_BOXES: Record<string, string> = {
