            "photoRemove",
        ) as HTMLElement;

        function renderPhotoPreview() {
            if (data.photo) {
                photoPreview.replaceChildren(
                    el("img", { src: data.photo, alt: "Profile" }),
                );
                photoRemove.hidden = false;
            } else {
                photoPreview.replaceChildren();
                photoRemove.hidden = true;
            }
        }

        function fileToDataUrl(file: File): Promise<string> {
            return new Promise((resolve, reject) => {
                const url = URL.createObjectURL(file);
                const img = new Image();
                img.onload = () => {
                    URL.revokeObjectURL(url);
                    const max = 480;
                    const ratio = Math.min(
                        1,
                        max / Math.max(img.width, img.height),
                    );
                    const w = Math.max(1, Math.round(img.width * ratio));
                    const h = Math.max(1, Math.round(img.height * ratio));
                    const canvas = document.createElement("canvas");
                    canvas.width = w;
                    canvas.height = h;
                    const ctx = canvas.getContext("2d");
                    if (!ctx) {
                        reject(new Error("Canvas is not supported"));
                        return;
                    }
                    ctx.fillStyle = "#ffffff";
                    ctx.fillRect(0, 0, w, h);
                    ctx.drawImage(img, 0, 0, w, h);
                    resolve(canvas.toDataURL("image/jpeg", 0.9));
                };
                img.onerror = () => {
                    URL.revokeObjectURL(url);
                    reject(new Error("Could not read the image"));
                };
                img.src = url;
            });
        }

        if (photoFile) {
            photoFile.addEventListener("change", async () => {
                const file = photoFile.files?.[0];
                photoFile.value = "";
                if (!file) return;
                if (!file.type.startsWith("image/")) {
                    alert("Please choose an image file (JPG or PNG).");
                    return;
                }
                try {
                    data.photo = await fileToDataUrl(file);
                    renderPhotoPreview();
                    onStateChange();
                } catch {
                    alert("Sorry, that image could not be processed.");
                }
            });
        }

        function syncTemplateButtons() {
            document
                .querySelectorAll<HTMLButtonElement>(".seg-btn")
                .forEach((b) =>
                    b.classList.toggle(
                        "is-active",
                        b.dataset.template === data.template,
                    ),
                );
        }

        // Toolbar.
        document
            .querySelector<HTMLElement>(".cv-toolbar")
            ?.addEventListener("click", async (e) => {
                const target = e.target as HTMLElement;

                const templateBtn =
                    target.closest<HTMLButtonElement>("[data-template]");
                if (templateBtn) {
                    const t = templateBtn.dataset.template;
                    data.template =
                        t === "classic" || t === "ats" ? t : "modern";
                    syncTemplateButtons();
                    onStateChange();
                    return;
                }

                const swatch =
                    target.closest<HTMLButtonElement>("[data-accent]");
                if (swatch) {
                    data.accent = swatch.dataset.accent!;
                    document
                        .querySelectorAll<HTMLButtonElement>(".swatch")
                        .forEach((s) =>
                            s.classList.toggle("is-active", s === swatch),
                        );
                    onStateChange();
                    return;
                }

                const action =
                    target.closest<HTMLButtonElement>("[data-action]")?.dataset
                        .action;
                if (action === "export") {
                    renderSheet();
                    window.print();
                } else if (action === "clear") {
                    if (
                        confirm(
                            "Start a new CV? Your current draft will be cleared.",
                        )
                    ) {
                        data = defaultData();
                        document
                            .querySelectorAll<HTMLButtonElement>(".swatch")
                            .forEach((s, i) =>
                                s.classList.toggle("is-active", i === 0),
                            );
                        syncTemplateButtons();
                        renderPhotoPreview();
                        bindStaticFields();
                        renderAllLists();
                        syncBreakButtons();
                        onStateChange();
                        activeName = null; // cleared form = fresh, unsaved version
                        syncVersionUI();
                    }
                } else if (action === "save") {
                    const raw = window.prompt(
                        "ตั้งชื่อเวอร์ชันนี้ (เช่น DevOps, General, Thai)",
                        activeName ?? "",
                    );
                    if (raw === null) return;
                    const name = raw.trim();
                    if (!name) {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            "ต้องตั้งชื่อเวอร์ชันก่อนบันทึก";
                        return;
                    }
                    if (
                        versions[name] &&
                        activeName !== name &&
                        !window.confirm(
                            `มีเวอร์ชัน "${name}" อยู่แล้ว — ต้องการเขียนทับไหม?`,
                        )
                    )
                        return;
                    draftStatus.style.color = "";
                    draftStatus.textContent = "กำลังบันทึก…";
                    versions[name] = clone(data);
                    activeName = name;
                    const ok = await persist();
                    syncVersionUI();
                    if (ok) {
                        const t = new Date().toLocaleTimeString([], {
                            hour: "2-digit",
                            minute: "2-digit",
                        });
                        draftStatus.style.color = "";
                        draftStatus.textContent = `บันทึกเป็นเวอร์ชัน "${name}" แล้ว เมื่อ ${t}`;
                    } else {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            "บันทึกไม่สำเร็จ — ลองอีกครั้ง";
                    }
                } else if (action === "load") {
                    const keys = Object.keys(versions);
                    if (!keys.length) {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            'ยังไม่มีเวอร์ชันที่บันทึกไว้ — กด "บันทึก" ก่อน';
                        return;
                    }
                    let name =
                        activeName && versions[activeName]
                            ? activeName
                            : keys[0];
                    if (keys.length > 1) {
                        const answer = window.prompt(
                            "โหลดเวอร์ชันไหน?\n" +
                                keys
                                    .map(
                                        (k, i) =>
                                            `${i + 1}. ${k}${k === name ? " (ปัจจุบัน)" : ""}`,
                                    )
                                    .join("\n"),
                            String(keys.indexOf(name) + 1),
                        );
                        if (answer === null) return;
                        const idx = Number(answer) - 1;
                        if (
                            !Number.isInteger(idx) ||
                            idx < 0 ||
                            idx >= keys.length
                        )
                            return;
                        name = keys[idx];
                    }
                    if (loadVersion(name)) {
                        draftStatus.style.color = "";
                        draftStatus.textContent = `โหลดเวอร์ชัน "${name}" แล้ว`;
                    }
                } else if (action === "delete") {
                    const keys = Object.keys(versions);
                    if (!keys.length) {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            "ยังไม่มีเวอร์ชันที่บันทึกไว้";
                        return;
                    }
                    const target =
                        activeName && versions[activeName]
                            ? activeName
                            : keys[0];
                    if (!window.confirm(`ลบเวอร์ชัน "${target}" ออกจากบัญชี?`))
                        return;
                    delete versions[target];
                    if (activeName === target) activeName = null;
                    draftStatus.style.color = "";
                    draftStatus.textContent = "กำลังลบ…";
                    const ok = await persist();
                    if (ok) {
                        if (
                            activeName === null &&
                            !Object.keys(versions).length
                        ) {
                            // No versions left — drop the offline cache too so a
                            // stale local draft can't resurrect on next boot.
                            try {
                                window.localStorage.removeItem(DRAFT_KEY);
                            } catch {
                                // best-effort
                            }
                            applyData(defaultData());
                        }
                        syncVersionUI();
                        draftStatus.style.color = "";
                        draftStatus.textContent = `ลบเวอร์ชัน "${target}" แล้ว`;
                    } else {
                        syncVersionUI();
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent = "ลบไม่สำเร็จ — ลองอีกครั้ง";
                    }
                } else if (action === "publish") {
                    const keys = Object.keys(versions);
                    if (!keys.length) {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            'ยังไม่มีเวอร์ชันที่บันทึกไว้ — กด "บันทึก" อย่างน้อยหนึ่งเวอร์ชัน (เช่น EN, TH) ก่อน แล้วค่อย Publish"';
                        return;
                    }
                    if (
                        !window.confirm(
                            `เผยแพร่เวอร์ชัน ${keys.length} (เช่น ${keys.join(", ")}) ไปยังหน้า /cv เพื่อใช้? ` +
                                "(จะทับข้อมูลสาธารณะปัจจุบัน)",
                        )
                    )
                        return;
                    draftStatus.style.color = "";
                    draftStatus.textContent = "กำลังเผยแพร่…";
                    const res = await authenticatedFetch(
                        "/api/resume/published",
                        {
                            method: "PUT",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ data: toBlob() }),
                        },
                    );
                    if (res.ok) {
                        setPublishedState(true);
                        const t = new Date().toLocaleTimeString([], {
                            hour: "2-digit",
                            minute: "2-digit",
                        });
                        draftStatus.style.color = "";
                        draftStatus.textContent = `เผยแพร่แล้ว เมื่อ ${t} — ดูได้ที่ app.traipoap.com/cv`;
                    } else {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            "เผยแพร่ไม่สำเร็จ — ลองอีกครั้ง";
                    }
                } else if (action === "unpublish") {
                    if (
                        !window.confirm(
                            "ยกเลิกการเผยแพร่? หน้า /cv จะกลับไปใช้ข้อมูลตัวอย่าง",
                        )
                    )
                        return;
                    draftStatus.style.color = "";
                    draftStatus.textContent = "กำลังยกเลิกการเผยแพร่…";
                    const res = await authenticatedFetch(
                        "/api/resume/published",
                        { method: "DELETE" },
                    );
                    if (res.ok || res.status === 404) {
                        setPublishedState(false);
                        draftStatus.style.color = "";
                        draftStatus.textContent =
                            "ยกเลิกการเผยแพร่แล้ว — หน้า /cv ใช้ข้อมูลตัวอย่าง";
                    } else {
                        draftStatus.style.color = "var(--danger)";
                        draftStatus.textContent =
                            "ยกเลิกการเผยแพร่ไม่สำเร็จ — ลองอีกครั้ง";
                    }
                } else if (action === "sample-en" || action === "sample-th") {
                    const isTH = action === "sample-th";
                    if (
                        isTH
                            ? confirm(
                                  "แทนที่ข้อมูลปัจจุบันด้วยโปรไฟล์ (เวอร์ชันภาษาไทย)?",
                              )
                            : confirm(
                                  "Replace the current form with the saved profile (Traipoap Hunthong)?",
                              )
                    ) {
                        data = isTH ? sampleDataTH() : sampleDataEN();
                        activeName = null; // sample = fresh working copy
                        syncVersionUI();
                        syncTemplateButtons();
                        renderPhotoPreview();
                        bindStaticFields();
                        renderAllLists();
                        syncBreakButtons();
                        onStateChange();
                    }
                }
            });

        // Picking a version from the toolbar menu loads it into the form.
        document
            .getElementById("cvVersions")
            ?.addEventListener("change", (e) => {
                const name = (e.target as HTMLSelectElement).value;
                if (name && versions[name]) {
                    loadVersion(name);
                    draftStatus.style.color = "";
                    draftStatus.textContent = `โหลดเวอร์ชัน "${name}" แล้ว`;
                }
            });

        // ── Boot ─────────────────────────────────────────────────────────────
        if (restoredDraft)
            draftStatus.textContent =
                "Restored your saved draft. In the print dialog choose “Save as PDF”.";
        syncTemplateButtons();
        renderPhotoPreview();
        bindStaticFields();
        renderAllLists();
        syncBreakButtons();
        renderSheet();
        syncVersionUI();

        // Sync with the account: the backend is the source of truth for the
        // saved versions; a local draft is a fallback that gets migrated to
        // the account as version "Resume".
        void (async () => {
            // Reflect the current public state in the toolbar.
            try {
                const res = await fetch("/api/resume/published");
                setPublishedState(res.ok);
            } catch {
                // Backend unreachable — assume unpublished.
            }

            const fromAccount = await loadAccountStore();
            syncVersionUI();
            if (fromAccount && activeName) {
                draftStatus.style.color = "";
                draftStatus.textContent = `Loaded "${activeName}" from your account. In the print dialog choose “Save as PDF”.`;
                return;
            }
            if (!restoredDraft) return;
            const hasContent =
                data.name.trim() !== "" ||
                data.summary.trim() !== "" ||
                data.experience.some(
                    (e) => e.role.trim() !== "" || e.company.trim() !== "",
                ) ||
                data.projects.length > 0;
            if (!hasContent) return;
            versions.Resume = clone(data);
            activeName = "Resume";
            if (await persist()) {
                syncVersionUI();
                draftStatus.style.color = "";
                draftStatus.textContent =
                    'Migrated your local draft to your account as version "Resume".';
            }
        })();

        const ro = new ResizeObserver(() => fitSheet());
        ro.observe(previewPane);
        window.addEventListener("resize", fitSheet);
    </script>
