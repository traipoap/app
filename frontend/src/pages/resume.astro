---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="CV Builder — LUMINA"
    description="Build a polished, ATS-friendly CV with live A4 preview and one-click PDF export."
>
    <!-- Client-side route protection: any authenticated role sees their own CV -->
    <script>
        (function protectRoute() {
            if (typeof window === "undefined") return;
            const token =
                window.sessionStorage.getItem("authToken") ||
                window.localStorage.getItem("authToken");
            if (!token) {
                setTimeout(function () {
                    window.location.href = "/signin";
                }, 100);
            }
        })();
    </script>
    <div class="cv-page">
        <header class="cv-head">
            <div>
                <p class="cv-eyebrow">LUMINA · Tools</p>
                <h1 class="cv-title">CV Builder</h1>
                <p class="cv-sub">
                    Fill the form — the A4 preview updates live. Export a
                    print-perfect PDF in one click.
                </p>
                <a href="/" class="cv-xlink">
                    Want the full story? → See the portfolio
                </a>
            </div>
            <div class="cv-toolbar">
                <div
                    class="cv-swatches"
                    role="group"
                    aria-label="CV accent color"
                >
                    <button
                        type="button"
                        class="swatch is-active"
                        data-accent="#6366f1"
                        style="background: #6366f1"
                        title="Indigo"
                    ></button>
                    <button
                        type="button"
                        class="swatch"
                        data-accent="#0e7490"
                        style="background: #0e7490"
                        title="Cyan"
                    ></button>
                    <button
                        type="button"
                        class="swatch"
                        data-accent="#047857"
                        style="background: #047857"
                        title="Emerald"
                    ></button>
                    <button
                        type="button"
                        class="swatch"
                        data-accent="#be123c"
                        style="background: #be123c"
                        title="Rose"
                    ></button>
                    <button
                        type="button"
                        class="swatch"
                        data-accent="#334155"
                        style="background: #334155"
                        title="Graphite"
                    ></button>
                </div>
                <div class="cv-seg" role="group" aria-label="CV template">
                    <button
                        type="button"
                        class="seg-btn"
                        data-template="classic"
                    >
                        Classic
                    </button>
                    <button
                        type="button"
                        class="seg-btn is-active"
                        data-template="modern"
                    >
                        Modern
                    </button>
                    <button
                        type="button"
                        class="seg-btn"
                        data-template="ats"
                        title="Plain single-column layout — optimized for ATS parsers & AI screening"
                    >
                        ATS
                    </button>
                </div>
                <select
                    id="cvVersions"
                    class="cv-select"
                    title="เวอร์ชัน resume ที่บันทึกไว้ในบัญชี — เลือกเพื่อโหลด"
                    aria-label="เลือกเวอร์ชัน resume"
                ></select>
                <button
                    type="button"
                    class="cv-btn"
                    data-action="sample-en"
                    title="โหลดโปรไฟล์เป็นภาษาอังกฤษ"
                >
                    Load my data · EN
                </button>
                <button
                    type="button"
                    class="cv-btn"
                    data-action="sample-th"
                    title="โหลดโปรไฟล์เป็นภาษาไทย"
                >
                    โหลดข้อมูลของฉัน · TH
                </button>
                <button type="button" class="cv-btn" data-action="clear">
                    New
                </button>
                <button
                    type="button"
                    class="cv-btn"
                    data-action="save"
                    title="บันทึกข้อมูลปัจจุบันไว้ในบัญชีของคุณ"
                >
                    บันทึก
                </button>
                <button
                    type="button"
                    class="cv-btn"
                    data-action="load"
                    title="โหลดข้อมูลที่บันทึกไว้ในบัญชีของคุณ"
                >
                    โหลด
                </button>
                <button
                    type="button"
                    class="cv-btn cv-btn-danger"
                    data-action="delete"
                    title="ลบข้อมูล resume ที่บันทึกไว้ในบัญชี (ล้างฟอร์มปัจจุบันด้วย)"
                >
                    ลบ
                </button>
                <span class="cv-page-badge" id="pageBadge">
                    1 page
                </span>
                <button
                    type="button"
                    class="cv-btn cv-btn-primary"
                    data-action="export"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Export PDF
                </button>
            </div>
            <p class="cv-hint" id="draftStatus" role="status">
                Draft auto-saves in this browser. In the print dialog choose
                “Save as PDF”.
            </p>
        </header>

        <div class="cv-workspace">
            <!-- ── Form ─────────────────────────────────────────────── -->
            <form class="cv-form" id="cvForm" autocomplete="off" novalidate>
                <section class="cv-card">
                    <div class="cv-card-head">
                        <h2>Identity</h2>
                        <p>How recruiters see you at a glance.</p>
                    </div>
                    <div class="cv-photo-row">
                        <div class="cv-photo-preview" id="photoPreview"></div>
                        <div class="cv-photo-actions">
                            <label class="cv-btn" for="photoFile">
                                Upload photo
                            </label>
                            <button
                                type="button"
                                class="cv-btn"
                                data-action="photo-remove"
                                id="photoRemove"
                                hidden
                            >
                                Remove
                            </button>
                            <span class="cv-photo-hint">
                                Stored only in this browser — not sent anywhere.
                                The ATS template hides photos for parser
                                compatibility.
                            </span>
                        </div>
                        <input
                            type="file"
                            id="photoFile"
                            accept="image/*"
                            hidden
                        />
                    </div>
                    <div class="cv-grid2">
                        <div class="cv-field">
                            <label for="fName">Full name</label>
                            <input
                                id="fName"
                                data-field="name"
                                type="text"
                                placeholder="Karn Thanachote"
                            />
                        </div>
                        <div class="cv-field">
                            <label for="fTitle">Job title</label>
                            <input
                                id="fTitle"
                                data-field="title"
                                type="text"
                                placeholder="Senior Site Reliability Engineer"
                            />
                        </div>
                        <div class="cv-field">
                            <label for="fEmail">Email</label>
                            <input
                                id="fEmail"
                                data-field="email"
                                type="email"
                                placeholder="you@example.com"
                            />
                        </div>
                        <div class="cv-field">
                            <label for="fPhone">Phone</label>
                            <input
                                id="fPhone"
                                data-field="phone"
                                type="tel"
                                placeholder="+66 89 123 4567"
                            />
                        </div>
                        <div class="cv-field">
                            <label for="fLocation">Location</label>
                            <input
                                id="fLocation"
                                data-field="location"
                                type="text"
                                placeholder="Bangkok, Thailand"
                            />
                        </div>
                        <div class="cv-field">
                            <label for="fWebsite">Website</label>
                            <input
                                id="fWebsite"
                                data-field="website"
                                type="text"
                                placeholder="yoursite.dev"
                                spellcheck="false"
                                autocapitalize="off"
                            />
                        </div>
                        <div class="cv-field">
                            <label for="fGithub">GitHub</label>
                            <input
                                id="fGithub"
                                data-field="github"
                                type="text"
                                placeholder="github.com/you"
                                spellcheck="false"
                                autocapitalize="off"
                            />
                        </div>
                        <div class="cv-field">
                            <label for="fLinkedin">LinkedIn</label>
                            <input
                                id="fLinkedin"
                                data-field="linkedin"
                                type="text"
                                placeholder="linkedin.com/in/you"
                            />
                        </div>
                    </div>
                </section>

                <section class="cv-card">
                    <div class="cv-card-head">
                        <div>
                            <h2>Summary</h2>
                            <p>
                                2–3 sentences: who you are, your edge, your
                                impact.
                            </p>
                        </div>
                        <button
                            type="button"
                            class="cv-pagebreak"
                            data-break="Profile"
                            aria-pressed="false"
                            title="Start the Profile section on a new page"
                        >
                            ⏎ New page
                        </button>
                    </div>
                    <div class="cv-field">
                        <textarea
                            id="fSummary"
                            data-field="summary"
                            rows="4"
                            placeholder="SRE with 8+ years of experience… led migration of 40+ services to Kubernetes, cutting infra cost 32%…"
                        ></textarea>
                    </div>
                </section>

                <section class="cv-card">
                    <div class="cv-card-head">
                        <div>
                            <h2>
                                Experience
                                <span class="cv-count" id="count-experience">
                                    0
                                </span>
                            </h2>
                            <p>
                                One line per bullet — start with a strong verb.
                            </p>
                        </div>
                        <button
                            type="button"
                            class="cv-pagebreak"
                            data-break="Experience"
                            aria-pressed="false"
                            title="Start this section on a new page"
                        >
                            ⏎ New page
                        </button>
                    </div>
                    <div class="cv-entries" id="experienceEntries"></div>
                    <button type="button" class="cv-add" data-add="experience">
                        + Add experience
                    </button>
                </section>

                <section class="cv-card">
                    <div class="cv-card-head">
                        <div>
                            <h2>
                                Projects
                                <span class="cv-count" id="count-projects">
                                    0
                                </span>
                            </h2>
                            <p>Side projects, OSS, or things you shipped.</p>
                        </div>
                        <button
                            type="button"
                            class="cv-pagebreak"
                            data-break="Projects"
                            aria-pressed="false"
                            title="Start this section on a new page"
                        >
                            ⏎ New page
                        </button>
                    </div>
                    <div class="cv-entries" id="projectEntries"></div>
                    <button type="button" class="cv-add" data-add="projects">
                        + Add project
                    </button>
                </section>

                <section class="cv-card">
                    <div class="cv-card-head">
                        <div>
                            <h2>
                                Education
                                <span class="cv-count" id="count-education">
                                    0
                                </span>
                            </h2>
                            <p>Degree, school and period.</p>
                        </div>
                        <button
                            type="button"
                            class="cv-pagebreak"
                            data-break="Education"
                            aria-pressed="false"
                            title="Start this section on a new page"
                        >
                            ⏎ New page
                        </button>
                    </div>
                    <div class="cv-entries" id="educationEntries"></div>
                    <button type="button" class="cv-add" data-add="education">
                        + Add education
                    </button>
                </section>

                <section class="cv-card">
                    <div class="cv-card-head">
                        <div>
                            <h2>
                                Skills
                                <span class="cv-count" id="count-skills">
                                    0
                                </span>
                            </h2>
                            <p>A short list of what you're strong at.</p>
                        </div>
                        <button
                            type="button"
                            class="cv-pagebreak"
                            data-break="Skills"
                            aria-pressed="false"
                            title="Start this section on a new page"
                        >
                            ⏎ New page
                        </button>
                    </div>
                    <div class="cv-chips-wrap">
                        <div class="cv-chipbox" id="skillChips"></div>
                        <input
                            id="skillInput"
                            type="text"
                            placeholder="e.g. Kubernetes — then press Enter"
                            aria-label="Add skill"
                            autocomplete="off"
                        />
                    </div>
                    <p class="cv-chip-hint">
                        Enter or comma to add · Backspace removes the last one
                    </p>
                </section>

                <section class="cv-card">
                    <div class="cv-card-head">
                        <div>
                            <h2>
                                Languages
                                <span class="cv-count" id="count-languages">
                                    0
                                </span>
                            </h2>
                            <p>Language + proficiency.</p>
                        </div>
                        <button
                            type="button"
                            class="cv-pagebreak"
                            data-break="Languages"
                            aria-pressed="false"
                            title="Start this section on a new page"
                        >
                            ⏎ New page
                        </button>
                    </div>
                    <div class="cv-entries" id="languageEntries"></div>
                    <button type="button" class="cv-add" data-add="languages">
                        + Add language
                    </button>
                </section>

                <section class="cv-card">
                    <div class="cv-card-head">
                        <div>
                            <h2>
                                Certifications
                                <span
                                    class="cv-count"
                                    id="count-certifications"
                                >
                                    0
                                </span>
                            </h2>
                            <p>Optional — only if they carry weight.</p>
                        </div>
                        <button
                            type="button"
                            class="cv-pagebreak"
                            data-break="Certifications"
                            aria-pressed="false"
                            title="Start this section on a new page"
                        >
                            ⏎ New page
                        </button>
                    </div>
                    <div class="cv-entries" id="certEntries"></div>
                    <button
                        type="button"
                        class="cv-add"
                        data-add="certifications"
                    >
                        + Add certification
                    </button>
                </section>
            </form>

            <!-- ── Live preview ─────────────────────────────────────── -->
            <div class="cv-preview" id="cvPreview">
                <div class="cv-sheet-wrap" id="sheetWrap">
                    <article
                        class="cv-sheet"
                        id="cvSheet"
                        aria-label="CV preview"
                    ></article>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ── Types ──────────────────────────────────────────────────────
        interface ExperienceItem {
            id: string;
            role: string;
            company: string;
            location: string;
            start: string;
            end: string;
            current: boolean;
            description: string;
        }
        interface ProjectItem {
            id: string;
            name: string;
            link: string;
            description: string;
        }
        interface EducationItem {
            id: string;
            degree: string;
            school: string;
            start: string;
            end: string;
        }
        interface LanguageItem {
            id: string;
            name: string;
            level: string;
        }
        interface CertificationItem {
            id: string;
            name: string;
            issuer: string;
            year: string;
        }
        interface CVData {
            name: string;
            title: string;
            email: string;
            phone: string;
            location: string;
            website: string;
            github: string;
            linkedin: string;
            summary: string;
            experience: ExperienceItem[];
            projects: ProjectItem[];
            education: EducationItem[];
            skills: string[];
            languages: LanguageItem[];
            certifications: CertificationItem[];
            accent: string;
            photo: string | null;
            template: "classic" | "modern" | "ats";
            breaks: Record<string, boolean>;
        }

        // ── State ──────────────────────────────────────────────────────
        const DRAFT_KEY = "lumina.cv.draft.v1";
        const SHEET_W = (210 / 25.4) * 96; // A4 width @96dpi ≈ 793.7
        const PAGE_CAP = (269 / 25.4) * 96 - 4; // A4 content height (297 − 28mm) − 4px slack

        const uid = () =>
            typeof crypto !== "undefined" && "randomUUID" in crypto
                ? crypto.randomUUID()
                : "id-" + Math.random().toString(36).slice(2, 10);

        const blankExperience = (): ExperienceItem => ({
            id: uid(),
            role: "",
            company: "",
            location: "",
            start: "",
            end: "",
            current: false,
            description: "",
        });
        const blankProject = (): ProjectItem => ({
            id: uid(),
            name: "",
            link: "",
            description: "",
        });
        const blankEducation = (): EducationItem => ({
            id: uid(),
            degree: "",
            school: "",
            start: "",
            end: "",
        });
        const blankLanguage = (): LanguageItem => ({
            id: uid(),
            name: "",
            level: "Fluent",
        });
        const blankCert = (): CertificationItem => ({
            id: uid(),
            name: "",
            issuer: "",
            year: "",
        });

        function defaultData(): CVData {
            return {
                name: "",
                title: "",
                email: "",
                phone: "",
                location: "",
                website: "",
                github: "",
                linkedin: "",
                summary: "",
                experience: [blankExperience()],
                projects: [],
                education: [blankEducation()],
                skills: [],
                languages: [blankLanguage()],
                certifications: [],
                accent: "#6366f1",
                photo: null,
                template: "modern",
                breaks: {},
            };
        }

        function normalizeDraft(d: unknown): CVData | null {
            if (!d || typeof d !== "object") return null;
            const obj = d as CVData;
            if (typeof obj.name !== "string" || !Array.isArray(obj.experience))
                return null;
            // Merge over the current shape so older drafts keep working.
            return {
                ...defaultData(),
                ...obj,
                summary: typeof obj.summary === "string" ? obj.summary : "",
                photo: typeof obj.photo === "string" ? obj.photo : null,
                template:
                    obj.template === "classic" || obj.template === "ats"
                        ? obj.template
                        : "modern",
                breaks:
                    obj.breaks && typeof obj.breaks === "object"
                        ? (obj.breaks as Record<string, boolean>)
                        : {},
            };
        }

        function loadDraft(): CVData | null {
            try {
                const raw = window.localStorage.getItem(DRAFT_KEY);
                if (!raw) return null;
                return normalizeDraft(JSON.parse(raw));
            } catch {
                return null;
            }
        }

        const restored = loadDraft();
        let data: CVData = restored ?? defaultData();
        const restoredDraft = restored !== null;

        // ── DOM helpers (all user content is escaped via text nodes) ──
        function el<K extends keyof HTMLElementTagNameMap>(
            tag: K,
            attrs?: Record<string, string | boolean | number | null> | null,
            ...children: Array<Node | string | null | undefined>
        ): HTMLElementTagNameMap[K] {
            const node = document.createElement(tag);
            if (attrs) {
                for (const [key, value] of Object.entries(attrs)) {
                    if (
                        value === null ||
                        value === false ||
                        value === undefined
                    )
                        continue;
                    if (key === "class") node.className = String(value);
                    else if (value === true) node.setAttribute(key, "");
                    else node.setAttribute(key, String(value));
                }
            }
            for (const child of children) {
                if (child === null || child === undefined) continue;
                node.append(
                    child instanceof Node
                        ? child
                        : document.createTextNode(String(child)),
                );
            }
            return node;
        }

        function bullets(text: string): string[] {
            return text
                .split("\n")
                .map((s) => s.trim())
                .filter(Boolean);
        }

        function entryDate(start: string, end: string, current?: boolean) {
            const to = current ? "Present" : end.trim();
            if (start.trim() && to) return `${start.trim()} — ${to}`;
            return start.trim() || to || "";
        }

        // ── Elements ───────────────────────────────────────────────────
        const form = document.getElementById("cvForm") as HTMLFormElement;
        const sheet = document.getElementById("cvSheet") as HTMLElement;
        const sheetWrap = document.getElementById("sheetWrap") as HTMLElement;
        const previewPane = document.getElementById("cvPreview") as HTMLElement;
        const draftStatus = document.getElementById(
            "draftStatus",
        ) as HTMLElement;

        // ── Preview rendering ──────────────────────────────────────────
        type Sec = {
            col: "main" | "side";
            title: string;
            kind: "single" | "entry" | "pair";
            nodes: Node[];
        };

        type Unit = {
            node: Node;
            section: string;
            heading: boolean;
            kind: "heading" | "single" | "entry" | "pair";
        };

        type Measured = Unit & { h: number; t: number; b: number };

        // Greedy A4 pagination with the same keep-together rules as print:
        // headings stay with their first item, entries/pairs are not split.
        // `used` always includes the last box's trailing margin (collapsed
        // against the next), matching how the browser sizes a page — this
        // keeps the final line away from the printed page edge.
        function paginate(
            ms: Measured[],
            cap: number,
            firstOffset = 0,
            topMargin = 0,
            forceBreak: (title: string) => boolean = () => false,
        ): Measured[][] {
            const pages: Measured[][] = [];
            let cur: Measured[] = [];
            let used = firstOffset;
            let lastB = topMargin;
            const cost = (m: Measured, pending: number) =>
                Math.max(pending, m.t) - pending + m.h + m.b;
            const add = (m: Measured) => {
                used += cost(m, lastB);
                cur.push(m);
                lastB = m.b;
            };
            const flush = () => {
                if (cur.length) pages.push(cur);
                cur = [];
                used = 0;
                lastB = 0;
            };
            let i = 0;
            while (i < ms.length) {
                const m = ms[i];
                // An explicit "start on new page" wins over packing heuristics.
                if (m.heading && cur.length > 0 && forceBreak(m.section))
                    flush();
                const pair = m.heading && i + 1 < ms.length ? ms[i + 1] : null;
                const unitCost = cost(m, lastB) + (pair ? cost(pair, m.b) : 0);
                // Only force a page break if the pair actually fits a fresh page.
                const pairFitsPage =
                    !pair ||
                    m.t + m.h + Math.max(m.b, pair.t) + pair.h + pair.b <=
                        cap + 0.5;
                if (cur.length && unitCost > cap - used && pairFitsPage)
                    flush();
                add(m);
                if (pair) {
                    add(pair);
                    i++;
                }
                i++;
            }
            flush();
            return pages;
        }

        // Height of a page's units (same collapse model as paginate).
        function pageCost(ms: Measured[]): number {
            let used = 0;
            let lastB = 0;
            for (const m of ms) {
                used += Math.max(lastB, m.t) - lastB + m.h + m.b;
                lastB = m.b;
            }
            return used;
        }

        // A final page carrying only a sliver of content reads as an
        // accident — pull it back when the previous page genuinely has room.
        function rescueOrphan(
            pages: Measured[][],
            cap: number,
            forceBreak: (title: string) => boolean,
        ): Measured[][] {
            if (pages.length < 2) return pages;
            const last = pages[pages.length - 1];
            const prev = pages[pages.length - 2];
            if (!last || !prev) return pages;
            // Respect an explicit "start on new page" on that section.
            const first = last[0];
            const forced = first && first.heading && forceBreak(first.section);
            if (
                !forced &&
                last.length <= 4 &&
                pageCost(prev) + pageCost(last) <= cap + 0.5
            ) {
                prev.push(...last);
                pages.pop();
            }
            return pages;
        }

        // A section split across pages so that only its last item lands on
        // the new page reads as an accident — move the whole section there
        // (heading + items stay together).
        function pullSplitSection(pages: Measured[][]): Measured[][] {
            for (let p = pages.length - 1; p >= 1; p--) {
                const page = pages[p];
                const prev = pages[p - 1];
                if (!page.length || !prev.length) continue;
                const first = page[0];
                if (first.heading) continue; // section starts fresh — fine
                if (page.length !== 1) continue; // more content follows
                const idx = prev.findIndex((u) => u.section === first.section);
                if (idx === -1) continue;
                // A split section is always the last one on the previous page.
                const moved = prev.splice(idx);
                page.unshift(...moved);
            }
            return pages.filter((page) => page.length > 0);
        }

        // Group a page's units back into <section> blocks; a section that
        // continues onto a new page simply re-opens without its heading.
        function renderSectioned(ms: Measured[]): Node[] {
            const out: Node[] = [];
            let sec: HTMLElement | null = null;
            let curTitle = "";
            let run: Measured[] = [];
            const flushRun = () => {
                const target = sec;
                if (!run.length || !target) {
                    run = [];
                    return;
                }
                const nodes = run.map((m) => m.node);
                if (run[0].kind === "entry")
                    target.append(el("div", null, ...nodes));
                else if (run[0].kind === "pair")
                    target.append(
                        el("div", { class: "cv-pairgrid" }, ...nodes),
                    );
                else nodes.forEach((n) => target.append(n));
                run = [];
            };
            for (const m of ms) {
                if (m.section !== curTitle || !sec) {
                    flushRun();
                    sec = el("section", { class: "cv-section" });
                    out.push(sec);
                    curTitle = m.section;
                }
                const target = sec as HTMLElement;
                if (m.heading) {
                    target.append(m.node);
                    continue;
                }
                if (m.kind === "single") {
                    flushRun();
                    target.append(m.node);
                    continue;
                }
                if (run.length && run[0].kind !== m.kind) flushRun();
                run.push(m);
            }
            flushRun();
            return out;
        }

        function renderSheet() {
            sheet.style.setProperty("--cv-accent", data.accent);
            sheet.classList.toggle("ats", data.template === "ats");
            let headNode: HTMLElement | null = null;
            const secs: Array<Sec> = [];

            const contact = [
                data.email,
                data.phone,
                data.location,
                data.website,
                data.github,
                data.linkedin,
            ].filter(Boolean);

            const hasIdentity = Boolean(
                data.name || data.title || data.summary,
            );
            const showPhoto = Boolean(data.photo) && data.template !== "ats";

            if (hasIdentity) {
                const head = el("header", {
                    class: showPhoto
                        ? "cv-sheet-head has-photo"
                        : "cv-sheet-head",
                });
                const headText = el("div", { class: "cv-head-text" });
                headText.append(el("div", { class: "cv-headbar" }));
                if (showPhoto)
                    head.append(
                        el("img", {
                            class: "cv-photo",
                            src: data.photo,
                            alt: "",
                        }),
                    );
                if (data.name)
                    headText.append(el("h1", { class: "cv-name" }, data.name));
                if (data.title)
                    headText.append(
                        el("p", { class: "cv-roletitle" }, data.title),
                    );
                if (contact.length) {
                    const line = el("p", { class: "cv-contact" });
                    contact.forEach((c, i) => {
                        if (i > 0)
                            line.append(
                                el(
                                    "span",
                                    { class: "sep", "aria-hidden": true },
                                    "•",
                                ),
                            );
                        line.append(document.createTextNode(String(c)));
                    });
                    headText.append(line);
                }
                head.append(headText);
                headNode = head;
            }

            if (data.summary.trim())
                secs.push({
                    col: "main",
                    title: "Profile",
                    kind: "single",
                    nodes: [el("p", { class: "cv-para" }, data.summary.trim())],
                });

            const expItems = data.experience.filter(
                (e) =>
                    e.role ||
                    e.company ||
                    e.location ||
                    e.start ||
                    e.end ||
                    bullets(e.description).length,
            );
            if (expItems.length) {
                const list: Node[] = [];
                for (const e of expItems) {
                    const item = el("div", { class: "cv-entry" });
                    const headLine = el("div", { class: "cv-entry-head" });
                    headLine.append(
                        el(
                            "span",
                            { class: "cv-entry-main" },
                            e.role &&
                                el(
                                    "strong",
                                    { class: "cv-entry-role" },
                                    e.role,
                                ),
                            e.company &&
                                el(
                                    "span",
                                    { class: "cv-entry-company" },
                                    (e.role ? " · " : "") + e.company,
                                ),
                            e.location &&
                                el(
                                    "span",
                                    { class: "cv-entry-loc" },
                                    " — " + e.location,
                                ),
                        ),
                        entryDate(e.start, e.end, e.current) &&
                            el(
                                "span",
                                { class: "cv-entry-date" },
                                entryDate(e.start, e.end, e.current),
                            ),
                    );
                    item.append(headLine);
                    const lines = bullets(e.description);
                    if (lines.length) {
                        const ul = el("ul", { class: "cv-bullets" });
                        for (const l of lines) ul.append(el("li", null, l));
                        item.append(ul);
                    }
                    list.push(item);
                }
                secs.push({
                    col: "main",
                    title: "Experience",
                    kind: "entry",
                    nodes: list,
                });
            }

            const projItems = data.projects.filter(
                (p) => p.name || p.link || p.description,
            );
            if (projItems.length) {
                const list: Node[] = [];
                for (const p of projItems) {
                    const item = el("div", { class: "cv-entry" });
                    item.append(
                        el(
                            "span",
                            { class: "cv-entry-main" },
                            p.name &&
                                el(
                                    "strong",
                                    { class: "cv-entry-role" },
                                    p.name,
                                ),
                            p.link &&
                                el(
                                    "span",
                                    { class: "cv-entry-company" },
                                    (p.name ? " · " : "") + p.link,
                                ),
                        ),
                    );
                    if (p.description.trim()) {
                        const pLines = bullets(p.description);
                        if (pLines.length > 1) {
                            const ul = el("ul", { class: "cv-bullets" });
                            for (const l of pLines)
                                ul.append(el("li", null, l));
                            item.append(ul);
                        } else {
                            item.append(
                                el(
                                    "p",
                                    { class: "cv-entry-desc" },
                                    p.description.trim(),
                                ),
                            );
                        }
                    }
                    list.push(item);
                }
                secs.push({
                    col: "main",
                    title: "Projects",
                    kind: "entry",
                    nodes: list,
                });
            }

            const eduItems = data.education.filter(
                (e) => e.degree || e.school || e.start || e.end,
            );
            if (eduItems.length) {
                const list: Node[] = [];
                for (const e of eduItems) {
                    list.push(
                        el(
                            "div",
                            { class: "cv-entry" },
                            el(
                                "div",
                                { class: "cv-entry-head" },
                                el(
                                    "span",
                                    { class: "cv-entry-main" },
                                    e.degree &&
                                        el(
                                            "strong",
                                            { class: "cv-entry-role" },
                                            e.degree,
                                        ),
                                    e.school &&
                                        el(
                                            "span",
                                            { class: "cv-entry-company" },
                                            (e.degree ? " · " : "") + e.school,
                                        ),
                                ),
                                entryDate(e.start, e.end) &&
                                    el(
                                        "span",
                                        { class: "cv-entry-date" },
                                        entryDate(e.start, e.end),
                                    ),
                            ),
                        ),
                    );
                }
                secs.push({
                    col: "side",
                    title: "Education",
                    kind: "entry",
                    nodes: list,
                });
            }

            if (data.skills.length) {
                const chips = el("div", { class: "cv-chips" });
                for (const s of data.skills)
                    chips.append(el("span", { class: "cv-chip" }, s));
                secs.push({
                    col: "side",
                    title: "Skills",
                    kind: "single",
                    nodes: [chips],
                });
            }

            const langItems = data.languages.filter((l) => l.name || l.level);
            if (langItems.length) {
                const pairs: Node[] = [];
                for (const l of langItems)
                    pairs.push(
                        el(
                            "div",
                            { class: "cv-pair" },
                            el(
                                "span",
                                { class: "cv-pair-name" },
                                l.name || "—",
                            ),
                            l.level
                                ? el("span", { class: "cv-pair-meta" }, l.level)
                                : null,
                        ),
                    );
                secs.push({
                    col: "side",
                    title: "Languages",
                    kind: "pair",
                    nodes: pairs,
                });
            }

            const certItems = data.certifications.filter(
                (c) => c.name || c.issuer || c.year,
            );
            if (certItems.length) {
                const pairs: Node[] = [];
                for (const c of certItems)
                    pairs.push(
                        el(
                            "div",
                            { class: "cv-pair" },
                            el(
                                "span",
                                { class: "cv-pair-name" },
                                c.name || "—",
                            ),
                            [c.issuer, c.year].filter(Boolean).length
                                ? el(
                                      "span",
                                      { class: "cv-pair-meta" },
                                      [c.issuer, c.year]
                                          .filter(Boolean)
                                          .join(" · "),
                                  )
                                : null,
                        ),
                    );
                secs.push({
                    col: "side",
                    title: "Certifications",
                    kind: "pair",
                    nodes: pairs,
                });
            }

            // ── Flows ──
            if (data.template === "ats") {
                // Canonical order ATS parsers expect.
                const order: Record<string, number> = {
                    Profile: 0,
                    Experience: 1,
                    Projects: 2,
                    Education: 3,
                    Skills: 4,
                    Languages: 5,
                    Certifications: 6,
                };
                secs.sort(
                    (a, b) => (order[a.title] ?? 9) - (order[b.title] ?? 9),
                );
            }
            const mainSecs = secs.filter((s) => s.col === "main");
            const sideSecs = secs.filter((s) => s.col === "side");
            const modern = data.template === "modern" && sideSecs.length > 0;

            if (!headNode && secs.length === 0) {
                const page = el("div", { class: "cv-a4" });
                page.append(el("span", { class: "cv-a4-num" }, "1"));
                page.append(
                    el(
                        "div",
                        { class: "cv-sheet-empty" },
                        el("strong", null, "Your CV preview"),
                        el(
                            "p",
                            null,
                            "Start filling the form on the left — or press “Load my data” to pre-fill your profile.",
                        ),
                    ),
                );
                sheet.replaceChildren(page);
                fitSheet();
                return;
            }

            const mkUnits = (s: Sec): Unit[] => [
                {
                    node: el("h3", null, s.title),
                    section: s.title,
                    heading: true,
                    kind: "heading",
                },
                ...s.nodes.map((n): Unit => ({
                    node: n,
                    section: s.title,
                    heading: false,
                    kind: s.kind,
                })),
            ];
            const mainUnits = mainSecs.flatMap(mkUnits);
            const sideUnits = sideSecs.flatMap(mkUnits);
            // Single-column templates flow every section in canonical order.
            const singleUnits = modern ? mainUnits : secs.flatMap(mkUnits);

            // ── Measure units at their final width (exact final structure) ──
            const measureBox = el("div", { class: "cv-measure" });
            if (headNode) measureBox.append(headNode);
            const attach = (box: Element, ss: Sec[], units: Unit[]) => {
                let i = 0;
                for (const s of ss) {
                    const sec = el("section", { class: "cv-section" });
                    sec.append(units[i].node); // heading
                    if (s.kind === "pair") {
                        const grid = el("div", { class: "cv-pairgrid" });
                        for (const n of s.nodes) grid.append(n);
                        sec.append(grid);
                    } else {
                        for (const n of s.nodes) sec.append(n);
                    }
                    box.append(sec);
                    i += 1 + s.nodes.length;
                }
            };
            if (modern) {
                const cols = el("div", { class: "cv-cols" });
                const mainC = el("div", { class: "cv-col-main" });
                const sideC = el("div", { class: "cv-col-side" });
                attach(mainC, mainSecs, mainUnits);
                attach(sideC, sideSecs, sideUnits);
                cols.append(mainC, sideC);
                measureBox.append(cols);
            } else {
                attach(measureBox, secs, singleUnits);
            }
            sheet.append(measureBox);

            const toMeasured = (units: Unit[]): Measured[] =>
                units.map((u) => {
                    const node = u.node as HTMLElement;
                    const cs = getComputedStyle(node);
                    return {
                        ...u,
                        h: node.offsetHeight,
                        t: u.heading
                            ? parseFloat(
                                  getComputedStyle(node.parentElement ?? node)
                                      .marginTop,
                              ) || 0
                            : parseFloat(cs.marginTop) || 0,
                        b: parseFloat(cs.marginBottom) || 0,
                    };
                });

            const mainMs = toMeasured(singleUnits);
            const sideMs = modern ? toMeasured(sideUnits) : [];
            const headMs = headNode
                ? (() => {
                      const n = headNode as HTMLElement;
                      const cs = getComputedStyle(n);
                      return {
                          h: n.offsetHeight,
                          t: parseFloat(cs.marginTop) || 0,
                          b: parseFloat(cs.marginBottom) || 0,
                      };
                  })()
                : null;
            measureBox.remove();

            // ── Split into A4 pages and render one card per page ──
            const wantsBreak = (t: string) => data.breaks[t] === true;
            const firstOffset = headMs ? headMs.t + headMs.h + headMs.b : 0;
            const topMargin = headMs ? headMs.b : 0;
            const mainPages = pullSplitSection(
                rescueOrphan(
                    paginate(
                        mainMs,
                        PAGE_CAP,
                        firstOffset,
                        topMargin,
                        wantsBreak,
                    ),
                    PAGE_CAP,
                    wantsBreak,
                ),
            );
            const sidePages = pullSplitSection(
                rescueOrphan(
                    paginate(
                        sideMs,
                        PAGE_CAP,
                        firstOffset,
                        topMargin,
                        wantsBreak,
                    ),
                    PAGE_CAP,
                    wantsBreak,
                ),
            );
            const total = Math.max(mainPages.length, sidePages.length, 1);

            const pageEls: HTMLElement[] = [];
            for (let k = 0; k < total; k++) {
                const page = el("div", { class: "cv-a4" });
                page.append(el("span", { class: "cv-a4-num" }, String(k + 1)));
                if (k === 0 && headNode) page.append(headNode);
                if (modern) {
                    const cols = el("div", { class: "cv-cols" });
                    const mainC = el("div", { class: "cv-col-main" });
                    mainC.append(...renderSectioned(mainPages[k] ?? []));
                    const sideC = el("div", { class: "cv-col-side" });
                    sideC.append(...renderSectioned(sidePages[k] ?? []));
                    cols.append(mainC, sideC);
                    page.append(cols);
                } else {
                    page.append(...renderSectioned(mainPages[k] ?? []));
                }
                pageEls.push(page);
            }
            sheet.replaceChildren(...pageEls);
            fitSheet();
        }

        // Scale the A4 pages to fit the preview pane and update the badge.
        function fitSheet() {
            const avail = previewPane.clientWidth;
            if (!avail) return;
            const scale = Math.min(1, avail / SHEET_W);
            sheet.style.transform = `scale(${scale})`;
            sheetWrap.style.width = `${SHEET_W * scale}px`;
            sheetWrap.style.height = `${sheet.offsetHeight * scale}px`;
            const pages = sheet.querySelectorAll(".cv-a4").length || 1;
            const badge = document.getElementById("pageBadge");
            if (badge)
                badge.textContent = pages === 1 ? "1 page" : `${pages} pages`;
        }

        // ── Form: list entries ─────────────────────────────────────────
        function fieldRow(
            labelA: string,
            inputA: Node,
            labelB?: string,
            inputB?: Node,
        ): Node {
            const row = el("div", { class: "cv-grid2" });
            row.append(
                el(
                    "div",
                    { class: "cv-field" },
                    el("label", null, labelA),
                    inputA,
                ),
            );
            if (labelB && inputB)
                row.append(
                    el(
                        "div",
                        { class: "cv-field" },
                        el("label", null, labelB),
                        inputB,
                    ),
                );
            return row;
        }

        function entryShell(
            list: string,
            index: number,
            ...inner: Node[]
        ): HTMLElement {
            return el(
                "div",
                {
                    class: "entry",
                    "data-list": list,
                    "data-index": String(index),
                },
                el(
                    "div",
                    { class: "entry-head" },
                    el("span", { class: "entry-num" }, String(index + 1)),
                    el(
                        "button",
                        {
                            type: "button",
                            class: "entry-remove",
                            "data-remove": list,
                            "data-index": String(index),
                        },
                        "Remove",
                    ),
                ),
                ...inner,
            );
        }

        function textInput(
            list: string,
            index: number,
            field: string,
            placeholder: string,
            type = "text",
        ): HTMLInputElement {
            const input = document.createElement("input");
            input.type = type;
            input.placeholder = placeholder;
            input.dataset.list = list;
            input.dataset.index = String(index);
            input.dataset.field = field;
            input.setAttribute("aria-label", `${list} ${index + 1} — ${field}`);
            if (field === "link" || field === "github" || field === "website") {
                input.spellcheck = false;
                input.setAttribute("autocapitalize", "off");
                input.setAttribute("autocorrect", "off");
            }
            return input;
        }

        function textareaInput(
            list: string,
            index: number,
            field: string,
            placeholder: string,
            rows = 4,
        ): HTMLTextAreaElement {
            const ta = document.createElement("textarea");
            ta.rows = rows;
            ta.placeholder = placeholder;
            ta.dataset.list = list;
            ta.dataset.index = String(index);
            ta.dataset.field = field;
            return ta;
        }

        function checkboxInput(
            list: string,
            index: number,
            field: string,
            checked: boolean,
            label: string,
        ): HTMLLabelElement {
            const input = document.createElement("input");
            input.type = "checkbox";
            input.checked = checked;
            input.dataset.list = list;
            input.dataset.index = String(index);
            input.dataset.field = field;
            return el("label", { class: "cv-check" }, input, label);
        }

