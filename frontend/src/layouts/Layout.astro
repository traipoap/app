---
import "../styles/base.css";
import AppNav from "../components/AppNav.astro";

interface Props {
    title?: string;
    description?: string;
    bodyClass?: string;
}

const {
    title = "LUMINA — K3s GitOps Log Platform",
    description = "Unified log platform for K3s GitOps clusters — search, filter and export syslogs, OpenTelemetry logs and traces.",
    bodyClass,
} = Astro.props;

// แสดง nav rail เฉพาะหน้าแอป (Query + Dashboard + Admin)
const showNav =
    Astro.url.pathname.startsWith("/dashboard") ||
    Astro.url.pathname.startsWith("/query");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class={bodyClass}>
        <div class="app-shell">
            {showNav && <AppNav />}
            <main class="app-main">
                <slot />
            </main>
        </div>
    </body>
</html>
