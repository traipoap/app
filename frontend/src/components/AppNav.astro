---
// Global app navigation — vertical rail on the left (desktop),
// top bar + slide-in drawer on mobile.
const path = Astro.url.pathname;

const links = [
    //{
    //href: "/",
    //label: "Home",
    //icon: "M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z M9 22V12h6v10",
    //},
    {
        href: "/query",
        label: "Query",
        icon: "M21 21l-4.35-4.35 M19 11a8 8 0 11-16 0 8 8 0 0116 0z",
    },
    {
        href: "/dashboard",
        label: "Dashboard",
        icon: "M18 20V10 M12 20V4 M6 20v-6",
    },
    {
        href: "/setting",
        label: "Setting",
        icon: "M12 15a3 3 0 100-6 3 3 0 000 6z M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33h0a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51h0a1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82v0a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z",
    },
];

const isActive = (href: string) =>
    href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<div class="app-nav">
    <!-- Mobile top bar -->
    <div class="nav-topbar">
        <span class="topbar-brand">
            <span class="brand-mark">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                </svg>
            </span>
            <span class="brand-word">LUMINA</span>
        </span>
        <button
            class="nav-burger"
            type="button"
            aria-label="Open navigation"
            aria-expanded="false"
            aria-controls="navPanel"
        >
            <span class="nav-burger-box">
                <span class="burger-bar"></span>
                <span class="burger-bar"></span>
                <span class="burger-bar"></span>
            </span>
        </button>
    </div>

    <!-- Navigation rail (desktop) / drawer (mobile) -->
    <aside class="nav-panel" id="navPanel">
        <a href="/" class="nav-brand" aria-label="LUMINA — home">
            <span class="brand-mark">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                </svg>
            </span>
            <span class="nav-brand-text">
                <span class="brand-word">LUMINA</span>
                <span class="brand-sub">Kubernetes GitOps Logs</span>
            </span>
        </a>

        <nav class="nav-menu" aria-label="Main navigation">
            {links.map((link) => (
                <a
                    href={link.href}
                    title={link.label}
                    class:list={["nav-link", { active: isActive(link.href) }]}
                    aria-current={isActive(link.href) ? "page" : undefined}
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d={link.icon}></path>
                    </svg>
                    <span class="nav-link-label">{link.label}</span>
                </a>
            ))}
        </nav>

        <div class="nav-footer">
            <button
                class="nav-collapse"
                type="button"
                aria-expanded="true"
                aria-controls="navPanel"
                title="Collapse / Expand"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M15 18l-6-6 6-6"></path>
                </svg>
                <span class="nav-collapse-label">Collapse</span>
            </button>
            <button
                class="nav-signout"
                type="button"
                title="Sign out"
                onclick="localStorage.removeItem('authToken');sessionStorage.removeItem('authToken');window.location.href='/signin'"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
                    <path d="M16 17l5-5-5-5"></path>
                    <path d="M21 12H9"></path>
                </svg>
                <span class="nav-signout-label">Sign out</span>
            </button>
        </div>
    </aside>

    <div class="nav-overlay"></div>
</div>

<script>
    const nav = document.querySelector<HTMLElement>(".app-nav");
    const burger = nav?.querySelector<HTMLElement>(".nav-burger");
    const overlay = nav?.querySelector<HTMLElement>(".nav-overlay");

    const closeNav = () => {
        nav?.classList.remove("open");
        burger?.setAttribute("aria-expanded", "false");
    };

    burger?.addEventListener("click", () => {
        const open = nav?.classList.toggle("open");
        burger?.setAttribute("aria-expanded", open ? "true" : "false");
    });
    overlay?.addEventListener("click", closeNav);
    nav?.querySelectorAll(".nav-link").forEach((a) => {
        a.addEventListener("click", closeNav);
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeNav();
    });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
        if (e.matches) closeNav();
    });

    // ── Collapse / expand the rail (desktop only) — persist choice ──
    const collapseBtn = nav?.querySelector<HTMLElement>(".nav-collapse");
    const NAV_KEY = "lumina.navCollapsed";
    const isCollapsed = () => nav?.classList.contains("collapsed") ?? false;
    const setCollapsed = (v: boolean) => {
        nav?.classList.toggle("collapsed", v);
        collapseBtn?.setAttribute("aria-expanded", String(!v));
        const label = collapseBtn?.querySelector(".nav-collapse-label");
        if (label) label.textContent = v ? "Expand" : "Collapse";
        collapseBtn?.setAttribute("title", v ? "Expand" : "Collapse");
        try {
            localStorage.setItem(NAV_KEY, v ? "1" : "0");
        } catch {
            /* private mode — ignore */
        }
    };
    try {
        if (localStorage.getItem(NAV_KEY) === "1" && nav)
            nav.classList.add("collapsed");
    } catch {
        /* ignore */
    }
    collapseBtn?.setAttribute("aria-expanded", String(!isCollapsed()));
    collapseBtn?.addEventListener("click", () => setCollapsed(!isCollapsed()));
</script>

<style>
    .app-nav {
        display: flex;
    }

    /* ── Mobile top bar (hidden on desktop) ── */
    .nav-topbar {
        display: none;
    }

    /* ── Navigation rail (desktop) ── */
    .nav-panel {
        position: sticky;
        top: 0;
        align-self: flex-start;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        width: 240px;
        height: 100vh;
        flex-shrink: 0;
        padding: 1.125rem 0.875rem;
        background: var(--bg-elev);
        border-right: 1px solid var(--border);
    }

    .nav-brand {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.125rem 0.375rem;
        text-decoration: none;
        color: var(--text);
        min-width: 0;
    }

    .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        color: #fff;
        background: linear-gradient(
            135deg,
            var(--accent-strong),
            #4f46e5 55%,
            var(--accent-2)
        );
        box-shadow: 0 4px 14px -4px rgba(99, 102, 241, 0.55);
    }

    .brand-mark svg {
        width: 17px;
        height: 17px;
    }

    .nav-brand-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .brand-word {
        font-size: 0.9375rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        white-space: nowrap;
    }

    .brand-sub {
        margin-top: 0.125rem;
        font-size: 0.6875rem;
        font-weight: 500;
        color: var(--faint);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Vertical menu ── */
    .nav-menu {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.5625rem 0.75rem;
        border-radius: 8px;
        border: 1px solid transparent;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.8125rem;
        font-weight: 500;
        white-space: nowrap;
        transition:
            color 0.15s ease,
            background 0.15s ease,
            border-color 0.15s ease;
    }

    .nav-link svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .nav-link:hover {
        color: var(--text);
        background: rgba(148, 163, 184, 0.07);
    }

    .nav-link.active {
        color: #c7d2fe;
        background: rgba(129, 140, 248, 0.12);
        border-color: rgba(129, 140, 248, 0.28);
    }

    .nav-link.active:hover {
        color: #c7d2fe;
        background: rgba(129, 140, 248, 0.16);
    }

    /* ── Footer ── */
    .nav-footer {
        margin-top: auto;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    /* ── Collapse / expand (desktop) ── */
    .nav-panel {
        transition:
            width 0.2s ease,
            padding 0.2s ease;
    }

    .nav-collapse {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        width: 100%;
        padding: 0.5625rem 0.75rem;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--muted);
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        transition:
            color 0.15s ease,
            background 0.15s ease,
            border-color 0.15s ease;
    }

    .nav-collapse svg {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

    .nav-collapse:hover {
        color: var(--text);
        background: rgba(148, 163, 184, 0.07);
    }

    /* Collapsed: icon-only rail */
    .app-nav.collapsed .nav-panel {
        width: 68px;
        padding: 1.125rem 0.5rem;
    }
    .app-nav.collapsed .nav-brand {
        justify-content: center;
        padding: 0.125rem 0.25rem;
    }
    .app-nav.collapsed .nav-brand-text {
        display: none;
    }
    .app-nav.collapsed .nav-link {
        justify-content: center;
        padding: 0.5625rem 0.5rem;
    }
    .app-nav.collapsed .nav-link-label,
    .app-nav.collapsed .nav-collapse-label,
    .app-nav.collapsed .nav-signout-label {
        display: none;
    }
    .app-nav.collapsed .nav-collapse {
        justify-content: center;
        padding: 0.5625rem 0.5rem;
    }
    .app-nav.collapsed .nav-collapse svg {
        transform: rotate(180deg);
    }
    .app-nav.collapsed .nav-signout {
        justify-content: center;
        padding: 0.5625rem 0.5rem;
    }

    .nav-signout {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        width: 100%;
        padding: 0.5625rem 0.75rem;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--muted);
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        transition:
            color 0.15s ease,
            background 0.15s ease,
            border-color 0.15s ease;
    }

    .nav-signout svg {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
    }

    .nav-signout:hover {
        color: var(--danger);
        background: rgba(248, 113, 113, 0.08);
        border-color: rgba(248, 113, 113, 0.25);
    }

    /* ── Overlay (mobile) ── */
    .nav-overlay {
        display: none;
    }

    .nav-burger {
        display: none;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: rgba(148, 163, 184, 0.05);
        border: 1px solid var(--border);
        border-radius: 8px;
        cursor: pointer;
    }

    .nav-burger-box {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 16px;
    }

    .burger-bar {
        display: block;
        width: 100%;
        height: 2px;
        border-radius: 2px;
        background: var(--muted);
        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    /* ── Mobile: top bar + drawer ── */
    @media (max-width: 1023px) {
        .nav-collapse {
            display: none;
        }

        .nav-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 56px;
            padding: 0 1rem;
            background: rgba(7, 11, 20, 0.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 250;
        }

        .topbar-brand {
            display: inline-flex;
            align-items: center;
            gap: 0.625rem;
            color: var(--text);
            text-decoration: none;
        }

        .nav-burger {
            display: inline-flex;
        }

        .app-nav.open .nav-burger-box .burger-bar:nth-child(1) {
            transform: translateY(6px) rotate(45deg);
        }
        .app-nav.open .nav-burger-box .burger-bar:nth-child(2) {
            opacity: 0;
        }
        .app-nav.open .nav-burger-box .burger-bar:nth-child(3) {
            transform: translateY(-6px) rotate(-45deg);
        }

        .nav-panel {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            z-index: 300;
            width: 280px;
            height: 100%;
            transform: translateX(-105%);
            transition: transform 0.22s ease;
            box-shadow: 0 0 40px rgba(0, 0, 0, 0.5);
            overflow-y: auto;
        }

        .app-nav.open .nav-panel {
            transform: none;
        }

        .nav-overlay {
            display: block;
            position: fixed;
            inset: 0;
            z-index: 290;
            background: rgba(3, 6, 12, 0.6);
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            opacity: 0;
            visibility: hidden;
            transition:
                opacity 0.2s ease,
                visibility 0.2s;
        }

        .app-nav.open .nav-overlay {
            opacity: 1;
            visibility: visible;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-panel,
        .nav-overlay,
        .nav-link,
        .nav-signout,
        .nav-collapse,
        .nav-collapse svg,
        .burger-bar {
            transition: none;
        }
    }
</style>
